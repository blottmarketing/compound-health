---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** When true, emit a robots noindex,nofollow tag. Defaults to true while
   *  the blog system is pre-launch. */
  noindex?: boolean;
  /** Override the OG type. Defaults to "website"; post pages pass "article". */
  ogType?: 'website' | 'article';
  /** Published date in ISO form, used for article:published_time. */
  publishedTime?: string;
}

const SITE_NAME = 'Compound Health';
const DEFAULT_DESCRIPTION =
  'Notes from the Compound Health clinical and research team on preventive medicine, biomarker science and how leading wealth advisors are integrating healthspan into the annual client review.';
const DEFAULT_OG = '/og-image.png';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = DEFAULT_OG,
  noindex = true,
  ogType = 'website',
  publishedTime,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL('https://compoundhealth.io');
const canonical  = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImage    = new URL(image, siteOrigin).toString();
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2D5016" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>

    <nav class="site-nav">
      <a href="/" class="nav-logo">Compound <em>Health</em></a>
      <div class="blog-nav-links">
        <a href="/blog">Blog</a>
        <a href="/" class="nav-back">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M11 7H3M6 3L2 7l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to home
        </a>
      </div>
    </nav>

    <slot />

    <footer>
      <div class="footer-logo">Compound Health</div>
      <nav class="footer-nav">
        <a href="/blog">Blog</a>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/website-terms">Website Terms</a>
      </nav>
      <div class="footer-copy">&copy; 2026 Compound Health. All rights reserved.</div>
    </footer>

  </body>
</html>
