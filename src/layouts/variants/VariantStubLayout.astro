---
/**
 * Placeholder for a variation that has not been designed yet.
 *
 * Deliberately styleless beyond what is in this file: it loads no variation stylesheet, so a
 * planned route resolves and the switcher works without implying a design that does not
 * exist. When work on a variation starts, replace its page with a real layout
 * (src/layouts/variants/<V>Layout.astro) and its own stylesheet under src/styles/variants/.
 */
import VariantSwitcher from '../../components/variants/VariantSwitcher.astro';
import { getVariant, VARIANTS } from '../../data/variants';

interface Props {
  /** Variant id from src/data/variants.ts. */
  variant: string;
}
const { variant } = Astro.props;
const current = getVariant(variant);
const ready = VARIANTS.filter(v => v.status === 'ready');
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`Compound Health | Design ${current.label}, not started`}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon-v1.svg" />
    <style>
      :root { color-scheme: light; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 40px 24px 120px;
        background: #FBFAF7;
        color: #161816;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .stub { max-width: 520px; text-align: center; }
      .stub-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 999px;
        background: rgba(22, 24, 22, 0.06);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: rgba(22, 24, 22, 0.5);
        margin-bottom: 22px;
      }
      .stub h1 {
        margin: 0 0 14px;
        font-size: 34px;
        font-weight: 700;
        letter-spacing: -0.9px;
        line-height: 1.12;
      }
      .stub p {
        margin: 0 0 10px;
        font-size: 15px;
        line-height: 1.62;
        color: rgba(22, 24, 22, 0.62);
      }
      .stub-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
        margin-top: 26px;
      }
      .stub-links a {
        padding: 9px 16px;
        border-radius: 999px;
        background: #161816;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
      }
      .stub-links a.is-quiet {
        background: transparent;
        color: rgba(22, 24, 22, 0.62);
        box-shadow: inset 0 0 0 1px rgba(22, 24, 22, 0.14);
      }
    </style>
  </head>
  <body>
    <main class="stub">
      <span class="stub-badge">Design {current.label}</span>
      <h1>Not started yet</h1>
      <p>{current.note}</p>
      <p>This route exists so the variation switcher works. Nothing has been designed here.</p>
      <div class="stub-links">
        {ready.map(v => <a href={v.path}>View {v.label}</a>)}
        <a href="/" class="is-quiet">View the live design</a>
      </div>
    </main>

    <VariantSwitcher current={variant} />
  </body>
</html>
