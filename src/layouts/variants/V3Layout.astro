---
/**
 * Layout for design variation v3, the lassie.ai idiom.
 *
 * Loads src/styles/variants/v3.css and nothing else from the design side. Every in-page
 * link is prefixed with `base` so navigation stays inside the variation, and the page is
 * noindex, always.
 *
 * The chrome here is the reference's own: a floating glass pill instead of a bar, with a
 * white indicator that chases the pointer and a wordmark that collapses to the mark once
 * the reader is 400px down; and a footer that stands on a fixed gradient panel carrying
 * the wordmark at almost the full width of the page, uncovered by scrolling rather than
 * by script.
 *
 * The live layout at src/layouts/MainLayout.astro is production and is not to be touched.
 */
import '../../styles/variants/v3.css';
import Logo from '../../components/variants/Logo.astro';
import BrandLockup from '../../components/variants/BrandLockup.astro';
import VariantSwitcher from '../../components/variants/VariantSwitcher.astro';

interface Props {
  title: string;
  description?: string;
  /** Home route of this variation, prefixed onto every in-page link. */
  base?: string;
  /** Variant id, so the switcher can mark the current page. */
  variant?: string;
}

const SITE_NAME = 'Compound Health';
const DEFAULT_DESCRIPTION =
  'A private longevity membership introduced by your wealth advisor. Your health data stays yours, and you decide what, if anything, to share. Founding member waitlist now open.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  base = '/v3',
  variant = 'v3',
} = Astro.props;

const anchor = (hash: string) => `${base}#${hash}`;
const year = new Date().getFullYear();

const NAV_LINKS = [
  { label: 'How it works', hash: 'how' },
  { label: 'What you get', hash: 'features' },
  { label: 'Partners', hash: 'partners' },
  { label: 'Membership', hash: 'membership' },
];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Variations are internal review pages and never indexed. -->
    <meta name="robots" content="noindex, nofollow" />

    <link rel="icon" type="image/svg+xml" href="/favicon-v1.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f9f8f5" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!--
      Two faces only. Newsreader stands in for ABC Marist, the reference's display
      serif: a variable weight axis so the display can sit on 350 exactly rather than
      rounding up to 400, a low x-height against a generous cap, and a true italic. It
      sets every heading. DM Sans sets everything else, the labels, figures, colophon
      and wordmark included. No mono and no Lato on this variation (client's call,
      2026-09-11).
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300..700&family=Newsreader:ital,opsz,wght@0,6..72,300..500;1,6..72,300..500&display=swap"
      rel="stylesheet"
    />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" is:inline></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" is:inline></script>
    <script src="https://cdn.jsdelivr.net/npm/lenis@1.3.26/dist/lenis.min.js" is:inline></script>
  </head>
  <body>

    <nav class="nav" id="nav" aria-label="Main navigation">
      <div class="nav-shell" aria-hidden="true"></div>
      <div class="nav-pill" id="navPill" aria-hidden="true"></div>

      <Logo base={base} art="brand" parts="mark" />

      <div class="nav-links">
        {NAV_LINKS.map(l => <a class="nav-item" href={anchor(l.hash)} data-nav-link={l.hash}>{l.label}</a>)}
      </div>

      <a class="nav-item is-cta" href={anchor('joinwaitlist')}>Get access</a>

      <!-- Below 1024 the bar is the lockup and this, nothing else. Three bars
           that become a cross; no label, because the shape is the label. -->
      <button class="nav-burger" id="navMenuBtn" aria-expanded="false" aria-controls="navDrop" aria-label="Menu">
        <span class="nav-burger-bars" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
    </nav>

    <!-- Open, the menu takes the whole screen. The bar stays above it so the
         cross is where the burger was. -->
    <div class="nav-drop" id="navDrop" aria-hidden="true">
      <nav class="nav-drop-inner" aria-label="Menu">
        {NAV_LINKS.map(l => (
          <a class="nav-drop-link" href={anchor(l.hash)} data-menu-link>{l.label}</a>
        ))}
        <a class="nav-drop-link" href="/for-advisors" data-menu-link>For advisors and firms</a>
        <a class="btn btn-secondary nav-drop-cta" href={anchor('joinwaitlist')} data-menu-link>
          <span class="btn-label">Get access</span>
          <span class="btn-icon">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
      </nav>
    </div>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-top">
          <div class="footer-lead">
            <p class="t-h2 footer-statement">Beyond wealth:<br />the years to <em>enjoy it</em></p>
            <a class="btn btn-secondary" href={anchor('joinwaitlist')}>
              <span class="btn-label">Get access</span>
              <span class="btn-icon">
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </a>
          </div>

          <div class="footer-cols">
            <div class="footer-col">
              <div class="footer-col-title">Site</div>
              <a class="link t-body-sm" href={anchor('how')}>How it works</a>
              <a class="link t-body-sm" href={anchor('features')}>What you get</a>
              <a class="link t-body-sm" href={anchor('membership')}>Membership</a>
              <a class="link t-body-sm" href="/for-advisors">For advisors and firms</a>
              <a class="link t-body-sm" href={anchor('joinwaitlist')}>Get access</a>
            </div>
            <div class="footer-col">
              <div class="footer-col-title">Contact</div>
              <a class="link t-body-sm" href="mailto:hello@compoundhealth.io">hello@compoundhealth.io</a>
              <a class="link t-body-sm" href="mailto:privacy@compoundhealth.io">privacy@compoundhealth.io</a>
            </div>
            <div class="footer-col">
              <div class="footer-col-title">Legal</div>
              <a class="link t-body-sm" href="/privacy-policy">Privacy Policy</a>
              <a class="link t-body-sm" href="/website-terms">Website Terms</a>
            </div>
          </div>
        </div>

        <!-- The colophon sits at the foot of the link zone: one quiet line and
             nothing else. The mark that stood beside it came off on 2026-09-11,
             and the rights line and the tagline under it went the same day; from
             1024 up the line starts on the same left edge as the link columns
             above it, which is what the grid below is for. The flex column and
             its gap stay: they cost nothing with one child, and the wrapper is
             what the grid places. -->
        <div class="footer-bottom">
          <div class="footer-colophon">
            <div class="t-label">&copy; {year} Compound Health</div>
          </div>
        </div>
      </div>
    </footer>

    <!-- The panel the footer stands on. Uncovered by the footer's own bottom margin
         scrolling past it; no script anywhere near it. -->
    <div class="footer-panel" aria-hidden="true">
      <!-- The brand's own wordmark, drawn, not set: the bar carries the mark
           alone and the foot of the page carries the letters alone (client's
           call, 2026-09-11). It was the page's display serif with an italic
           Health until then. -->
      <div class="footer-wordmark"><BrandLockup part="word" /></div>
    </div>

    <VariantSwitcher current={variant} />

    <script>
      // ---------------------------------------------------------------------
      // Smooth scroll. Lenis at lerp 0.2, driven off the GSAP ticker with lag
      // smoothing off, which is the reference's own configuration. Exposed on
      // window so a headless capture can stop it and jump to a position.
      // ---------------------------------------------------------------------
      (function () {
        const g = (window as any).gsap;
        const word = nav.querySelector<HTMLElement>('.logo-word');
        // From 1024 the lockup is the wordmark alone, so there is no mark for
        // it to collapse onto and the collapse is a sub-1024 behaviour only.
        const wide = window.matchMedia('(min-width: 1024px)');
        // The same curve and durations the stylesheet uses, so the wordmark
        // moves on the same ease as everything else in the bar. power4.out is
        // cubic-bezier(.22,1,.36,1).
        const MOVE = 0.32, TINT = 0.18, EASE = 'power4.out';

        // --- the pill ---------------------------------------------------------
        const pill = document.getElementById('navPill');
        const items = Array.from(
          nav.querySelectorAll<HTMLElement>('.nav-item:not(.is-cta), .nav-logo')
        );
        const canHover = window.matchMedia('(hover: hover)').matches;
        let hovered: HTMLElement | null = null;
        let currentEl: HTMLElement | null = null;
        let pillRaf = 0;

        function paintPill() {
          pillRaf = 0;
          if (!pill) return;
          const el = hovered ?? currentEl;
          // Whatever the pill is under goes ink, on either ground: the pill is
          // white, so a label left white would be white on white over the hero.
          items.forEach(i => i.classList.toggle('is-lit', i === el));
          if (!el) { pill.classList.remove('is-on'); return; }

          const n = nav!.getBoundingClientRect();
          const r = el.getBoundingClientRect();
          // Arriving from nothing, it takes its place and its size in the same
          // frame and fades up. Growing from zero width at the far left swept
          // it across the bar before it had anything to say.
          const cold = !pill.classList.contains('is-on');
          if (cold) pill.classList.add('is-jump');
          pill.style.setProperty('--pill-x', Math.round(r.left - n.left) + 'px');
          pill.style.setProperty('--pill-y', Math.round(r.top - n.top) + 'px');
          pill.style.setProperty('--pill-w', Math.round(r.width) + 'px');
          pill.style.setProperty('--pill-h', Math.round(r.height) + 'px');
          if (cold) {
            void pill.offsetWidth;
            pill.classList.remove('is-jump');
            pill.classList.add('is-on');
          }
        }
        function schedulePill() {
          if (!pillRaf) pillRaf = requestAnimationFrame(paintPill);
        }

        if (canHover) {
          nav.addEventListener('pointerover', e => {
            const el = (e.target as HTMLElement | null)?.closest<HTMLElement>(
              '.nav-item:not(.is-cta), .nav-logo'
            );
            const next = el && nav!.contains(el) ? el : null;
            if (next !== hovered) { hovered = next; schedulePill(); }
          });
          nav.addEventListener('pointerleave', () => {
            if (hovered) { hovered = null; schedulePill(); }
          });
        }
        // The bar changes width under the pill for the whole of the wordmark's
        // collapse. This is the one thing the old indicator needed told by hand
        // on every frame of that tween.
        if ('ResizeObserver' in window) new ResizeObserver(schedulePill).observe(nav);
        window.addEventListener('resize', schedulePill, { passive: true });

        // --- the wordmark collapse ------------------------------------------
        let collapsed = false;
        let natural = 0;
        function measure() {
          if (!word) return;
          const had = collapsed;
          word.style.width = '';
          natural = word.scrollWidth;
          if (had) word.style.width = '0px';
        }
        measure();
        window.addEventListener('resize', () => { measure(); update(); }, { passive: true });

        function setCollapsed(next: boolean) {
          if (next === collapsed || !word) return;
          collapsed = next;
          if (!g) { word.style.width = next ? '0px' : ''; word.style.opacity = next ? '0' : ''; return; }
          // The wordmark goes rather than being sliced: the letters give up
          // their opacity in the first third of the move and the gap closes
          // over the whole of it. On the way back the width leads and the
          // letters arrive into the space that has already been made.
          g.killTweensOf(word);
          const tl = g.timeline({
            defaults: { ease: EASE },
            onComplete: () => {
              if (!next) { word.style.width = ''; word.style.opacity = ''; word.style.marginLeft = ''; }
            },
          });
          // The letters go first and the space closes right behind them. When
          // the width lagged the fade, the bar stood with an empty pocket
          // between the mark and the first link for half a second, and that
          // pocket is what read as broken rather than the collapse itself.
          if (next) {
            tl.to(word, { opacity: 0, duration: TINT - 0.04 }, 0)
              .to(word, { width: 0, marginLeft: 0, duration: MOVE }, 0);
          } else {
            tl.to(word, { width: natural, marginLeft: 9, duration: MOVE }, 0)
              .to(word, { opacity: 1, duration: TINT }, MOVE - TINT);
          }
        }

        // --- dark over any dark ground ----------------------------------------
        // Two of them: the hero photograph and the closing card. The bar
        // inverts for as long as it is over either one, which is the whole
        // reason those two frames are the only dark things on the page.
        const darkZones = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-dark]'));
        const navLinks = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
        const sections = navLinks
          .map(a => ({ hash: a.dataset.navLink!, el: document.getElementById(a.dataset.navLink!) }))
          .filter((s): s is { hash: string; el: HTMLElement } => !!s.el);
        let ticking = false;
        function update() {
          ticking = false;
          const y = window.scrollY;
          if (wide.matches) setCollapsed(false);
          else if (y >= 400) setCollapsed(true);
          else if (y <= 360) setCollapsed(false);

          const navBottom = nav!.getBoundingClientRect().bottom;
          // A few pixels of lookahead, so the handover is early rather than a
          // frame late at speed.
          const edge = navBottom + 12;
          const onDark = darkZones.some(z => {
            const r = z.getBoundingClientRect();
            return r.top < edge && r.bottom > edge;
          });
          nav!.classList.toggle('is-dark', onDark);

          // --- the link for the section being read ---------------------------
          // The bar's four links point at four sections. The one in front is
          // the last section whose top has passed under the bar; above the
          // first one nothing is marked, which is the truthful state on the
          // hero. It rides on the same rAF as everything else here, so it
          // costs one loop over four elements per frame of scrolling.
          if (sections.length) {
            let current: string | null = null;
            for (const sec of sections) {
              if (sec.el.getBoundingClientRect().top <= edge + 80) current = sec.hash;
            }
            let currentLink: HTMLElement | null = null;
            navLinks.forEach(a => {
              const on = a.dataset.navLink === current;
              a.classList.toggle('is-current', on);
              if (on) { a.setAttribute('aria-current', 'true'); currentLink = a; }
              else a.removeAttribute('aria-current');
            });
            if (currentLink !== currentEl) { currentEl = currentLink; schedulePill(); }
          }

          // Nothing here retires the bar any more. It was tried twice, once as
          // a fade-out where it stood and once as a park above the footer, and
          // both were the same answer to the same measurable problem: at the
          // end of the page the footer's first row passes under a fixed bar at
          // every width. The problem is now solved in the footer's own
          // geometry instead (see the stylesheet), so the bar is simply fixed
          // from the first pixel to the last, which is what the reference does
          // and what this rule always said.
        }
        window.addEventListener('scroll', () => {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
        update();

        // --- the pill menu ---------------------------------------------------
        const btn = document.getElementById('navMenuBtn');
        const drop = document.getElementById('navDrop');
        if (btn && drop) {
          const lenis = () => (window as any).__lenis;
          const setOpen = (open: boolean) => {
            drop.classList.toggle('is-open', open);
            nav!.classList.toggle('is-menu-open', open);
            drop.setAttribute('aria-hidden', String(!open));
            btn.setAttribute('aria-expanded', String(open));
            document.documentElement.classList.toggle('is-locked', open);
            // The menu covers the page, so the page underneath stops moving.
            if (open) lenis()?.stop(); else lenis()?.start();
          };
          const close = () => setOpen(false);
          btn.addEventListener('click', () => setOpen(!drop.classList.contains('is-open')));
          drop.querySelectorAll('[data-menu-link]').forEach(a => a.addEventListener('click', close));
          document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
          window.matchMedia('(min-width: 1024px)').addEventListener('change', e => { if (e.matches) close(); });
        }
      })();

      // ---------------------------------------------------------------------
      // Reveal. One observer, each element played once.
      // ---------------------------------------------------------------------
      (function () {
        const items = document.querySelectorAll<HTMLElement>('.reveal');
        if (!items.length) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          items.forEach(el => el.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            (entry.target as HTMLElement).classList.add('is-in');
            obs.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
        items.forEach(el => io.observe(el));
      })();
    </script>
  </body>
</html>
