---
/**
 * Layout for design variation v2, the joindawn.com idiom.
 *
 * Loads src/styles/variants/v2.css and nothing else from the design side. Every in-page
 * link is prefixed with `base` so navigation stays inside the variation, and the page is
 * noindex, always. The footer is written here rather than taken from the shared
 * components/variants/Footer.astro, because the v2 footer is Dawn's: a plain dark block,
 * no landscape art.
 *
 * The live layout at src/layouts/MainLayout.astro is production and is not to be touched.
 */
import '../../styles/variants/v2.css';
import Logo from '../../components/variants/Logo.astro';
import VariantSwitcher from '../../components/variants/VariantSwitcher.astro';

interface Props {
  title: string;
  description?: string;
  /** Home route of this variation, prefixed onto every in-page link. */
  base?: string;
  /** Variant id, so the switcher can mark the current page. */
  variant?: string;
}

const SITE_NAME = 'Compound Health';
const DEFAULT_DESCRIPTION =
  'A private longevity membership introduced by your wealth advisor. Your health data stays yours, and you decide what, if anything, to share. Founding member waitlist now open.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  base = '/v2',
  variant = 'v2',
} = Astro.props;

const anchor = (hash: string) => `${base}#${hash}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Variations are internal review pages and never indexed. -->
    <meta name="robots" content="noindex, nofollow" />

    <link rel="icon" type="image/svg+xml" href="/favicon-v1.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#12200F" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Dawn's pair: Source Serif 4 for display, Figtree for reading. Lato carries the wordmark. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;1,8..60,400&family=Lato:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" is:inline></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" is:inline></script>
  </head>
  <body>

    <nav class="main-nav" id="mainNav">
      <Logo base={base} />
      <div class="nav-links">
        <a href={anchor('how')}>How it works</a>
        <a href={anchor('features')}>What you get</a>
        <a href={anchor('partners')}>Partners</a>
        <a href={anchor('membership')}>Membership</a>
      </div>
      <div class="nav-actions">
        <a href={anchor('joinwaitlist')} class="nav-cta">Get access</a>
        <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>
    </nav>

    <!-- Mobile menu: Dawn's dark panel dropping from under the bar. -->
    <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
      <nav class="mobile-nav-links" aria-label="Menu">
        <a href={anchor('how')} class="mobile-nav-link" data-menu-link>How it <em>works</em></a>
        <a href={anchor('features')} class="mobile-nav-link" data-menu-link>What you <em>get</em></a>
        <a href={anchor('partners')} class="mobile-nav-link" data-menu-link>Partners</a>
        <a href={anchor('membership')} class="mobile-nav-link" data-menu-link>Membership</a>
      </nav>
      <a href={anchor('joinwaitlist')} class="btn btn-primary btn-full mobile-nav-cta" data-menu-link>Get access</a>
      <div class="mobile-menu-footer">Compound Health &copy; {year}</div>
    </div>

    <slot />

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-cols">
          <div class="footer-brand">
            <Logo variant="footer" base={base} />
            <p class="footer-tagline">
              A private longevity membership, introduced through the people who already advise you.
            </p>
          </div>
          <div class="footer-col">
            <div class="footer-col-title">Site</div>
            <a href={anchor('how')}>How it works</a>
            <a href={anchor('features')}>What you get</a>
            <a href={anchor('membership')}>Membership</a>
            <a href="/for-advisors">For advisors and firms</a>
            <a href={anchor('joinwaitlist')}>Get access</a>
          </div>
          <div class="footer-col">
            <div class="footer-col-title">Contact</div>
            <a href="mailto:hello@compoundhealth.io">hello@compoundhealth.io</a>
            <a href="mailto:privacy@compoundhealth.io">privacy@compoundhealth.io</a>
          </div>
        </div>
        <div class="footer-bottom">
          <div class="footer-copy">&copy; {year} Compound Health. All rights reserved.</div>
          <nav class="footer-legal" aria-label="Legal">
            <a href="/privacy-policy">Privacy Policy</a>
            <a href="/website-terms">Website Terms</a>
          </nav>
        </div>
      </div>
    </footer>

    <VariantSwitcher current={variant} />

    <script>
      // The bar. Transparent at the top; frosted once scrolled; hides on the way down
      // and returns on the way up, as Dawn's does. It also turns ink once the page has
      // reached the light ground, so the links stay legible over cream.
      (function () {
        const nav = document.getElementById('mainNav');
        if (!nav) return;
        const lightStart = document.querySelector<HTMLElement>('[data-nav-light]');
        let lastY = window.scrollY;
        let ticking = false;

        function update() {
          ticking = false;
          const y = window.scrollY;
          nav.classList.toggle('is-scrolled', y > 24);
          const goingDown = y > lastY + 4;
          const goingUp = y < lastY - 4;
          if (goingDown && y > 160) nav.classList.add('is-hidden');
          else if (goingUp) nav.classList.remove('is-hidden');
          lastY = y;

          if (lightStart) {
            const top = lightStart.getBoundingClientRect().top;
            nav.classList.toggle('is-on-light', top <= nav.offsetHeight);
          }
        }
        window.addEventListener('scroll', () => {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
        update();
      })();

      // Scroll reveal. One observer, each element played once.
      (function () {
        const items = document.querySelectorAll<HTMLElement>('.reveal');
        if (!items.length) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          items.forEach(el => el.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            (entry.target as HTMLElement).classList.add('is-in');
            obs.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
        items.forEach(el => io.observe(el));
      })();

      // Mobile menu.
      (function () {
        const hamburger = document.getElementById('hamburger') as HTMLButtonElement | null;
        const menu = document.getElementById('mobileMenu') as HTMLDivElement | null;
        const nav = document.getElementById('mainNav');
        if (!hamburger || !menu) return;
        let open = false;

        function openMenu() {
          open = true;
          menu!.classList.remove('is-closing');
          menu!.classList.add('is-open');
          menu!.setAttribute('aria-hidden', 'false');
          hamburger!.classList.add('is-open');
          hamburger!.setAttribute('aria-expanded', 'true');
          nav?.classList.remove('is-hidden');
        }
        function closeMenu() {
          if (!open) return;
          open = false;
          menu!.classList.remove('is-open');
          menu!.classList.add('is-closing');
          menu!.setAttribute('aria-hidden', 'true');
          hamburger!.classList.remove('is-open');
          hamburger!.setAttribute('aria-expanded', 'false');
          menu!.addEventListener('animationend', () => menu!.classList.remove('is-closing'), { once: true });
        }
        hamburger.addEventListener('click', () => (open ? closeMenu() : openMenu()));
        document.querySelectorAll('[data-menu-link]').forEach(a => a.addEventListener('click', closeMenu));
        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });
        window.matchMedia('(min-width: 992px)').addEventListener('change', e => { if (e.matches) closeMenu(); });
      })();
    </script>
  </body>
</html>
