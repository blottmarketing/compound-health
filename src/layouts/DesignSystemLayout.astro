---
import '../styles/global.css';
import '../styles/design-system.css';

interface SectionLink {
  id: string;
  label: string;
}

interface Props {
  title: string;
  description?: string;
  /** Section label rendered above the page title, e.g. "Atoms". */
  section?: string;
  /** Page intro rendered under the title. */
  lede?: string;
  /** Robots noindex,nofollow. Defaults to true. Every /design-system/* route
   *  is internal documentation and must stay out of indexes and the sitemap. */
  noindex?: boolean;
  /** Anchor list shown nested under the active page link in the left sidebar.
   *  Each entry needs a matching id on a section heading inside the slot. */
  sections?: SectionLink[];
}

const SITE_NAME = 'Compound Health';
const DEFAULT_DESCRIPTION =
  'Internal design system documentation for Compound Health. Atoms and molecules used across the marketing site.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  section,
  lede,
  noindex = true,
  sections = [],
} = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const a = href.replace(/\/+$/, '') || '/';
  return path === a;
};

const nav = [
  { label: 'Overview',  href: '/design-system' },
  { label: 'Atoms',     href: '/design-system/atoms' },
  { label: 'Molecules', href: '/design-system/molecules' },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2D5016" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>

    <nav class="ds-topnav">
      <a href="/" class="nav-logo">Compound <em>Health</em></a>
      <div class="ds-topnav-meta">
        <span class="ds-eyebrow">Design system · Internal</span>
        <a href="/" class="nav-back">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M11 7H3M6 3L2 7l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to site
        </a>
      </div>
    </nav>

    <div class="ds-shell">
      <aside class="ds-sidebar">
        <div class="ds-side-section">
          <p class="ds-side-label">Compound Health</p>
          <p class="ds-side-sub">v1.0 · Astro · Client-First</p>
        </div>

        <nav class="ds-side-nav" aria-label="Design system sections">
          <p class="ds-side-label">Pages</p>
          <ul>
            {nav.map((item) => {
              const active = isActive(item.href);
              const showSections = active && sections.length > 0;
              return (
                <li>
                  <a href={item.href} class={`ds-side-link${active ? ' is-active' : ''}`}>
                    {item.label}
                  </a>
                  {showSections && (
                    <ul class="ds-side-sublist">
                      {sections.map((s) => (
                        <li>
                          <a href={`#${s.id}`} data-rail-target={s.id} class="ds-side-sublink">
                            {s.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </nav>

        <div class="ds-side-section">
          <p class="ds-side-label">Methodology</p>
          <p class="ds-side-sub">
            Atomic design (Frost) combined with Finsweet
            <a href="https://finsweet.com/client-first" target="_blank" rel="noopener">Client-First</a>
            naming. Tokens live in <code>global.css</code> as CSS custom properties.
          </p>
        </div>
      </aside>

      <main class="ds-main">
        <div class="ds-main-content">
          <header class="ds-pagehead">
            {section && <p class="ds-section-label">{section}</p>}
            <h1>{title}</h1>
            {lede && <p class="ds-lede">{lede}</p>}
          </header>

          <slot />
        </div>

        <footer class="ds-footer">
          <div class="ds-footer-inner">
            <span>Compound Health design system</span>
            <span class="ds-footer-dot">·</span>
            <span>Noindex</span>
            <span class="ds-footer-dot">·</span>
            <span>Last updated 2026-06-02</span>
          </div>
        </footer>
      </main>
    </div>

    {sections.length > 0 && (
      <script is:inline>
        (function () {
          const links = Array.from(document.querySelectorAll('.ds-sidebar [data-rail-target]'));
          if (!links.length) return;
          const map = new Map();
          links.forEach((a) => {
            const id = a.getAttribute('data-rail-target');
            const el = document.getElementById(id);
            if (el) map.set(el, a);
          });
          if (!map.size) return;

          const setActive = (el) => {
            links.forEach((a) => a.classList.remove('is-active'));
            const a = map.get(el);
            if (a) {
              a.classList.add('is-active');
              const sidebar = document.querySelector('.ds-sidebar');
              if (sidebar) {
                const aRect = a.getBoundingClientRect();
                const sRect = sidebar.getBoundingClientRect();
                if (aRect.top < sRect.top + 60 || aRect.bottom > sRect.bottom - 60) {
                  a.scrollIntoView({ block: 'nearest' });
                }
              }
            }
          };

          const io = new IntersectionObserver((entries) => {
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.target.getBoundingClientRect().top - b.target.getBoundingClientRect().top);
            if (visible[0]) setActive(visible[0].target);
          }, { rootMargin: '-96px 0px -60% 0px', threshold: 0 });

          map.forEach((_, el) => io.observe(el));
        })();
      </script>
    )}

  </body>
</html>
