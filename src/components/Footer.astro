---
/**
 * Site footer. Shared by MainLayout, LegalLayout and BlogLayout.
 *
 * Structure (top to bottom): hairline divider, four link columns, a tall gap,
 * then the legal row. A landscape image is anchored to the bottom of the block
 * and its sky dissolves into the footer background (--warm-white) via .footer-media.
 * Swap the artwork by replacing /public/images/footer-landscape.webp. The image
 * should be around 2048x1360 or larger with a pale, near-white sky in its top half
 * and the landscape in the bottom half; update width/height below if the ratio changes.
 */
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-media" aria-hidden="true">
    <img
      class="footer-img"
      src="/images/footer-landscape.webp"
      alt=""
      width="2048"
      height="1360"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="footer-inner">
    <div class="footer-divider"></div>

    <div class="footer-cols">
      <div class="footer-brand">
        <a href="/" class="footer-logo">Compound <em>Health</em></a>
        <p class="footer-tagline">
          A private longevity membership, introduced through the people who already advise you.
        </p>
      </div>

      <div class="footer-col">
        <div class="footer-col-title">Membership</div>
        <a href="/#how">How it works</a>
        <a href="/#features">What you get</a>
        <a href="/#membership">Membership</a>
        <a href="/#joinwaitlist">Get access</a>
      </div>

      <div class="footer-col">
        <div class="footer-col-title">Partners</div>
        <a href="/#partners">For advisors and firms</a>
        <a href="/#partners">For employers</a>
        <a href="/#joinwaitlist">Introduce your clients</a>
      </div>

      <div class="footer-col">
        <div class="footer-col-title">Contact</div>
        <a href="mailto:hello@compoundhealth.io">hello@compoundhealth.io</a>
        <a href="mailto:privacy@compoundhealth.io">privacy@compoundhealth.io</a>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-copy">&copy; {year} Compound Health. All rights reserved.</div>
      <nav class="footer-legal" aria-label="Legal">
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/website-terms">Website Terms</a>
      </nav>
    </div>
  </div>
</footer>
