---
/**
 * Variation switcher. A small fixed pill at the foot of the live page and every variation, so
 * each candidate design is one click apart.
 *
 * Deliberately self-contained: its own scoped styles, no design tokens, no classes from
 * any variant stylesheet. It has to look and behave identically on top of every
 * variation, and it must never be the reason a variation renders differently.
 *
 * It ships on `/` too, because the whole set lives on the `redesign` branch and is for review.
 * Remove it from src/pages/index.astro before anything goes to production.
 */
import { SWITCHER } from '../../data/variants';

interface Props {
  /** Variant id of the page this sits on, so it can mark itself. 'live' on /. */
  current: string;
}
const { current } = Astro.props;
---

<div class="vs" data-variant-switcher>
  <span class="vs-label">Design</span>
  <nav class="vs-links" aria-label="Design variations">
    {SWITCHER.map(v => (
      <a
        href={v.path}
        class:list={['vs-link', { 'is-current': v.id === current, 'is-planned': v.status === 'planned' }]}
        aria-current={v.id === current ? 'page' : undefined}
        title={v.note}
      >
        {v.label}
      </a>
    ))}
  </nav>
</div>

<style>
  .vs {
    position: fixed;
    z-index: 9999;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 8px 6px 16px;
    border-radius: 999px;
    background: rgba(22, 24, 22, 0.86);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.22), inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  }

  .vs-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
    white-space: nowrap;
  }

  .vs-links {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .vs-link {
    display: block;
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.66);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.16s ease, color 0.16s ease;
  }

  .vs-link:hover { background: rgba(255, 255, 255, 0.1); color: #fff; }

  .vs-link.is-current {
    background: #fff;
    color: #161816;
  }

  /* A variation with no page yet still resolves, to a placeholder. Say so quietly. */
  .vs-link.is-planned { color: rgba(255, 255, 255, 0.34); }
  .vs-link.is-planned:hover { color: rgba(255, 255, 255, 0.8); }
  .vs-link.is-planned.is-current { color: #161816; }

  @media (max-width: 560px) {
    .vs { bottom: 12px; gap: 4px; padding: 6px; }
    .vs-label { display: none; }
    .vs-link { padding: 5px 10px; font-size: 11px; }
  }

  @media print {
    .vs { display: none; }
  }
</style>
