---
import Logo from './Logo.astro';
/**
 * Site footer for the design variations.
 *
 * Structure (top to bottom): hairline divider, three columns (brand, site links,
 * contact), a tall gap, then the legal row. A landscape image is anchored to the bottom of the block
 * and its sky dissolves into the footer background (--warm-white) via .footer-media.
 * Swap the artwork by replacing /public/images/footer-landscape.webp. The image
 * should be around 2048x1360 or larger with a pale, near-white sky in its top half
 * and the landscape in the bottom half; update width/height below if the ratio changes.
 *
 * `base` is the home route of the variation this footer sits in ('/v1' and so on), so the
 * in-page links resolve inside that variation. Links that leave the variation
 * (legal, for-advisors, mail) stay absolute.
 *
 * `art` is the landscape. Pass null for a variation whose footer is a gradient rather than a
 * photograph, and .footer-media is left out of the markup entirely.
 */
interface Props { base?: string; art?: string | null; }
const { base = '/', art = '/images/footer-landscape.webp' } = Astro.props;
const anchor = (hash: string) => `${base === '/' ? '/' : base}#${hash}`;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  {art && (
    <div class="footer-media" aria-hidden="true">
      <img
        class="footer-img"
        src={art}
        alt=""
        width="2048"
        height="1360"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <div class="footer-inner">
    <div class="footer-divider"></div>

    <div class="footer-cols">
      <div class="footer-brand">
        <Logo variant="footer" base={base} />
        <p class="footer-tagline">
          A private longevity membership, introduced through the people who already advise you.
        </p>
      </div>

      <div class="footer-col">
        <div class="footer-col-title">Site</div>
        <a href={anchor('how')}>How it works</a>
        <a href={anchor('features')}>What you get</a>
        <a href={anchor('membership')}>Membership</a>
        <a href="/for-advisors">For advisors and firms</a>
        <a href={anchor('joinwaitlist')}>Get access</a>
      </div>

      <div class="footer-col">
        <div class="footer-col-title">Contact</div>
        <a href="mailto:hello@compoundhealth.io">hello@compoundhealth.io</a>
        <a href="mailto:privacy@compoundhealth.io">privacy@compoundhealth.io</a>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-copy">&copy; {year} Compound Health. All rights reserved.</div>
      <nav class="footer-legal" aria-label="Legal">
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/website-terms">Website Terms</a>
      </nav>
    </div>
  </div>
</footer>
