---
import BrandLockup from './BrandLockup.astro';
// Compound Health logo: the mark plus the wordmark. Used by the design variations only.
// `variant` picks the nav or footer lockup class from the variation's stylesheet. The wordmark is
// Lato, Compound 700 and Health 400, one color; the mark alone carries sage. The mark itself is
// the .logo-mark atom: three groups of two nested chevrons around one center, legs parallel to the
// neighbouring axes, stroke and gap equal. It takes its color from currentColor.
// `base` is the home route of the variation this sits in, so the logo returns to that variation
// rather than to the live page.
// `art` picks the drawing. 'chevron' is the mark v1, v1.1 and v2 were built on, a stroked
// trefoil set in a 120 square with the wordmark beside it in the variation's own body face.
// 'brand' is the client's lockup, delivered 2026-09-11 as one outlined file: the mark redrawn
// as filled chevrons at 381x342, and Compound Health as fourteen letter paths rather than as
// type, so the letterforms are the brand's own and do not follow the page's font. Both take
// their colour from currentColor; the delivered file's #18181B is dropped, or the lockup could
// not invert over the hero. Sizes and the gap between the two live in the variation's
// stylesheet, but the proportion between mark and wordmark is the delivered one and belongs
// to whoever sets those sizes: the mark stands 342.23 to the wordmark box's 280.4, and the gap
// is 104.68 of the same units.
// `parts` is which half of the lockup to draw. 'lockup' is both, and is what every variation
// but v3 uses. v3 puts the mark alone in the bar and the wordmark alone at the foot of the page
// (client's call, 2026-09-11), so each half has to be able to stand on its own.
interface Props {
  variant?: 'nav' | 'footer';
  base?: string;
  art?: 'chevron' | 'brand';
  parts?: 'lockup' | 'mark' | 'word';
}
const { variant = 'nav', base = '/', art = 'chevron', parts = 'lockup' } = Astro.props;
const cls = variant === 'footer' ? 'footer-logo' : 'nav-logo';
---
<a href={base} class={cls} aria-label="Compound Health, home">
  {art === 'brand' ? (
    <Fragment>
      {parts !== 'word' && <BrandLockup part="mark" class="logo-mark" />}
      {parts !== 'mark' && (
        <span class="logo-word"><BrandLockup part="word" class="logo-word-art" /></span>
      )}
    </Fragment>
  ) : (
    <Fragment>
      <svg class="logo-mark" viewBox="0 0 120 120" fill="none" aria-hidden="true" focusable="false">
        <path d="M65.88 13.31L65.88 56.6L103.38 78.25M77.65 16.38L77.65 49.81L106.6 66.53M97.49 88.44L60 66.79L22.51 88.44M88.96 97.1L60 80.38L31.04 97.1M16.62 78.25L54.12 56.6L54.12 13.31M13.4 66.53L42.35 49.81L42.35 16.38" stroke="currentColor" stroke-width="5.88" stroke-linejoin="round"/>
      </svg>
      <span class="logo-word">Compound <span class="logo-word-light">Health</span></span>
    </Fragment>
  )}
</a>
