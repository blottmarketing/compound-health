---
/**
 * Theme switcher for design variation v2.
 *
 * Three complete palettes live in src/styles/variants/v2.css as `html[data-theme]` blocks;
 * this pill lets a reviewer move between them. It writes `data-theme` onto <html>, remembers
 * the choice in localStorage (key `ch-v2-theme`), and honours `?theme=<id>` in the URL so a
 * review link can open on a given theme. V2Layout applies the saved theme in <head>, before
 * first paint, so there is no flash.
 *
 * Self-contained styles, like the variant switcher: it must read the same on every theme.
 * The swatches are the theme's own colours, written here as plain values on purpose, since a
 * swatch has to show the theme it leads to, not the one that is on.
 */
const THEMES = [
  { id: 'dawn', label: 'Dawn', note: 'Orange, cream and cocoa, the joindawn.com palette.', ground: '#321C04', light: '#FBF3EB', accent: '#FF9C31' },
  { id: 'sage', label: 'Sage', note: 'Forest, moss and lime, the brand green.', ground: '#12200F', light: '#F3F5EE', accent: '#7DAE4E' },
  { id: 'dusk', label: 'Dusk', note: 'Midnight, lavender, rose and champagne.', ground: '#141428', light: '#F4F1F7', accent: '#E07A8B' },
] as const;
---

<div class="ts" data-theme-switcher>
  <span class="ts-label">Theme</span>
  <div class="ts-options" role="radiogroup" aria-label="Colour theme">
    {THEMES.map(t => (
      <button
        type="button"
        class="ts-opt"
        role="radio"
        aria-checked="false"
        data-theme-id={t.id}
        title={t.note}
        aria-label={t.label}
      >
        <span class="ts-swatch" style={`--g:${t.ground};--l:${t.light};--a:${t.accent}`}></span>
        <span class="ts-name">{t.label}</span>
      </button>
    ))}
  </div>
</div>

<style>
  .ts {
    position: fixed;
    z-index: 9999;
    bottom: 18px;
    right: 18px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 8px 6px 14px;
    border-radius: 999px;
    background: rgba(22, 24, 22, 0.86);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.22), inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  }
  .ts-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
    white-space: nowrap;
  }
  .ts-options { display: flex; align-items: center; gap: 2px; }
  .ts-opt {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px 4px 5px;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: rgba(255, 255, 255, 0.66);
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    cursor: pointer;
    transition: background 0.16s ease, color 0.16s ease;
  }
  .ts-opt:hover { background: rgba(255, 255, 255, 0.1); color: #fff; }
  .ts-opt[aria-checked="true"] { background: #fff; color: #161816; }
  .ts-swatch {
    width: 16px; height: 16px;
    border-radius: 50%;
    flex: none;
    background: conic-gradient(from 210deg, var(--g) 0 40%, var(--a) 40% 62%, var(--l) 62% 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25);
  }
  .ts-opt[aria-checked="true"] .ts-swatch { box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.15); }

  @media (max-width: 720px) {
    .ts { right: 12px; bottom: 64px; gap: 4px; padding: 6px; }
    .ts-label, .ts-name { display: none; }
    .ts-opt { padding: 5px; }
    .ts-swatch { width: 18px; height: 18px; }
  }
  @media print { .ts { display: none; } }
</style>

<script>
  (function () {
    const KEY = 'ch-v2-theme';
    const root = document.documentElement;
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-id]'));
    const ids = buttons.map(b => b.dataset.themeId || '');
    const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

    function apply(id: string, remember: boolean) {
      if (!ids.includes(id)) id = ids[0];
      root.dataset.theme = id;
      buttons.forEach(b => b.setAttribute('aria-checked', String(b.dataset.themeId === id)));
      // The bar colour on mobile follows the dark ground of the theme.
      const swatch = buttons.find(b => b.dataset.themeId === id)?.querySelector<HTMLElement>('.ts-swatch');
      const ground = swatch ? getComputedStyle(swatch).getPropertyValue('--g').trim() : '';
      if (meta && ground) meta.content = ground;
      if (remember) { try { localStorage.setItem(KEY, id); } catch (_) { /* private mode */ } }
    }

    buttons.forEach(b => b.addEventListener('click', () => apply(b.dataset.themeId || '', true)));
    // The head script has already set data-theme; this just marks the matching option.
    apply(root.dataset.theme || ids[0], false);
  })();
</script>
