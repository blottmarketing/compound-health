---
import BlogLayout from '../../layouts/BlogLayout.astro';
import {
  authors,
  postsByAuthor,
  getAuthor,
  getCategory,
  sortedPosts,
  formatDate,
} from '../../data/blog';

export async function getStaticPaths() {
  return authors.map((a) => ({
    params: { author: a.slug },
    props: { author: a },
  }));
}

const { author } = Astro.props;
const list = sortedPosts(postsByAuthor(author.slug));
const tones = ['', 'tone-sage', 'tone-cream', 'tone-charcoal', 'tone-gold'];
---

<BlogLayout
  title={`${author.name} | Compound Health`}
  description={author.bio}
>

  <!-- HERO -->
  <section class="author-hero">
    <div class="inner">
      <div class="author-hero-top">
        <span class="avatar-xl">{author.initials}</span>
        <div class="author-hero-name">
          <h1>{author.name}</h1>
          <p class="author-hero-role">{author.role}</p>
        </div>
      </div>
      <p class="author-bio">{author.bio}</p>
    </div>
  </section>

  <!-- POSTS -->
  <section class="blog-body">
    <div class="inner">
      {list.length === 0 ? (
        <div class="blog-empty">
          <h3>Nothing here yet</h3>
          <p>{author.name} has not published a post yet. Check back soon.</p>
        </div>
      ) : (
        <div class="blog-grid">
          {list.map((p, i) => {
            const cat = getCategory(p.categorySlug);
            return (
              <a class="post-card" href={`/blog/${p.slug}`}>
                <div class={`post-card-cover ${tones[i % tones.length]}`}>
                  <span class="post-card-cover-mark">Compound Health</span>
                </div>
                {cat && <p class="post-card-eyebrow">{cat.name}</p>}
                <h3>{p.title}</h3>
                <p class="post-card-excerpt">{p.excerpt}</p>
                <div class="post-card-meta">
                  <div class="author-stack">
                    {p.authorSlugs.map((slug) => {
                      const a = getAuthor(slug);
                      return a ? <span class="avatar" title={a.name}>{a.initials}</span> : null;
                    })}
                  </div>
                  <span class="meta-date">{formatDate(p.date)}</span>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>

</BlogLayout>
