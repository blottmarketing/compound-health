            </div>

            <div class="sf-window" id="sfWindow">
              <div class="sf-step" data-step="1">
                <div class="wf-role" id="wfRole" role="radiogroup" aria-label="I am">
                  <span class="wf-role-label">I am</span>
                  <div class="wf-segments">
                    <button class="wf-segment is-active" type="button" role="radio" aria-checked="true"
                            data-role="client" data-audience="client">A client</button>
                    <button class="wf-segment" type="button" role="radio" aria-checked="false"
                            data-role="wealth-firm" data-audience="partner">A wealth firm</button>
                    <button class="wf-segment" type="button" role="radio" aria-checked="false"
                            data-role="employer" data-audience="partner">An employer</button>
                    <button class="wf-segment" type="button" role="radio" aria-checked="false"
                            data-role="network" data-audience="partner">A network or organization</button>
                  </div>
                </div>
              </div>

              <div class="sf-step" data-step="2">
                <div class="wf-row">
                  <div class="wf-field">
                    <label class="wf-label" for="wf-fname">First name</label>
                    <input class="wf-input" type="text" id="wf-fname" placeholder="James" autocomplete="given-name" />
                  </div>
                  <div class="wf-field">
                    <label class="wf-label" for="wf-lname">Last name</label>
                    <input class="wf-input" type="text" id="wf-lname" placeholder="Pemberton" autocomplete="family-name" />
                  </div>
                </div>
              </div>

              <div class="sf-step" data-step="3">
                <div class="wf-field">
                  <label class="wf-label" for="wf-email">Email address</label>
                  <input class="wf-input" type="email" id="wf-email" placeholder="james@example.com" autocomplete="email" />
                </div>
              </div>

              <div class="sf-step" data-step="4">
                <div class="wf-field" data-shown-to="client">
                  <label class="wf-label" for="wf-tier">Membership tier of interest</label>
                  <select class="wf-input wf-select" id="wf-tier">
                    <option value="" disabled selected>Select a tier</option>
                    <option value="baseline">Baseline</option>
                    <option value="optimize">Optimize</option>
                    <option value="eternal">Eternal</option>
                  </select>
                </div>
                <div class="wf-field" data-shown-to="partner" hidden>
                  <label class="wf-label" for="wf-org">Organization name</label>
                  <input class="wf-input" type="text" id="wf-org" placeholder="e.g. Pemberton Family Office" autocomplete="organization" />
                </div>
              </div>

              <div class="sf-step" data-step="5">
                <div class="wf-field" data-shown-to="client">
                  <label class="wf-label" for="wf-advisor">Referring advisor or firm (optional)</label>
                  <input class="wf-input" type="text" id="wf-advisor" placeholder="e.g. Rockefeller Capital" />
                </div>
                <div class="wf-field" data-shown-to="partner" hidden>
                  <label class="wf-label" for="wf-reach">People you would introduce (optional)</label>
                  <select class="wf-input wf-select" id="wf-reach">
                    <option value="" disabled selected>Select a range</option>
                    <option value="under-100">Under 100</option>
                    <option value="100-500">100 to 500</option>
                    <option value="500-2000">500 to 2,000</option>
                    <option value="over-2000">Over 2,000</option>
                  </select>
                </div>
