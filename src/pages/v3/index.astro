  <!-- ===================================================================
       MOTION
       Three scrubbed set pieces (the hero window, the pinned carousel, the
       orbit) and four small behaviours. With reduced motion every scrub is
       skipped and the two pinned sections lay themselves out as plain
       stacks, which is what .is-static does.
       =================================================================== -->
  <script>
    (function () {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const g = (window as any).gsap;
      const ST = (window as any).ScrollTrigger;
      const canScrub = !!(g && ST) && !reduce;

      // --- the hero window -------------------------------------------------
      // clip-path from inset(0) to inset(32px round 64px). The picture never
      // moves; the window pulls in around it.
      (function () {
        const hero = document.getElementById('hero');
        if (!hero) return;
        let ticking = false;
        const update = () => {
          ticking = false;
          hero.classList.toggle('is-zoomed', window.scrollY > 100);
        };
        window.addEventListener('scroll', () => {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
        update();
      })();

      // --- the hero ticker ---------------------------------------------------
      // One line at a time, rising into a fixed window every 2.5s.
      (function () {
        const items = Array.from(document.querySelectorAll<HTMLElement>('[data-ticker-item]'));
        if (!items.length) return;
        items[0].classList.add('is-in');
        if (reduce || items.length === 1) return;
        let i = 0;
        setInterval(() => {
          const out = items[i];
          i = (i + 1) % items.length;
          const next = items[i];
          out.classList.remove('is-in');
          out.classList.add('is-out');
          next.classList.remove('is-out');
          // A frame at translateY(100%) before the class lands, so it rises.
          requestAnimationFrame(() => next.classList.add('is-in'));
          window.setTimeout(() => out.classList.remove('is-out'), 1000);
        }, 2500);
      })();

      // --- the mark draws itself ---------------------------------------------
      (function () {
        const svg = document.querySelector<SVGSVGElement>('[data-draw]');
        if (!svg) return;
        const path = svg.querySelector('path');
        if (!path) return;
        const len = Math.ceil(path.getTotalLength());
        svg.style.setProperty('--len', String(len));
        if (reduce || !('IntersectionObserver' in window)) { svg.classList.add('is-drawn'); return; }
        new IntersectionObserver((entries, obs) => {
          entries.forEach(e => {
            if (!e.isIntersecting) return;
            svg.classList.add('is-drawn');
            obs.disconnect();
          });
        }, { threshold: 0.4 }).observe(svg);
      })();

      // --- the pinned carousel ------------------------------------------------
      // Three panels on one stage. Each rises over the one before it and the
      // one it covers settles back and dims. Scrubbed, never snapped.
      (function () {
        const section = document.querySelector<HTMLElement>('[data-car]');
        const stage = document.querySelector<HTMLElement>('[data-car-stage]');
        const panels = Array.from(document.querySelectorAll<HTMLElement>('.car-panel'));
        if (!section || !stage || panels.length < 2) return;
        if (!canScrub) { section.classList.add('is-static'); return; }

        const copies = panels.map(p => p.querySelector<HTMLElement>('.car-copy'));
        const mm = g.matchMedia();

        mm.add('(max-width: 1279px)', () => {
          section.classList.add('is-static');
        });

        mm.add('(min-width: 1280px)', () => {
          section.classList.remove('is-static');
          // The first card is on top and the queued ones sit under it, which is
          // why the reference writes this deck backwards in the DOM. Only the
          // rounded edge of the next card shows below the one in front.
          panels.forEach((p, i) => { p.style.zIndex = String(panels.length - i); });
          g.set(panels.slice(1), { yPercent: 10, scale: 0.95, opacity: 0.3 });
          g.set(copies.slice(1), { opacity: 0 });

          const tl = g.timeline({
            defaults: { ease: 'none' },
            scrollTrigger: {
              trigger: section,
              start: 'center center',
              end: () => `+=${2.4 * window.innerHeight}`,
              pin: stage,
              scrub: 0.3,
              invalidateOnRefresh: true,
            },
          });

          // Each panel is held before it leaves. The first arrangement had the
          // front card starting to go at 8 per cent of the pin, about 180px of
          // scroll, so the first caption was gone before it could be read.
          // Now each of the three rests for about a fifth of the pin and the
          // two transitions take about a quarter each.
          const HOLD = 0.9;
          const STEP = 1.9;
          for (let i = 1; i < panels.length; i++) {
            const at = HOLD + (i - 1) * STEP;
            // The scale finishes early and on its own tween. Opacity runs 0.3
            // to 1 over the whole transition and crosses 0.5 at progress
            // 0.286; a scale tween of 0.25 is done before that, so the plate
            // is never both legible and rasterised at a fraction.
            tl.to(panels[i - 1], { y: () => -window.innerHeight, duration: 1 }, at)
              .to(copies[i - 1], { opacity: 0, duration: 0.35 }, at)
              .to(panels[i], { yPercent: 0, opacity: 1, duration: 1 }, at)
              .to(panels[i], { scale: 1, duration: 0.25 }, at)
              .to(copies[i], { opacity: 1, duration: 0.4 }, at + 0.4);
          }
          tl.to({}, { duration: HOLD - 0.3 });

          // Crossing the breakpoint has to leave nothing behind: the timeline
          // and its pin go with it, and the inline state comes off.
          return () => {
            section.classList.add('is-static');
            g.set(panels, { clearProps: 'all' });
            g.set(copies, { clearProps: 'all' });
            panels.forEach(p => { p.style.zIndex = ''; });
          };
        });
      })();

      // --- the orbit ------------------------------------------------------------
      // Six tiles parked on an ellipse whose polar angle is scrubbed by scroll,
      // around a line that leaves as the next one arrives.
      (function () {
        const section = document.querySelector<HTMLElement>('[data-orbit]');
        const stage = document.querySelector<HTMLElement>('[data-orbit-stage]');
        const orbs = Array.from(document.querySelectorAll<HTMLElement>('[data-orb]'));
        const copy = document.querySelector<HTMLElement>('.orbit-copy');
        const h1 = document.querySelector<HTMLElement>('[data-orbit-h1]');
        const h2 = document.querySelector<HTMLElement>('[data-orbit-h2]');
        if (!section || !stage || !orbs.length) return;
        if (!canScrub) { section.classList.add('is-static'); return; }

        // Each tile sweeps from its first angle to its second. The narrow set
        // keeps them on screen when the ellipse is small.
        const WIDE = [[-174, -74], [-120, -74], [-125, 35], [5, 105], [95, 195], [30, 105]];
        const NARROW = [[-154, -84], [-120, -74], [-25, 35], [110, 130], [180, 205], [100, 120]];
        const OFFSETS = [[0, 0], [-80, 10], [-25, -60], [-50, 40], [25, -60], [50, -100]];

        function place(p: number) {
          const w = window.innerWidth;
          const narrow = w < 700;
          const mid = w >= 700 && w < 1280;
          const half = w / 2;
          const copyBox = copy ? copy.getBoundingClientRect() : null;

          // On a phone the ring cannot clear the line: a 300px headline in a
          // 390px window leaves no horizontal room for a tile beside it. So
          // there the objects give the middle back and take the bands above
          // and below, measured off the copy itself rather than guessed, and
          // still rise with the scroll. Above 700 the ellipse returns.
          if (narrow && copyBox) {
            // The second line is absolutely positioned over the first and is
            // the taller of the two; the band has to clear whichever is
            // showing, or the tiles close in on the longer one.
            const h2box = h2 ? h2.getBoundingClientRect().height : 0;
            const halfH = Math.max(copyBox.height, h2box + 56) / 2;
            const gap = 28;
            const scale = 0.46;
            const BANDS = [[0, 1, 2], [3, 4, 5]];
            const STACK = [0, -132, -48, 36, 98, 10];
            // The lanes are computed from the tiles' real widths rather than
            // set by hand: three cards of four different sizes cannot be
            // packed across 390px by guessing at fractions, and when they were
            // they printed over each other.
            BANDS.forEach((band, b) => {
              const widths = band.map(i => orbs[i].offsetWidth * scale);
              const total = widths.reduce((a, v) => a + v, 0);
              // Three tiles barely fit across 390. Whatever will not fit hangs
              // off the left, where the first tile of each band is a
              // photograph: a picture may be cropped by the edge, a card
              // cut through the middle of a word only looks like a mistake.
              const minGap = 10;
              const inner = w - 16;
              const over = Math.max(0, total + minGap * 2 - inner);
              const slack = Math.max(minGap, (inner + over - total) / (band.length - 1));
              let cursor = -w / 2 + 8 - over;
              band.forEach((i, k) => {
                const el = orbs[i];
                const ow = widths[k];
                const oh = el.offsetHeight * scale;
                const cx = cursor + ow / 2;
                cursor += ow + slack;
                const above = b === 0;
                const cy = (above ? -(halfH + gap) - oh / 2 : halfH + gap + oh / 2)
                  + STACK[i] + (1 - p) * 70;
                const x = cx - el.offsetWidth / 2;
                const y = cy - el.offsetHeight / 2;
                el.style.transform = `translate(${x}px, ${y}px) scale(${Math.min(1, 2 * p) * scale})`;
                const inner = el.querySelector<HTMLElement>('.orb-photo .ph, .orb-photo img');
                if (inner) inner.style.setProperty('--counter', String(2 - Math.min(1, p)));
              });
            });
            return;
          }

          const set = w < 1024 ? NARROW : WIDE;
          const rx = (mid ? 0.36 : 0.37) * w;
          const ry = (mid ? 0.34 : 0.32) * window.innerHeight;
          const k = mid ? 0.6 : 1;
          const scale = mid ? 0.78 : 1;
          // The bar is a fixed object at the top of the window; the orbit has
          // to clear it, so the whole composition sits below centre.
          const bias = 62;

          orbs.forEach((el, i) => {
            const [a0, a1] = set[i % set.length];
            const ang = a0 + (a1 - a0) * p;
            const rad = ((ang - 60) * Math.PI) / 180;
            const ow = el.offsetWidth * scale;
            let x = Math.cos(rad) * rx - el.offsetWidth / 2 + OFFSETS[i][0] * k;
            const y = Math.sin(rad) * ry - el.offsetHeight / 2 + OFFSETS[i][1] * k + bias;

            // Nothing is cut by a border: the sweep takes a card through
            // cos = 1, and without this it would be sliced there.
            const lo = -half - (el.offsetWidth - ow) / 2 + 16;
            const hi = half - ow - (el.offsetWidth - ow) / 2 - 16;
            x = Math.max(lo, Math.min(hi, x));

            el.style.transform = `translate(${x}px, ${y}px) scale(${Math.min(1, 2 * p) * scale})`;
            const inner = el.querySelector<HTMLElement>('.orb-photo .ph, .orb-photo img');
            if (inner) inner.style.setProperty('--counter', String(2 - Math.min(1, p)));
          });
        }
        place(0);
        window.addEventListener('resize', () => place(lastP), { passive: true });
        let lastP = 0;

        const tl = g.timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            trigger: section,
            start: 'center center',
            end: () => `+=${2.2 * window.innerHeight}`,
            pin: stage,
            scrub: 0.4,
            invalidateOnRefresh: true,
            onUpdate: (self: any) => { lastP = self.progress; place(self.progress); },
          },
        });
        if (h1 && h2) {
          // The first line arrives, is held, hands over, and the second gets a
          // comparable stretch to itself rather than only the last fifth.
          tl.fromTo(h1, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.7 }, 0)
            .to({}, { duration: 1.5 })
            .to(h1, { opacity: 0, y: -40, duration: 0.6 })
            // Five hundredths of overlap: enough that the two lines cross at
            // about 0.04 each, which is under the threshold at which this
            // near-black type is legible on this cream, and not so much that
            // they are both readable on the way past. Strict sequencing left
            // a window with neither line on screen, and that window varied
            // with the viewport, which is worse than either.
            .fromTo(h2, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.6 }, '>-0.05')
            .to({}, { duration: 1.5 });
        }
      })();

      // --- the mark trail ---------------------------------------------------
      // The pointer leaves a line of marks across the orbit; each one blooms and
      // then wilts over two seconds. Pointer devices only, and never under
      // reduced motion. It is the cheapest memorable thing on the reference and
      // it costs one canvas.
      (function () {
        const canvas = document.querySelector<HTMLCanvasElement>('[data-trail]');
        const host = document.querySelector<HTMLElement>('[data-orbit-stage]');
        if (!canvas || !host) return;
        if (reduce || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
          canvas.remove();
          return;
        }
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        const D =
          'M65.88 13.31L65.88 56.6L103.38 78.25M77.65 16.38L77.65 49.81L106.6 66.53' +
          'M97.49 88.44L60 66.79L22.51 88.44M88.96 97.1L60 80.38L31.04 97.1' +
          'M16.62 78.25L54.12 56.6L54.12 13.31M13.4 66.53L42.35 49.81L42.35 16.38';
        const mark = new Path2D(D);
        const LIFE = 2000;
        const SIZE = 46;
        const stamps: { x: number; y: number; t: number; r: number }[] = [];
        let dpr = 1;
        let last = { x: -999, y: -999 };
        let raf = 0;

        function size() {
          dpr = Math.min(2, window.devicePixelRatio || 1);
          canvas!.width = host!.clientWidth * dpr;
          canvas!.height = host!.clientHeight * dpr;
          canvas!.style.width = host!.clientWidth + 'px';
          canvas!.style.height = host!.clientHeight + 'px';
        }
        size();
        window.addEventListener('resize', size, { passive: true });

        host.addEventListener('pointermove', e => {
          const r = host.getBoundingClientRect();
          const x = e.clientX - r.left;
          const y = e.clientY - r.top;
          if (Math.hypot(x - last.x, y - last.y) < 38) return;
          last = { x, y };
          stamps.push({ x, y, t: performance.now(), r: (Math.random() - 0.5) * 0.9 });
          if (stamps.length > 26) stamps.shift();
          if (!raf) raf = requestAnimationFrame(draw);
        }, { passive: true });

        function draw(now: number) {
          raf = 0;
          ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx!.clearRect(0, 0, canvas!.width, canvas!.height);
          let alive = false;
          for (const st of stamps) {
            const age = (now - st.t) / LIFE;
            if (age >= 1) continue;
            alive = true;
            // Bloom over the first fifth, wilt over the rest.
            const bloom = age < 0.2 ? 1 - Math.pow(1 - age / 0.2, 3) : 1;
            const wilt = age < 0.2 ? 1 : 1 - 0.38 * ((age - 0.2) / 0.8);
            const alpha = (age < 0.2 ? age / 0.2 : 1 - (age - 0.2) / 0.8) * 0.34;
            const k = (SIZE * bloom * wilt) / 120;
            ctx!.save();
            ctx!.translate(st.x, st.y);
            ctx!.rotate(st.r);
            ctx!.scale(k, k);
            ctx!.translate(-60, -60);
            ctx!.strokeStyle = `rgba(26, 22, 19, ${alpha})`;
            ctx!.lineWidth = 5.88;
            ctx!.lineJoin = 'round';
            ctx!.lineCap = 'round';
            ctx!.stroke(mark);
            ctx!.restore();
          }
          if (alive) raf = requestAnimationFrame(draw);
        }
      })();

      // --- the accordion ----------------------------------------------------
      // One open at a time. The panel's height is animated from its measured
      // content height, so it works with any amount of copy.
      (function () {
        const root = document.querySelector<HTMLElement>('[data-acc]');
        if (!root) return;
        const items = Array.from(root.querySelectorAll<HTMLElement>('.acc-item'));

        // Without script every row stays open, which is why the panel's
        // resting height is auto in the stylesheet. Script closes them on
        // load and takes ownership of the wiring at the same time.
        items.forEach((item, i) => {
          const btn = item.querySelector<HTMLButtonElement>('.acc-btn');
          const panel = item.querySelector<HTMLElement>('.acc-panel');
          if (!btn || !panel) return;
          btn.id = `acc-btn-${i}`;
          panel.id = `acc-panel-${i}`;
          btn.setAttribute('aria-controls', panel.id);
          btn.setAttribute('aria-expanded', 'false');
          panel.setAttribute('role', 'region');
          panel.setAttribute('aria-labelledby', btn.id);
          panel.style.height = '0px';
        });

        function close(item: HTMLElement) {
          const panel = item.querySelector<HTMLElement>('.acc-panel');
          const btn = item.querySelector<HTMLButtonElement>('.acc-btn');
          if (!panel || !btn) return;
          panel.style.height = panel.scrollHeight + 'px';
          requestAnimationFrame(() => { panel.style.height = '0px'; });
          item.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
        }
        function open(item: HTMLElement) {
          const panel = item.querySelector<HTMLElement>('.acc-panel');
          const btn = item.querySelector<HTMLButtonElement>('.acc-btn');
          if (!panel || !btn) return;
          items.forEach(other => { if (other !== item) close(other); });
          item.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          panel.style.height = panel.scrollHeight + 'px';
          panel.addEventListener('transitionend', function done(e) {
            if (e.propertyName !== 'height') return;
            if (item.classList.contains('is-open')) panel.style.height = 'auto';
            panel.removeEventListener('transitionend', done);
          });
        }

        items.forEach(item => {
          const btn = item.querySelector<HTMLButtonElement>('.acc-btn');
          btn?.addEventListener('click', () => {
            if (item.classList.contains('is-open')) close(item);
            else open(item);
          });
        });
      })();

      // --- the count -----------------------------------------------------------
      (function () {
        const el = document.querySelector<HTMLElement>('[data-count]');
        if (!el) return;
        const target = Number(el.dataset.count);
        if (reduce || !('IntersectionObserver' in window)) { el.textContent = String(target); return; }
        const ease = (t: number) => 1 - Math.pow(1 - t, 3);
        new IntersectionObserver((entries, obs) => {
          entries.forEach(e => {
            if (!e.isIntersecting) return;
            obs.disconnect();
            const t0 = performance.now();
            const tick = (now: number) => {
              const t = Math.min(1, (now - t0) / 1400);
              el.textContent = String(Math.round(ease(t) * target));
              if (t < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
        }, { threshold: 0.5 }).observe(el);
      })();

      // --- the two captures hand their address to the real form ----------------
      // Neither posts. There is one submission on this page and it is the form
      // at the foot; these carry the address down to it and put the reader in
      // the first field they still have to fill.
      (function () {
        document.querySelectorAll<HTMLFormElement>('[data-handoff]').forEach(form => {
          form.addEventListener('submit', (e) => {
            e.preventDefault();
            const from = form.querySelector<HTMLInputElement>('[data-handoff-email]');
            const to = document.getElementById('wf-email') as HTMLInputElement | null;
            if (from && to && from.value.trim()) to.value = from.value.trim();
            const target = document.getElementById('joinwaitlist');
            const lenis = (window as any).__lenis;
            if (lenis && target) lenis.scrollTo(target, { offset: -80 });
            else target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            window.setTimeout(() => {
              const first = document.getElementById('wf-fname') as HTMLInputElement | null;
              first?.focus({ preventScroll: true });
            }, 700);
          });
        });
      })();
    })();
  </script>

  <!-- Custom dropdowns. Each select.wf-select is wrapped and given a button and a
       listbox; the native select stays as the value the form script reads. Without
       JavaScript the native select is what the reader sees. -->
  <script>
    (function () {
      const CHEV = '<svg class="wf-dd-chev" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      const TICK = '<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3.2 3L13 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';

      document.querySelectorAll<HTMLSelectElement>('select.wf-select').forEach((sel, n) => {
        const label = sel.id ? document.querySelector<HTMLLabelElement>(`label[for="${sel.id}"]`) : null;
        const wrap = document.createElement('div');
        wrap.className = 'wf-dd';
        sel.parentNode?.insertBefore(wrap, sel);
        wrap.appendChild(sel);
        sel.tabIndex = -1;
        sel.setAttribute('aria-hidden', 'true');

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'wf-dd-btn';
        btn.id = `${sel.id || 'wf-dd-' + n}-btn`;
        btn.setAttribute('aria-haspopup', 'listbox');
        btn.setAttribute('aria-expanded', 'false');
        const text = document.createElement('span');
        text.id = `${btn.id}-value`;
        btn.appendChild(text);
        // The name is the label plus the current value, not the label alone:
        // aria-label would replace the button's contents and the chosen tier
        // would be nowhere in the accessibility tree, which also breaks
        // WCAG 2.5.3, since the visible word must be in the name.
        if (label) {
          label.id = label.id || `${btn.id}-label`;
          label.htmlFor = btn.id;
          btn.setAttribute('aria-labelledby', `${label.id} ${text.id}`);
        }
        btn.insertAdjacentHTML('beforeend', CHEV);

        const list = document.createElement('ul');
        list.className = 'wf-dd-list';
        list.setAttribute('role', 'listbox');
        list.id = `${btn.id}-list`;
        btn.setAttribute('aria-controls', list.id);

        const opts = Array.from(sel.options).filter(o => !o.disabled);
        const items = opts.map(o => {
          const li = document.createElement('li');
          li.className = 'wf-dd-opt';
          li.setAttribute('role', 'option');
          li.id = `${btn.id}-opt-${opts.indexOf(o)}`;
          li.dataset.value = o.value;
          li.innerHTML = `<span>${o.textContent}</span>${TICK}`;
          li.addEventListener('click', () => { choose(o.value); close(); btn.focus(); });
          list.appendChild(li);
          return li;
        });
        wrap.appendChild(btn);
        wrap.appendChild(list);

        const placeholder = sel.options[0]?.disabled ? sel.options[0].textContent || '' : '';
        let focus = -1;

        function render() {
          const cur = sel.value;
          const selected = opts.find(o => o.value === cur && cur !== '');
          text.textContent = selected ? (selected.textContent || '') : placeholder;
          btn.classList.toggle('is-empty', !selected);
          items.forEach(li => li.setAttribute('aria-selected', String(li.dataset.value === cur && cur !== '')));
        }
        function choose(value: string) {
          sel.value = value;
          sel.dispatchEvent(new Event('change', { bubbles: true }));
          render();
        }
        function open() {
          list.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          focus = Math.max(0, opts.findIndex(o => o.value === sel.value));
          paint();
        }
        function close() {
          list.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
          focus = -1;
          paint();
        }
        function paint() {
          items.forEach((li, i) => li.classList.toggle('is-focus', i === focus));
          // Without this the arrow keys move a highlight nobody can hear.
          if (focus >= 0) btn.setAttribute('aria-activedescendant', items[focus].id);
          else btn.removeAttribute('aria-activedescendant');
        }

        btn.addEventListener('click', () => (list.classList.contains('is-open') ? close() : open()));
        btn.addEventListener('keydown', e => {
          const last = items.length - 1;
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === 'Enter' || e.key === ' ') {
            if (!list.classList.contains('is-open')) { e.preventDefault(); open(); return; }
          }
          if (!list.classList.contains('is-open')) return;
          if (e.key === 'ArrowDown') { e.preventDefault(); focus = focus >= last ? 0 : focus + 1; paint(); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); focus = focus <= 0 ? last : focus - 1; paint(); }
          else if (e.key === 'Home') { e.preventDefault(); focus = 0; paint(); }
          else if (e.key === 'End') { e.preventDefault(); focus = last; paint(); }
          else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); if (focus >= 0) { choose(opts[focus].value); close(); } }
          else if (e.key === 'Escape') { e.preventDefault(); close(); }
          else if (e.key === 'Tab') close();
        });
        document.addEventListener('click', e => { if (!wrap.contains(e.target as Node)) close(); });
        sel.addEventListener('change', render);
        render();
      });
    })();
  </script>

  <!-- The waitlist form. Endpoint, routing and validation are the live form's. -->
  <script>
    const WAITLIST_ENDPOINT =
      'https://script.google.com/macros/s/AKfycbw9x1Q9dVIDbTRRnsgajzbXHrL2Y3mz7SSWO2qHGtDeK9XsrxKhtBpItlPaY3oDn28/exec';

    const ROUTING_TAG: Record<string, string> = {
      client: 'client-waitlist',
      partner: 'partner-pipeline',
    };

    const waitlistForm = document.getElementById('waitlistForm') as HTMLDivElement | null;
    const waitlistSuccess = document.getElementById('waitlistSuccess') as HTMLDivElement | null;
    const wfSubmit = document.getElementById('wfSubmit') as HTMLButtonElement | null;
    const wfError = document.getElementById('wfError') as HTMLDivElement | null;
    const wfErrorMsg = wfError?.querySelector('.wf-error-msg') as HTMLSpanElement | null;
    const wfLabel = wfSubmit?.querySelector('.wf-submit-label') as HTMLSpanElement | null;
    const wfRole = document.getElementById('wfRole') as HTMLDivElement | null;
    const wsTitle = document.getElementById('wsTitle') as HTMLHeadingElement | null;
    const wsBody = document.getElementById('wsBody') as HTMLParagraphElement | null;
    const wsReset = document.getElementById('wsReset') as HTMLButtonElement | null;
    const ORIGINAL_LABEL = wfLabel?.textContent ?? 'Reserve my place';

    const segments = Array.from(wfRole?.querySelectorAll<HTMLButtonElement>('.wf-segment') ?? []);

    function currentAudience(): string {
      const active = segments.find(s => s.classList.contains('is-active'));
      return active?.dataset.audience ?? 'client';
    }
    function currentRole(): string {
      const active = segments.find(s => s.classList.contains('is-active'));
      return active?.dataset.role ?? 'client';
    }
    function showError(message: string) {
      if (!wfError) return;
      if (wfErrorMsg) wfErrorMsg.textContent = message;
      wfError.classList.add('visible');
    }
    function clearError() { wfError?.classList.remove('visible'); }

    function applyAudience(audience: string) {
      document.querySelectorAll<HTMLElement>('[data-shown-to]').forEach(field => {
        field.hidden = field.dataset.shownTo !== audience;
      });
    }

    function selectRole(role: string) {
      const target =
        segments.find(s => s.dataset.role === role) ??
        (role === 'partner' ? segments.find(s => s.dataset.audience === 'partner') : undefined);
      if (!target) return;
      segments.forEach(s => {
        const isActive = s === target;
        s.classList.toggle('is-active', isActive);
        s.setAttribute('aria-checked', String(isActive));
      });
      applyAudience(target.dataset.audience ?? 'client');
      clearError();
    }

    segments.forEach(segment => {
      segment.addEventListener('click', () => selectRole(segment.dataset.role ?? 'client'));
    });

    document.addEventListener('click', event => {
      const trigger = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-wf-role]');
      if (trigger) selectRole(trigger.dataset.wfRole ?? 'partner');
    });

    applyAudience(currentAudience());

    if (wfSubmit && waitlistForm && waitlistSuccess) {
      wfSubmit.addEventListener('click', async () => {
        clearError();
        const fnameInput = document.getElementById('wf-fname') as HTMLInputElement | null;
        const lnameInput = document.getElementById('wf-lname') as HTMLInputElement | null;
        const emailInput = document.getElementById('wf-email') as HTMLInputElement | null;
        const tierInput = document.getElementById('wf-tier') as HTMLSelectElement | null;
        const advisorInput = document.getElementById('wf-advisor') as HTMLInputElement | null;
        const orgInput = document.getElementById('wf-org') as HTMLInputElement | null;
        const reachInput = document.getElementById('wf-reach') as HTMLSelectElement | null;

        const audience = currentAudience();
        const isPartner = audience === 'partner';

        const firstName = fnameInput?.value.trim() ?? '';
        const lastName = lnameInput?.value.trim() ?? '';
        const email = emailInput?.value.trim() ?? '';
        const tier = tierInput?.value ?? '';
        const advisor = advisorInput?.value.trim() ?? '';
        const org = orgInput?.value.trim() ?? '';
        const reach = reachInput?.value ?? '';

        if (!firstName) { fnameInput?.focus(); return; }
        if (!lastName) { lnameInput?.focus(); return; }
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { emailInput?.focus(); return; }
        if (isPartner) { if (!org) { orgInput?.focus(); return; } }
        else if (!tier) { tierInput?.focus(); return; }

        wfSubmit.disabled = true;
        if (wfLabel) wfLabel.textContent = 'Submitting…';

        const payload = new URLSearchParams({
          role: currentRole(),
          audience,
          routingTag: ROUTING_TAG[audience] ?? ROUTING_TAG.client,
          firstName,
          lastName,
          email,
          tier: isPartner ? '' : tier,
          advisor: isPartner ? '' : advisor,
          organization: isPartner ? org : '',
          reach: isPartner ? reach : '',
          source: 'compoundhealth.io',
          submittedAt: new Date().toISOString(),
          userAgent: navigator.userAgent,
        });

        try {
          const res = await fetch(WAITLIST_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
            body: payload.toString(),
          });
          if (!res.ok) throw new Error('Request failed: ' + res.status);

          if (isPartner) {
            if (wsTitle) wsTitle.textContent = 'Request received';
            if (wsBody) {
              wsBody.textContent =
                'Thank you. We will be in touch to discuss a program for your organization.';
            }
          } else {
            if (wsTitle) wsTitle.textContent ="You're on the list";
            if (wsBody) {
              wsBody.textContent =
                'Thank you' + (firstName ? ', ' + firstName : '') +
                '. Your founding member request has been received. Our team will be in ' +
                'touch as soon as your tier opens.';
            }
          }

          waitlistForm.style.display = 'none';
          waitlistSuccess.classList.add('visible');
          waitlistSuccess.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch (err) {
          console.error('Waitlist submission failed', err);
          wfSubmit.disabled = false;
          if (wfLabel) wfLabel.textContent = ORIGINAL_LABEL;
          showError("We couldn't submit your details. Please check your connection and try again.");
        }
      });
    }

    if (wsReset && waitlistForm && waitlistSuccess && wfSubmit) {
      wsReset.addEventListener('click', () => {
        ['wf-fname', 'wf-lname', 'wf-email', 'wf-advisor', 'wf-org'].forEach(id => {
          const el = document.getElementById(id) as HTMLInputElement | null;
          if (el) el.value = '';
        });
        ['wf-tier', 'wf-reach'].forEach(id => {
          const el = document.getElementById(id) as HTMLSelectElement | null;
          if (el) { el.value = ''; el.dispatchEvent(new Event('change')); }
        });
        selectRole('client');
        waitlistSuccess.classList.remove('visible');
        waitlistForm.style.display = '';
        wfSubmit.disabled = false;
        if (wfLabel) wfLabel.textContent = ORIGINAL_LABEL;
        clearError();
      });
    }
  </script>

</V3Layout>
