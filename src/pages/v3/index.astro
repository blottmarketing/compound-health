            </div>

            <div class="wf-error" id="wfError" aria-live="polite" role="alert">
              <svg class="ico ico-sm" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 16.5h.01"/></svg>
              <span class="wf-error-msg">Something went wrong. Please try again.</span>
            </div>

            <!-- The action leads, because every other line on this panel starts
                 at the same edge and a button pushed to the right would be the
                 only thing not standing on it. The two quiet ways out follow. -->
            <div class="sf-actions">
              <button class="btn btn-primary sf-go" id="sfNext" type="button">
                <span class="btn-label">Continue</span>
                <span class="btn-icon">
                  <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </button>
              <button class="btn btn-primary wf-submit" id="wfSubmit" type="button" hidden>
                <span class="btn-label"><span class="wf-submit-label">Reserve my place</span></span>
                <span class="btn-icon">
                  <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
