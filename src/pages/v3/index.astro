---
// Design variation v3. The live home page is src/pages/index.astro; this one is a
// candidate redesign on its own stylesheet (src/styles/variants/v3.css) and is noindex.
//
// It follows lassie.ai: the floating glass nav pill, a full-height photograph whose
// window pulls its own corners in on scroll, a pinned carousel of panels rising over
// one another, six tiles parked on a scroll-scrubbed ellipse around one line of copy,
// square drawn illustrations, and a footer standing on a fixed panel.
//
// Copy is the client's: it matches the live page and is not rewritten here. Every label
// inside a figure is a phrase from copy already on this page. Photographs are
// placeholders until the renders land; the prompts are in docs/v3-art-brief.md.
import V3Layout from '../../layouts/variants/V3Layout.astro';

/**
 * PHOTOGRAPHY. Four slots, each `string | null`. A null slot renders its styled
 * placeholder instead, so renders can land one at a time without touching any
 * layout. Sizes, crops and the prompt for each are in docs/v3-art-brief.md.
 * The three process steps are drawn rather than photographed, so the brief's
 * step-01/02/03 prompts are unused unless that decision is reversed.
 */
const HERO_ART: string | null = '/images/v3/hero-cover.webp';        // 1671x940, 16:9
const QUAD_ART: (string | null)[] = [
  '/images/v3/quad-photo-a.webp',                                    // 1193x1312, 10:11
  '/images/v3/quad-photo-b.webp',
];
const CLOSING_ART: string | null = '/images/v3/closing-frame.webp';  // 1414x744, 1.9:1

/** The three process steps, in the pinned carousel. Captions alternate side. */
const STEPS = [
  {
    n: '01',
    title: 'Join through your advisor, firm or organization',
    body: 'Access Compound Health as a benefit through a relationship you already have. No cold starts. No separate onboarding.',
    side: 'left',
    art: 'step-01 · an introduction arriving from a firm',
  },
  {
    n: '02',
    title: 'Deep diagnostic intake',
    body: 'A comprehensive baseline: advanced bloodwork, imaging, genetic risk, cognitive and metabolic assessments. Not a wellness check. A full-picture biological audit by elite clinicians.',
    side: 'right',
    art: 'step-02 · the baseline being collected',
  },
  {
    n: '03',
    title: 'Personalized longevity plan',
    body: 'Your clinical team, chosen for this program, and a dedicated health concierge build and actively manage a protocol tailored to your data, goals, and lifestyle.',
    side: 'left',
    art: 'step-03 · a protocol under active management',
  },
];

/** The state marker a task row carries, and the spinner inside it.

    Three marks sit in one grid cell and the class on the wrapper picks one, so
    a state change is an opacity and never a reflow. The spokes are drawn
    rather than cut out of a conic gradient with two composited mask layers:
    this kit draws its figures, and eight lines on an opacity ramp, turned in
    eight steps, is the same spinner with nothing to support. The ramp is what
    is actually moving, since the spokes are 45deg apart and would land back on
    themselves every step. */
const SPOKES = Array.from({ length: 8 }, (_, i) =>
  `<line x1="12" y1="2.8" x2="12" y2="6.8" transform="rotate(${i * 45} 12 12)" opacity="${(0.28 + i * 0.103).toFixed(2)}"/>`
).join('');

const mark = (state: string) =>
  `<span class="fig-mark is-${state}" data-mark><span class="fig-mark-ring"></span><svg class="fig-mark-spin" viewBox="0 0 24 24" aria-hidden="true">${SPOKES}</svg><span class="fig-mark-done"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span></span>`;

const ICONS: Record<string, string> = {
  bank: '<path d="M4.2 20.8V5.4A2.4 2.4 0 0 1 6.6 3h6.6a2.4 2.4 0 0 1 2.4 2.4v15.4"/><path d="M15.6 10.2h2.4a2.4 2.4 0 0 1 2.4 2.4v8.2"/><path d="M3 20.8h18"/><path d="M8.2 7.4h3.4"/><path d="M8.2 11.4h3.4"/><path d="M8.2 15.4h3.4"/>',
  user: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="10" r="3"/><path d="M5.9 18.5a7.2 7.2 0 0 1 12.2 0"/>',
  org:  '<path d="M15.4 20.5v-1.8a3.7 3.7 0 0 0-3.7-3.7H6.2a3.7 3.7 0 0 0-3.7 3.7v1.8"/><circle cx="9" cy="7.6" r="3.6"/><path d="M21.5 20.5v-1.8a3.7 3.7 0 0 0-2.8-3.6"/><path d="M15.8 4.2a3.7 3.7 0 0 1 0 7.1"/>',
  vial: '<path d="M9 3h6"/><path d="M10 3v14.6a2 2 0 0 0 4 0V3"/><path d="M10 12.4h4"/>',
  grid: '<rect x="3.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.6"/>',
  file: '<path d="M14 2.8H7.5A2.5 2.5 0 0 0 5 5.3v13.4a2.5 2.5 0 0 0 2.5 2.5h9a2.5 2.5 0 0 0 2.5-2.5V7.8z"/><path d="M14 2.8v5h5"/><path d="M8.8 13.2h6.4"/><path d="M8.8 17h4"/>',
  wave: '<path d="M3 12h4l2.5-6.5 5 13L17 12h4"/>',
  leaf: '<path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7z"/><path d="M3.3 13h6.2l.5-1 2 4.5 2-7 1.5 3.5h5.3"/>',
  cal:  '<rect x="3.2" y="4.8" width="17.6" height="16" rx="2.2"/><path d="M3.2 9.6h17.6"/><path d="M8 2.8v4"/><path d="M16 2.8v4"/>',
  shield: '<path d="M12 2.8 19.3 5.9v5.4c0 4.4-3 8.2-7.3 9.9-4.3-1.7-7.3-5.5-7.3-9.9V5.9z"/><path d="m8.9 11.8 2.2 2.2 4-4.4"/>',
  pill: '<path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7z"/><path d="m8.5 8.5 7 7"/>',
  drop: '<path d="M12 2.8s6.2 6.1 6.2 10.4a6.2 6.2 0 0 1-12.4 0C5.8 8.9 12 2.8 12 2.8z"/>',
};
const ico = (k: string) => `<svg class="ico" viewBox="0 0 24 24" aria-hidden="true">${ICONS[k]}</svg>`;

/** The three panels are three different machines, which is the whole of the
    lesson from the reference: its own three are a rolling task queue, a
    notification that grows into a progress card and then into a counting
    total, and a chat that types a question and writes an answer back. Three
    copies of one card is what ours were, and it is what the client saw.

    They share the kit, never the shape: the same card, tile, marker, pill,
    label and value throughout, so the three read as one product doing three
    different things rather than as three designs.

      01  an introduction arrives      a notification that grows into a card
      02  the baseline is collected    the rolling queue
      03  the plan is assembled        parts that light up under a live head

    Every word is lifted verbatim from that step's own copy. The machine words
    are the only new vocabulary: "Up next", "Pending", "In progress", "just
    now", and the two status verbs on 03. */

/* ---- 01. an introduction arrives ------------------------------------------
   Not a list. A route: the party you already deal with at one end, Compound
   Health at the other, and the introduction travelling between them. 01 and 02
   were still reading as the same object because they had the same anatomy, a
   head over a stack of [marker][pill] rows, and only their motion differed. A
   different machine has to be a different shape standing still, which is what
   the reference's own three are. */
const PANEL_01 = `<div class="fig-panel" data-panel="01">
  <div class="fig-panel-stage">
    <div class="fig-card fig-arrive is-sent" data-arrive>
      <div class="fig-note-head">
        <span class="fig-tile">${ico('bank')}</span>
        <span class="fig-title">Join through your advisor</span>
        <span class="fig-val fig-note-when">just now</span>
      </div>

      <div class="fig-route">
        <span class="fig-node">
          <span class="fig-avatars">
            <span class="fig-avatar"></span><span class="fig-avatar"></span><span class="fig-avatar"></span>
          </span>
          <span class="fig-sub">firm or organization</span>
        </span>

        <span class="fig-wire"><span class="fig-wire-draw" data-wire></span></span>

        <span class="fig-node">
          <span class="fig-node-mark">${mark('done')}</span>
          <span class="fig-sub">Access Compound Health</span>
        </span>
      </div>

      <div class="fig-flags">
        <span class="fig-flag is-on" data-flag>${mark('done')}<span class="fig-label">No cold starts</span></span>
        <span class="fig-flag is-on" data-flag>${mark('done')}<span class="fig-label">No separate onboarding</span></span>
      </div>
    </div>
  </div>
</div>`;

/* ---- 02. the baseline is collected ---------------------------------------- */
const QUEUE = [
  { icon: 'vial', label: 'Advanced bloodwork', done: '2026-03-02' },
  { icon: 'grid', label: 'Imaging', done: '2026-03-04' },
  { icon: 'file', label: 'Genetic risk', done: '2026-03-11' },
  { icon: 'wave', label: 'Cognitive', done: '2026-03-18' },
  { icon: 'leaf', label: 'Metabolic', done: '2026-03-24' },
];
const SLOTS = ['done', 'wait', 'wait'];
const SLOT_TEXT = ['', 'Up next', 'Pending'];

const PANEL_02 = `<div class="fig-panel" data-panel="02">
  <div class="fig-panel-stage">
    <div class="fig-card fig-work">
      <div class="fig-head">
        <span class="fig-tile">${ico('vial')}</span>
        <span class="fig-title">Deep diagnostic intake</span>
      </div>
      <div class="fig-queue">
        <div class="fig-queue-roll" data-roll>
          ${QUEUE.map((it, i) => `<div class="fig-task" data-task data-done="${it.done}">
            ${mark(SLOTS[i] || 'wait')}
            <div class="fig-task-pill">
              ${ico(it.icon)}
              <span class="fig-label">${it.label}</span>
              <span class="fig-val" data-status>${i === 0 ? it.done : (SLOT_TEXT[i] || 'Pending')}</span>
            </div>
          </div>`).join('\n          ')}
        </div>
      </div>
    </div>
  </div>
</div>`;

/* ---- 03. the plan is assembled -------------------------------------------- */
const PARTS = ['your data', 'goals', 'lifestyle'];

const PANEL_03 = `<div class="fig-panel" data-panel="03">
  <div class="fig-panel-stage">
    <div class="fig-card fig-plan" data-plan>
      <div class="fig-plan-head">
        <span class="fig-tile">${ico('org')}</span>
        <div class="fig-plan-titles">
          <span class="fig-title">Personalized longevity plan</span>
          <span class="fig-sub">Your clinical team, chosen for this program</span>
        </div>
        <span class="fig-avatars">
          <span class="fig-avatar"></span><span class="fig-avatar"></span><span class="fig-avatar"></span>
        </span>
      </div>

      <span class="fig-sub">a protocol tailored to</span>
      <div class="fig-parts">
        ${PARTS.map((t, i) => `<span class="fig-part is-on" data-part="${i}">
          <span class="fig-part-tick">${mark('done')}</span>
          <span class="fig-label">${t}</span>
        </span>`).join('\n        ')}
      </div>

      <div class="fig-live is-live" data-live>
        <span class="fig-pulse"></span>
        <span class="fig-label">build and actively manage</span>
        <span class="fig-val" data-live-status
              data-off="a dedicated health concierge"
              data-on="Actively managed">Actively managed</span>
      </div>
    </div>
  </div>
</div>`;

const PANELS = [PANEL_01, PANEL_02, PANEL_03];

/** The three discipline squares, in the deck's card language but not in one
    shape. The first pass gave all three the same tile head over the same three
    [marker][pill] rows and they read as one card printed three times, which is
    the same mistake the deck's panels made and the same lesson: the family is
    carried by the card, the pill, the mark and the type, and the composition
    has to differ or nothing does.

    No head on any of them, either. The discipline's name is the h3 directly
    under the square, and repeating it inside was both duplication and a third
    identical element.

      clinical care     a team: three faces, the label under them, two chips
      diagnostics       a panel of three instruments, icon over label
      advanced          a condition, and the three therapies under it

    Every word is lifted verbatim from that discipline's own sentence. */
const tick = `<span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>`;

/** The three discipline screens. Static, by the client's decision of
    2026-09-11, and rebuilt the same day after a version that was called what
    it was: things thrown together. The fault was not the finish, it was the
    meaning. A marketing sentence has nouns and it has qualifying clauses, and
    the first build treated both as rows: "chosen for accuracy and usefulness"
    sat in a row with "3 of 3" and a three-band scale beside it, "continuous
    care between visits" had twelve weeks drawn under it with gaps in them,
    which says the opposite of continuous, the team carried the value "Named",
    and "imaging" was nested under "multi-cancer early detection", where it
    does not belong. None of those readings meant anything.

    The rule this now follows: the clause is the header, the nouns are the
    rows, and a row carries a value only where there is an honest one. No
    drawn reading that is not a reading of something. What makes the three
    differ is what they are, a team, a set of results, and a decision, and not
    decoration added to keep them apart. */
const DISC_BODY: Record<string, string> = {
  'clinical-care': `<div class="fig-card disc-card">
      <div class="disc-bar">
        <span class="fig-avatars">
          <span class="fig-avatar"></span><span class="fig-avatar"></span><span class="fig-avatar"></span>
        </span>
        <span class="fig-label disc-subject">physician-led teams</span>
        <span class="fig-val">Standard met</span>
      </div>

      <div class="disc-body">
        <div class="disc-row">
          ${ico('file')}
          <span class="fig-label">published outcomes</span>
          <span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
        </div>
        <div class="disc-row">
          ${ico('user')}
          <span class="fig-label">continuous care between visits</span>
          <span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
        </div>
      </div>
    </div>`,

  'diagnostics-and-screening': `<div class="fig-card disc-card">
      <div class="disc-bar">
        <span class="fig-tile">${ico('shield')}</span>
        <span class="fig-label disc-subject">chosen for accuracy and usefulness</span>
      </div>

      <div class="disc-body">
        <div class="disc-row">
          ${ico('vial')}
          <span class="fig-label">baseline testing</span>
          <span class="fig-val">2026-03-02</span>
          <span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
        </div>
        <div class="disc-row">
          ${ico('shield')}
          <span class="fig-label">multi-cancer early detection</span>
          <span class="fig-val">Clear</span>
          <span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
        </div>
        <div class="disc-row">
          ${ico('grid')}
          <span class="fig-label">imaging</span>
          <span class="fig-val">2026-03-04</span>
          <span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
        </div>
      </div>
    </div>`,

  'advanced-therapies': `<div class="fig-card disc-card">
      <div class="disc-bar">
        <span class="fig-tile">${ico('wave')}</span>
        <span class="fig-label disc-subject">only when your data indicates them</span>
      </div>

      <div class="disc-body">
        <div class="disc-row">
          ${ico('pill')}
          <span class="fig-label">hormones</span>
          <span class="fig-val">Indicated</span>
          <span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
        </div>
        <div class="disc-row">
          ${ico('drop')}
          <span class="fig-label">peptides</span>
          <span class="fig-val">Indicated</span>
          <span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
        </div>
        <div class="disc-row is-off">
          ${ico('leaf')}
          <span class="fig-label">regenerative therapies</span>
          <span class="fig-val">Not indicated</span>
          <span class="fig-dot"></span>
        </div>
      </div>

      <div class="disc-note">
        ${ico('shield')}
        <span class="fig-val">only through vetted sourcing</span>
      </div>
    </div>`,
};

const DISC = Object.fromEntries(Object.entries(DISC_BODY).map(([id, body]) =>
  [id, `<div class="disc is-bare" data-disc="${id}">
  <div class="disc-stage">
    ${body}
  </div>
</div>`]));
---

<V3Layout
  variant="v3"
  base="/v3"
  title="Compound Health | A private longevity membership, introduced through your advisor, firm or organization"
  description="A private longevity membership introduced through wealth advisors, employers, and executive networks. Diagnostics, continuous tracking, and personalized protocols from curated clinical partners. Your health data stays yours."
>

  <!-- ===================================================================
       HERO
       A full-height photograph. Once the reader moves, the window pulls in
       16px and rounds 24px (32/64 from 1280 up); the picture itself never
       moves. [data-nav-dark] is the sentinel that keeps the nav inverted
       for exactly as long as the pill is over the picture.
       =================================================================== -->
  <section class="hero" id="hero" data-nav-dark aria-label="Compound Health">
    <div class="hero-media" data-hero-media>
      {HERO_ART ? (
        <img src={HERO_ART} alt="" width="1671" height="940" fetchpriority="high" decoding="async" />
      ) : (
        <div class="ph is-dark">
          <span class="ph-label">
            <b>hero-cover</b>
            <span>2880&times;1620 &middot; 16:9 &middot; full bleed, no radius</span>
            <span>Tended ground at first light. Mid-dark centre, cold blue warming to low gold.</span>
          </span>
        </div>
      )}
    </div>

    <div class="hero-inner">
      <h1 class="t-display t-balance">Beyond wealth: <br class="br-wide" />the years to <em>enjoy&nbsp;it</em></h1>

      <p class="hero-sub t-body">
        A private longevity membership, introduced through the people who already advise you, your
        firm or your organization. Delivered by clinical partners chosen against one standard. Your
        data stays yours.
      </p>

    </div>

  </section>

  <!-- The partner invitation. Not in the hero any more: a small pill at the
       foot of the screen that arrives once the reader is past the picture,
       and stays dismissed for the rest of the session. -->
  <aside class="nudge" id="nudge" hidden>
    <a class="nudge-link" href="#partners">
      Introducing Compound Health to your clients, employees or members?
    </a>
    <button class="nudge-close" id="nudgeClose" type="button" aria-label="Dismiss">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </aside>

  <!-- ===================================================================
       THE INTRO
       The mark draws its own strokes, then one line. The reference plays a
       Lottie flower in this slot; ours is the Compound Health mark.
       =================================================================== -->
  <section class="intro wrap" aria-labelledby="processHead">
    <h2 class="t-h2 t-balance" id="processHead">A new model for<br />human <em>performance</em></h2>
    <p class="intro-sub t-body">
      We built the infrastructure that connects the people who advise you to world-class
      preventive care.
    </p>
  </section>

  <!-- ===================================================================
       HOW IT WORKS
       Three panels on one pinned stage, each rising over the one before it,
       scrubbed by scroll. The caption travels with its panel and alternates
       side. Below 1024px the caption sits under the panel.
       =================================================================== -->
  <section class="car" id="how" data-car aria-label="How it works">
    <div class="car-stage" data-car-stage>
      {STEPS.map((step, i) => (
        <article class:list={['car-panel', { 'is-right': step.side === 'right' }]} data-car-odd={i}>
          <div class="car-media" aria-hidden="true">
            <Fragment set:html={PANELS[i]} />
          </div>
          <div class="car-copy">
            <span class="car-n">{step.n}</span>
            <h3 class="t-h4">{step.title}</h3>
            <p class="t-body-sm">{step.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ===================================================================
       WHAT YOU GET
       The pinned ellipse. Six tiles are parked around the copy on a scroll
       scrubbed orbit: two photographs and four data cards. The first line
       leaves as the second arrives, which is the reference's own move.
       Below the pin, the two wide panels and the three cards.
       =================================================================== -->
  <section class="orbit" id="features" data-orbit aria-labelledby="featuresHead">
    <div class="orbit-stage" data-orbit-stage>

      <div class="orbit-copy">
        <div class="orbit-line">
          <h2 class="t-h2 t-balance" id="featuresHead" data-orbit-h1>
            Everything your health<br />has been <em>missing</em>
          </h2>
          <p class="orbit-line-2 t-h3 t-balance" data-orbit-h2>
            Compound Health is not a gym membership or a supplement subscription.
            It is a medical relationship, sustained and personalized.
          </p>
        </div>
      </div>

      <!-- The six. Their transforms are written by script from the scroll
           position, which is the one legitimate inline style in this file. -->
      <div class="orb" data-orb="0">
        <div class="orb-photo">
          {QUAD_ART[0] ? (
            <img src={QUAD_ART[0]} alt="" width="1193" height="1312" loading="lazy" decoding="async" />
          ) : (
            <div class="ph">
              <span class="ph-label">
                <b>quad-photo-a</b>
                <span>1000&times;1100 &middot; 10:11</span>
              </span>
            </div>
          )}
        </div>
      </div>
      <div class="orb" data-orb="1"><div class="orb-card" aria-hidden="true">
          <div class="dcard">
  <div class="dcard-head">
    <span class="ico-tile">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7z"/><path d="M3.3 13h6.2l.5-1 2 4.5 2-7 1.5 3.5h5.3"/></svg>
    </span>
    <span class="dcard-title">Healthspan score</span>
    <span class="dcard-val">72</span>
  </div>
  <div class="dcard-row">
    <span class="dcard-label">owned by the client</span>
    <span class="tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
  </div>
</div>
        </div></div>
      <div class="orb" data-orb="2"><div class="orb-card" aria-hidden="true">
          <div class="dcard is-tall">
  <div class="dcard-head">
    <span class="ico-tile">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l2.5-6.5 5 13L17 12h4"/></svg>
    </span>
    <span class="dcard-title">Full biomarker tracking</span>
