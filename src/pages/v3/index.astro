            <p class="wf-note t-body-sm">
              Your data is handled in accordance with our <a href="/privacy-policy">Privacy Policy</a>.
              We do not share your details with third parties.
            </p>
          </div>

          <div class="sf-panel waitlist-success" id="waitlistSuccess" role="status" aria-live="polite">
            <div class="ws-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><path d="M7.5 12.5l3 3 6-7"/>
              </svg>
            </div>
            <h3 class="t-h4" id="wsTitle">You're on the list</h3>
            <p class="t-body-sm" id="wsBody">
              Thank you. Your founding member request has been received.
              Our team will be in touch as soon as your tier opens.
            </p>
            <button class="ws-reset" id="wsReset" type="button">Submit another response</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================
       MOTION
       Three scrubbed set pieces (the hero window, the pinned carousel, the
       orbit) and four small behaviours. With reduced motion every scrub is
       skipped and the two pinned sections lay themselves out as plain
       stacks, which is what .is-static does.
       =================================================================== -->
  <script>
    (function () {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const g = (window as any).gsap;
      const ST = (window as any).ScrollTrigger;
      const canScrub = !!(g && ST) && !reduce;

      // --- the hero window -------------------------------------------------
      // clip-path from inset(0) to inset(32px round 64px). The picture never
      // moves; the window pulls in around it. Scrubbed over the first 40% of
      // the screen, so it closes under the reader's hand and is finished well
      // before the hero leaves. It was a class flipped at scrollY 100 driving
      // a 1s transition, which is the reference's own arrangement and the
      // reason it stuttered: see the note above .hero in v3.css.
      (function () {
        const hero = document.getElementById('hero');
        if (!hero) return;
        // Left alone it stays at the 0 declared in CSS, which is the open
        // state and what reduced motion should see.
        if (reduce) return;

        const RUN = 0.4;   // of a screen height
        const at = (p: number) => hero.style.setProperty('--hero-close', p.toFixed(4));

        if (canScrub) {
          // Through ScrollTrigger, like the other two set pieces, so the
          // window is written in the same frame Lenis moves the page rather
          // than a frame behind it off a native scroll event. 0.3 is the
          // carousel's catch-up; the orbit's is 0.4.
          const state = { p: 0 };
          g.to(state, {
            p: 1,
            ease: 'none',
            scrollTrigger: {
              trigger: hero,
              start: 'top top',
              end: () => `+=${Math.round(window.innerHeight * RUN)}`,
              scrub: 0.3,
              invalidateOnRefresh: true,
            },
            onUpdate: () => at(state.p),
          });
        } else {
          // No GSAP: read the scroll straight, over the same distance.
          let ticking = false;
          const update = () => {
            ticking = false;
            const run = window.innerHeight * RUN;
            at(Math.min(1, Math.max(0, window.scrollY / run)));
          };
          window.addEventListener('scroll', () => {
            if (!ticking) { ticking = true; requestAnimationFrame(update); }
          }, { passive: true });
          update();
        }
      })();

      // --- the partner pill --------------------------------------------------
      (function () {
        const el = document.getElementById('nudge');
        const close = document.getElementById('nudgeClose');
        if (!el) return;
        let dismissed = false;
        try { dismissed = sessionStorage.getItem('ch-v3-nudge') === 'off'; } catch (e) {}
        if (dismissed) return;
        el.hidden = false;
        const hero = document.getElementById('hero');
        const show = () => {
          const past = hero ? hero.getBoundingClientRect().bottom < window.innerHeight * 0.4 : true;
          el.classList.toggle('is-in', past);
        };
        window.addEventListener('scroll', show, { passive: true });
        show();
        const dismiss = () => {
          el.classList.remove('is-in');
          try { sessionStorage.setItem('ch-v3-nudge', 'off'); } catch (e) {}
          window.removeEventListener('scroll', show);
          window.setTimeout(() => { el.hidden = true; }, 400);
        };
        close?.addEventListener('click', dismiss);
        el.querySelector('.nudge-link')?.addEventListener('click', dismiss);
      })();

      // --- the pinned carousel ------------------------------------------------
      // A deck, measured off the reference's own. Three plates stand in a
      // stack: the front one at full size, the two behind it smaller and
      // pushed down so their rounded feet show below it. The front plate
      // leaves straight up at full size and the stack promotes, each plate
      // growing towards 1 and rising towards 0. Nothing fades; the queued
      // plates are fully opaque the whole time, and that is the difference
      // between a deck and a crossfade. Measured at 1440 on the reference:
      // scale 1 / 0.862 / 0.729 with the second and third pushed down 12.4%
      // and 23.6% of a plate's height.
      //
      // Only the plate stacks. The caption is not part of the deck and takes
      // its own crossfade, as it does there.
      (function () {
        const section = document.querySelector<HTMLElement>('[data-car]');
        const stage = document.querySelector<HTMLElement>('[data-car-stage]');
        const panels = Array.from(document.querySelectorAll<HTMLElement>('.car-panel'));
        if (!section || !stage || panels.length < 2) return;

        // There is no `.is-live` any more. It marked whichever plate was at
        // the front so that only that one's figure would run, and it was
        // computed on every frame of the scrub. The figures became independent
        // of scroll, nothing has read the class since, and a per-frame
        // calculation feeding a class nobody styles is work the handover
        // cannot afford.
        if (!canScrub) { section.classList.add('is-static'); return; }

        const copies = panels.map(p => p.querySelector<HTMLElement>('.car-copy'));
        const mm = g.matchMedia();

        mm.add('(max-width: 1279px)', () => {
          section.classList.add('is-static');
        });

        mm.add('(min-width: 1280px)', () => {
          section.classList.remove('is-static');
          // The first card is on top and the queued ones sit under it, which is
          // why the reference writes this deck backwards in the DOM. Only the
          // rounded edge of the next card shows below the one in front.
          panels.forEach((p, i) => { p.style.zIndex = String(panels.length - i); });
          const STACK_S = [1, 0.862, 0.729];
          const STACK_Y = [0, 12.4, 23.6];
          const medias = panels.map(p => p.querySelector<HTMLElement>('.car-media'));
          medias.forEach((m, i) => {
            if (m) g.set(m, { scale: STACK_S[Math.min(i, 2)], yPercent: STACK_Y[Math.min(i, 2)] });
          });
          g.set(panels, { opacity: 1, scale: 1, y: 0, yPercent: 0 });
          // The cloud arrives rather than merely appearing: it rises the last
          // 24px as it fades in and lifts away as it goes. The caption owns no
          // transform for layout any more (it is placed with `top`), so this
          // is free to be the only thing on it.
          g.set(copies.slice(1), { opacity: 0, y: 24 });
          g.set(copies[0], { y: 0 });

          const tl = g.timeline({
            defaults: { ease: 'none' },
            scrollTrigger: {
              trigger: section,
              start: 'center center',
              end: () => `+=${3.5 * window.innerHeight}`,
              pin: stage,
              scrub: 0.3,
              invalidateOnRefresh: true,
            },
          });

          // Each panel is held before it leaves. The first arrangement had the
          // front card starting to go at 8 per cent of the pin, about 180px of
          // scroll, so the first caption was gone before it could be read.
          //
          // A handover takes 2 units, not 1, and the pin grew from 2.4 screens
          // to 3.5 to pay for it, so the holds keep the same 305px of scroll
          // they had. Measured against the reference at 1440 with the same
          // probe on both: a plate there advances about 0.5px for every px of
          // scroll and ours advanced 1.00, which is twice the travel packed
          // into each frame (4.74px against 2.83px) and 70 per cent more jerk.
          // Neither deck drops a frame; ours was simply moving twice as fast.
          const HOLD = 0.9;
          const TRANS = 2;
          const STEP = TRANS + 0.9;
          const TOTAL = HOLD + (panels.length - 1) * STEP + TRANS + (HOLD - 0.3);
          for (let i = 1; i < panels.length; i++) {
            const at = HOLD + (i - 1) * STEP;
            // The scale finishes early and on its own tween. Opacity runs 0.3
            // to 1 over the whole transition and crosses 0.5 at progress
            // 0.286; a scale tween of 0.25 is done before that, so the plate
            // is never both legible and rasterised at a fraction.
            // The front plate leaves at full size, straight up, far enough to
            // clear the stage whatever the plate measures. Everything behind
            // it promotes one place in the stack on the same beat.
            // The plates are the one thing here that is not linear. Measured
            // off the reference at 1440: over its handover the travel runs
            // consistently ahead of the scroll, 0.41 of the way at a quarter
            // of the scroll and 0.72 at half, which is power2.out almost
            // exactly (0.4375 and 0.75). Ours was `ease: 'none'` like
            // everything else on the timeline, so a plate set off at full rate
            // and stopped dead on its mark. Nothing was dropping frames, both
            // decks hold 60fps; what was missing was the settle.
            const DECK = 'power2.out';
            tl.to(medias[i - 1], { yPercent: -190, duration: TRANS, ease: DECK }, at)
              .to(copies[i - 1], { opacity: 0, y: -24, duration: 0.35 }, at);
            for (let k = i; k < panels.length; k++) {
              const place = Math.min(k - i, 2);
              tl.to(medias[k], { scale: STACK_S[place], yPercent: STACK_Y[place], duration: TRANS, ease: DECK }, at);
            }
            tl.to(copies[i], { opacity: 1, y: 0, duration: 0.5 }, at + TRANS * 0.45);
          }
          tl.to({}, { duration: HOLD - 0.3 });

          // Crossing the breakpoint has to leave nothing behind: the timeline
          // and its pin go with it, and the inline state comes off.
          return () => {
            section.classList.add('is-static');
            g.set(panels, { clearProps: 'all' });
            g.set(copies, { clearProps: 'all' });
            g.set(medias.filter(Boolean), { clearProps: 'all' });
            panels.forEach(p => { p.style.zIndex = ''; });
          };
        });
      })();

      // --- the panels do their work ---------------------------------------------
      // A rolling queue, and it is the one thing on this page scroll does not
      // touch. It starts when the deck is anywhere in view and then loops on
      // its own clock, start to end, whichever plate happens to be at the
      // front; tying it to .is-live meant a panel reset every time the reader
      // moved, which is exactly what the reference does not do.
      //
      // Three rows are on the card and a fourth waits under the fold. The top
      // row runs, completes, takes the green, and then the roll steps up by one
      // row: the finished row leaves, the fourth arrives, and the row that left
      // goes to the end of the roll carrying the next item in the list. The
      // list is longer than the window, so the card is small and the work still
      // has somewhere to go.
      (function () {
        // Reduced motion keeps the authored state: the first row done, the
        // rest waiting, nothing moving.
        if (reduce) return;
        const RUN = 1250;   // a row is working
        const SETTLE = 620; // it holds the green before it goes
        const ARRIVE = 420; // after the roll has stepped, before the next runs

        const decks = Array.from(document.querySelectorAll<HTMLElement>('.fig-work'));
        if (!decks.length) return;

        decks.forEach(card => {
          const roll = card.querySelector<HTMLElement>('[data-roll]');
          if (!roll) return;
          // Four rows are the least this can run on: three in the window and
          // one under the fold to arrive.
          if (roll.children.length < 4) return;

          let timer = 0;
          let running = false;
          const after = (ms: number, fn: () => void) => { timer = window.setTimeout(fn, ms); };

          const rows = () => Array.from(roll.children) as HTMLElement[];
          const paint = (row: HTMLElement, state: string, text: string) => {
            const m = row.querySelector<HTMLElement>('[data-mark]');
            const v = row.querySelector<HTMLElement>('[data-status]');
            if (m) m.className = 'fig-mark is-' + state;
            if (v) v.textContent = text;
          };

          // A row that has left goes to the foot of the roll as it is. It
          // already carries its own icon, label and value, so it only has to
          // go back to waiting.
          const refill = (row: HTMLElement) => {
            row.classList.remove('is-flash', 'is-out');
            paint(row, 'wait', 'Pending');
          };

          const step = () => {
            if (!running) return;
            const r = rows();
            const head = r[0];
            paint(head, 'run', 'In progress…');
            // The two behind it say how far away they are, as the reference's
            // own rows do.
            if (r[1]) paint(r[1], 'wait', 'Up next');
            if (r[2]) paint(r[2], 'wait', 'Pending');

            after(RUN, () => {
              if (!running) return;
              paint(head, 'done', head.dataset.done || 'Done');
              head.classList.add('is-flash');

              after(SETTLE, () => {
                if (!running) return;
                head.classList.add('is-out');
                roll.classList.add('is-rolling');

                const done = () => {
                  roll.removeEventListener('transitionend', done);
                  // Put the roll back with the transition off and the finished
                  // row moved to the end. Reading offsetHeight between the two
                  // is what stops the browser coalescing them into no move at
                  // all.
                  roll.classList.remove('is-rolling');
                  roll.appendChild(head);
                  refill(head);
                  void roll.offsetHeight;
                  after(ARRIVE, step);
                };
                roll.addEventListener('transitionend', done, { once: true });
                // A transition that never fires must not stall the queue.
                after(900, () => { if (running && roll.classList.contains('is-rolling')) done(); });
              });
            });
          };

          const start = () => { if (running) return; running = true; step(); };
          const stop = () => { running = false; window.clearTimeout(timer); };

          const section = card.closest('.car') || card.closest('section');
          if (!section || !('IntersectionObserver' in window)) { start(); return; }
          new IntersectionObserver(entries => {
            entries.forEach(e => (e.isIntersecting ? start() : stop()));
          }, { rootMargin: '200px' }).observe(section);
        });
      })();

      // --- 01: the introduction arrives -----------------------------------------
      // The route draws, the far end takes it, and the two conditions under it
      // confirm in turn. Its own timer, started by the deck intersecting;
      // scroll never touches it.
      (function () {
        if (reduce) return;
        const OPEN = 900, DRAW = 950, TAKE = 520, FLAG = 460, HOLD = 2600, DARK = 800;

        document.querySelectorAll<HTMLElement>('[data-arrive]').forEach(card => {
          const wire = card.querySelector<HTMLElement>('[data-wire]');
          const target = card.querySelector<HTMLElement>('.fig-node-mark [data-mark]');
          const flags = Array.from(card.querySelectorAll<HTMLElement>('[data-flag]'));
          if (!wire || !target || !flags.length) return;

          let timer = 0;
          let running = false;
          const after = (ms: number, fn: () => void) => { timer = window.setTimeout(fn, ms); };
          const setMark = (el: HTMLElement | null, state: string) => {
            if (el) el.className = 'fig-mark is-' + state;
          };

          const dark = () => {
            card.classList.remove('is-sent');
            setMark(target, 'wait');
            flags.forEach(f => { f.classList.remove('is-on'); setMark(f.querySelector<HTMLElement>('[data-mark]'), 'wait'); });
          };

          const cycle = () => {
            if (!running) return;
            dark();
            after(OPEN, () => {
              if (!running) return;
              // The wire draws itself, which is the one entrance this
              // variation already allows, and the far end waits on it.
              card.classList.add('is-sent');
              setMark(target, 'run');
              after(DRAW, () => {
                if (!running) return;
                setMark(target, 'done');
                const flag = (i: number) => {
                  if (!running) return;
                  if (i >= flags.length) { after(HOLD, () => { dark(); after(DARK, cycle); }); return; }
                  flags[i].classList.add('is-on');
                  setMark(flags[i].querySelector<HTMLElement>('[data-mark]'), 'done');
                  after(FLAG, () => flag(i + 1));
                };
                after(TAKE, () => flag(0));
              });
            });
          };

          const start = () => { if (running) return; running = true; cycle(); };
          const stop = () => { running = false; window.clearTimeout(timer); };
          const section = card.closest('.car') || card.closest('section');
          if (!section || !('IntersectionObserver' in window)) { start(); return; }
          new IntersectionObserver(es => es.forEach(e => (e.isIntersecting ? start() : stop())),
            { rootMargin: '200px' }).observe(section);
        });
      })();

      // --- 03: the plan is assembled --------------------------------------------
      // Three parts light one at a time, the live line comes on under them, and
      // it holds before it goes dark and builds again. Nothing rolls and
      // nothing grows: the third machine moves by lighting, not by moving.
      (function () {
        if (reduce) return;
        const LIGHT = 820, SETTLE = 700, HOLD = 2600, DARK = 800;

        document.querySelectorAll<HTMLElement>('[data-plan]').forEach(plan => {
          const parts = Array.from(plan.querySelectorAll<HTMLElement>('[data-part]'));
          const live = plan.querySelector<HTMLElement>('[data-live]');
          const status = plan.querySelector<HTMLElement>('[data-live-status]');
          if (!parts.length || !live || !status) return;
          const OFF = status.dataset.off || '';
          const ON = status.dataset.on || '';
          let timer = 0;
          let running = false;
          const after = (ms: number, fn: () => void) => { timer = window.setTimeout(fn, ms); };
          const setMark = (el: HTMLElement, state: string) => {
            const m = el.querySelector<HTMLElement>('[data-mark]');
            if (m) m.className = 'fig-mark is-' + state;
          };

          const dark = () => {
            parts.forEach(p => { p.classList.remove('is-on'); setMark(p, 'wait'); });
            live.classList.remove('is-live');
            status.textContent = OFF;
          };

          const cycle = () => {
            if (!running) return;
            dark();
            const light = (i: number) => {
              if (!running) return;
              if (i >= parts.length) {
                after(SETTLE, () => {
                  if (!running) return;
                  live.classList.add('is-live');
                  status.textContent = ON;
                  after(HOLD, () => { dark(); after(DARK, cycle); });
                });
                return;
              }
              setMark(parts[i], 'run');
              after(LIGHT * 0.55, () => {
                if (!running) return;
                parts[i].classList.add('is-on');
                setMark(parts[i], 'done');
                after(LIGHT * 0.45, () => light(i + 1));
              });
            };
            after(LIGHT, () => light(0));
          };

          const start = () => { if (running) return; running = true; cycle(); };
          const stop = () => { running = false; window.clearTimeout(timer); };
          const section = plan.closest('.car') || plan.closest('section');
          if (!section || !('IntersectionObserver' in window)) { start(); return; }
          new IntersectionObserver(es => es.forEach(e => (e.isIntersecting ? start() : stop())),
            { rootMargin: '200px' }).observe(section);
        });
      })();

      // --- the orbit ------------------------------------------------------------
      // Six tiles parked on an ellipse whose polar angle is scrubbed by scroll,
      // around a line that leaves as the next one arrives.
      (function () {
        const section = document.querySelector<HTMLElement>('[data-orbit]');
        const stage = document.querySelector<HTMLElement>('[data-orbit-stage]');
        const orbs = Array.from(document.querySelectorAll<HTMLElement>('[data-orb]'));
        const copy = document.querySelector<HTMLElement>('.orbit-copy');
        const h1 = document.querySelector<HTMLElement>('[data-orbit-h1]');
        const h2 = document.querySelector<HTMLElement>('[data-orbit-h2]');
        if (!section || !stage || !orbs.length) return;
        if (!canScrub) { section.classList.add('is-static'); return; }

        // Each tile sweeps from its first angle to its second. The narrow set
        // keeps them on screen when the ellipse is small.
        const WIDE = [[-174, -74], [-120, -74], [-125, 35], [5, 105], [95, 195], [30, 105]];
        const NARROW = [[-154, -84], [-120, -74], [-25, 35], [110, 130], [180, 205], [100, 120]];
        const OFFSETS = [[0, 0], [-80, 10], [-25, -60], [-50, 40], [25, -60], [50, -100]];

        function place(p: number) {
          const w = window.innerWidth;
          const narrow = w < 700;
          const mid = w >= 700 && w < 1280;
          const half = w / 2;
          // The stage's own height, not the window's: it is the thing that
          // clips, and 100svh is not innerHeight on every browser.
          const halfH = stage.offsetHeight / 2;
          const copyBox = copy ? copy.getBoundingClientRect() : null;

          // On a phone the ring cannot clear the line: a 300px headline in a
          // 390px window leaves no horizontal room for a tile beside it. So
          // there the objects give the middle back and take the bands above
          // and below, measured off the copy itself rather than guessed, and
          // still rise with the scroll. Above 700 the ellipse returns.
          if (narrow && copyBox) {
            // The second line is absolutely positioned over the first and is
            // the taller of the two; the band has to clear whichever is
            // showing, or the tiles close in on the longer one.
            const h2box = h2 ? h2.getBoundingClientRect().height : 0;
            const halfH = Math.max(copyBox.height, h2box + 56) / 2;
            const gap = 28;
            const scale = 0.46;
            const BANDS = [[0, 1, 2], [3, 4, 5]];
            const STACK = [0, -132, -48, 36, 98, 10];
            // The lanes are computed from the tiles' real widths rather than
            // set by hand: three cards of four different sizes cannot be
            // packed across 390px by guessing at fractions, and when they were
            // they printed over each other.
            BANDS.forEach((band, b) => {
              const widths = band.map(i => orbs[i].offsetWidth * scale);
              const total = widths.reduce((a, v) => a + v, 0);
              // Three tiles barely fit across 390. Whatever will not fit hangs
              // off the left, where the first tile of each band is a
              // photograph: a picture may be cropped by the edge, a card
              // cut through the middle of a word only looks like a mistake.
              const minGap = 10;
              const inner = w - 16;
              const over = Math.max(0, total + minGap * 2 - inner);
              const slack = Math.max(minGap, (inner + over - total) / (band.length - 1));
              let cursor = -w / 2 + 8 - over;
              band.forEach((i, k) => {
                const el = orbs[i];
                const ow = widths[k];
                const oh = el.offsetHeight * scale;
                const cx = cursor + ow / 2;
                cursor += ow + slack;
                const above = b === 0;
                const cy = (above ? -(halfH + gap) - oh / 2 : halfH + gap + oh / 2)
                  + STACK[i] + (1 - p) * 70;
                const x = cx - el.offsetWidth / 2;
                const y = cy - el.offsetHeight / 2;
                el.style.transform = `translate(${x}px, ${y}px) scale(${Math.min(1, 2 * p) * scale})`;
                const inner = el.querySelector<HTMLElement>('.orb-photo .ph, .orb-photo img');
                if (inner) inner.style.setProperty('--counter', String(2 - Math.min(1, p)));
              });
            });
            return;
          }

          const set = w < 1024 ? NARROW : WIDE;
          const rx = (mid ? 0.36 : 0.37) * w;
          const ry = (mid ? 0.34 : 0.32) * window.innerHeight;
          const k = mid ? 0.6 : 1;
          const scale = mid ? 0.78 : 1;
          // The bar is a fixed object at the top of the window; the orbit has
          // to clear it, so the whole composition sits below centre.
          const bias = 62;

          orbs.forEach((el, i) => {
            const [a0, a1] = set[i % set.length];
            const ang = a0 + (a1 - a0) * p;
            const rad = ((ang - 60) * Math.PI) / 180;
            const ow = el.offsetWidth * scale;
            const oh = el.offsetHeight * scale;
            let x = Math.cos(rad) * rx - el.offsetWidth / 2 + OFFSETS[i][0] * k;
            let y = Math.sin(rad) * ry - el.offsetHeight / 2 + OFFSETS[i][1] * k + bias;

            // Nothing is cut by a border: the sweep takes a card through
            // cos = 1, and without this it would be sliced there.
            const lo = -half - (el.offsetWidth - ow) / 2 + 16;
            const hi = half - ow - (el.offsetWidth - ow) / 2 - 16;
            x = Math.max(lo, Math.min(hi, x));

            // The same on the block axis, and for the same reason. The ellipse
            // takes its vertical radius from the window while a tile keeps its
            // size, so below about 880px of window the lowest photograph of the
            // sweep reached past the foot of the stage, and the stage is the
            // element that clips: the picture lost its two bottom corners to a
            // straight edge. Measured, not guessed: 41px of it were gone at a
            // 700px window and 14 at 800.
            const up = -halfH - (el.offsetHeight - oh) / 2 + 16;
            const dn = halfH - oh - (el.offsetHeight - oh) / 2 - 16;
            y = Math.max(up, Math.min(dn, y));

            el.style.transform = `translate(${x}px, ${y}px) scale(${Math.min(1, 2 * p) * scale})`;
            const inner = el.querySelector<HTMLElement>('.orb-photo .ph, .orb-photo img');
            if (inner) inner.style.setProperty('--counter', String(2 - Math.min(1, p)));
          });
        }
        place(0);
        window.addEventListener('resize', () => place(lastP), { passive: true });
        let lastP = 0;

        const tl = g.timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            trigger: section,
            start: 'center center',
            end: () => `+=${2.2 * window.innerHeight}`,
            pin: stage,
            scrub: 0.4,
            invalidateOnRefresh: true,
            onUpdate: (self: any) => { lastP = self.progress; place(self.progress); },
          },
        });
        if (h1 && h2) {
          // The first line arrives, is held, hands over, and the second gets a
          // comparable stretch to itself rather than only the last fifth.
          tl.fromTo(h1, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.7 }, 0)
            .to({}, { duration: 1.5 })
            .to(h1, { opacity: 0, y: -40, duration: 0.6 })
            // Five hundredths of overlap: enough that the two lines cross at
            // about 0.04 each, which is under the threshold at which this
            // near-black type is legible on this cream, and not so much that
            // they are both readable on the way past. Strict sequencing left
            // a window with neither line on screen, and that window varied
            // with the viewport, which is worse than either.
            .fromTo(h2, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.6 }, '>-0.05')
            .to({}, { duration: 1.5 });
        }
      })();

    })();
  </script>

  <!-- Custom dropdowns. Each select.wf-select is wrapped and given a button and a
       listbox; the native select stays as the value the form script reads. Without
       JavaScript the native select is what the reader sees. -->
  <script>
    (function () {
      const CHEV = '<svg class="wf-dd-chev" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      const TICK = '<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3.2 3L13 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';

      document.querySelectorAll<HTMLSelectElement>('select.wf-select').forEach((sel, n) => {
        const label = sel.id ? document.querySelector<HTMLLabelElement>(`label[for="${sel.id}"]`) : null;
        const wrap = document.createElement('div');
        wrap.className = 'wf-dd';
        sel.parentNode?.insertBefore(wrap, sel);
        wrap.appendChild(sel);
        sel.tabIndex = -1;
        sel.setAttribute('aria-hidden', 'true');

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'wf-dd-btn';
        btn.id = `${sel.id || 'wf-dd-' + n}-btn`;
        btn.setAttribute('aria-haspopup', 'listbox');
        btn.setAttribute('aria-expanded', 'false');
        const text = document.createElement('span');
        text.id = `${btn.id}-value`;
        btn.appendChild(text);
        // The name is the label plus the current value, not the label alone:
        // aria-label would replace the button's contents and the chosen tier
        // would be nowhere in the accessibility tree, which also breaks
        // WCAG 2.5.3, since the visible word must be in the name.
        if (label) {
          label.id = label.id || `${btn.id}-label`;
          label.htmlFor = btn.id;
          btn.setAttribute('aria-labelledby', `${label.id} ${text.id}`);
        }
        btn.insertAdjacentHTML('beforeend', CHEV);

        const list = document.createElement('ul');
        list.className = 'wf-dd-list';
        list.setAttribute('role', 'listbox');
        list.id = `${btn.id}-list`;
        btn.setAttribute('aria-controls', list.id);

        const opts = Array.from(sel.options).filter(o => !o.disabled);
        const items = opts.map(o => {
          const li = document.createElement('li');
          li.className = 'wf-dd-opt';
          li.setAttribute('role', 'option');
          li.id = `${btn.id}-opt-${opts.indexOf(o)}`;
          li.dataset.value = o.value;
          li.innerHTML = `<span>${o.textContent}</span>${TICK}`;
          li.addEventListener('click', () => { choose(o.value); close(); btn.focus(); });
          list.appendChild(li);
          return li;
        });
        wrap.appendChild(btn);
        wrap.appendChild(list);

        const placeholder = sel.options[0]?.disabled ? sel.options[0].textContent || '' : '';
        let focus = -1;

        function render() {
          const cur = sel.value;
          const selected = opts.find(o => o.value === cur && cur !== '');
          text.textContent = selected ? (selected.textContent || '') : placeholder;
          btn.classList.toggle('is-empty', !selected);
          items.forEach(li => li.setAttribute('aria-selected', String(li.dataset.value === cur && cur !== '')));
        }
        function choose(value: string) {
          sel.value = value;
          sel.dispatchEvent(new Event('change', { bubbles: true }));
          render();
        }
        function open() {
          list.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          focus = Math.max(0, opts.findIndex(o => o.value === sel.value));
          paint();
        }
        function close() {
          list.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
          focus = -1;
          paint();
        }
        function paint() {
          items.forEach((li, i) => li.classList.toggle('is-focus', i === focus));
          // Without this the arrow keys move a highlight nobody can hear.
          if (focus >= 0) btn.setAttribute('aria-activedescendant', items[focus].id);
          else btn.removeAttribute('aria-activedescendant');
        }

        btn.addEventListener('click', () => (list.classList.contains('is-open') ? close() : open()));
        btn.addEventListener('keydown', e => {
          const last = items.length - 1;
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === 'Enter' || e.key === ' ') {
            if (!list.classList.contains('is-open')) { e.preventDefault(); open(); return; }
          }
          if (!list.classList.contains('is-open')) return;
          if (e.key === 'ArrowDown') { e.preventDefault(); focus = focus >= last ? 0 : focus + 1; paint(); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); focus = focus <= 0 ? last : focus - 1; paint(); }
          else if (e.key === 'Home') { e.preventDefault(); focus = 0; paint(); }
          else if (e.key === 'End') { e.preventDefault(); focus = last; paint(); }
          else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); if (focus >= 0) { choose(opts[focus].value); close(); } }
          else if (e.key === 'Escape') { e.preventDefault(); close(); }
          else if (e.key === 'Tab') close();
        });
        document.addEventListener('click', e => { if (!wrap.contains(e.target as Node)) close(); });
        sel.addEventListener('change', render);
        render();
      });
    })();
  </script>

  <!-- The waitlist form. Endpoint, routing and validation are the live form's. -->
  <script>
    const WAITLIST_ENDPOINT =
      'https://script.google.com/macros/s/AKfycbw9x1Q9dVIDbTRRnsgajzbXHrL2Y3mz7SSWO2qHGtDeK9XsrxKhtBpItlPaY3oDn28/exec';

    const ROUTING_TAG: Record<string, string> = {
      client: 'client-waitlist',
      partner: 'partner-pipeline',
    };

    const waitlistForm = document.getElementById('waitlistForm') as HTMLDivElement | null;
    const waitlistSuccess = document.getElementById('waitlistSuccess') as HTMLDivElement | null;
    const wfSubmit = document.getElementById('wfSubmit') as HTMLButtonElement | null;
    const wfError = document.getElementById('wfError') as HTMLDivElement | null;
    const wfErrorMsg = wfError?.querySelector('.wf-error-msg') as HTMLSpanElement | null;
    const wfLabel = wfSubmit?.querySelector('.wf-submit-label') as HTMLSpanElement | null;
    const wfRole = document.getElementById('wfRole') as HTMLDivElement | null;
    const wsTitle = document.getElementById('wsTitle') as HTMLHeadingElement | null;
    const wsBody = document.getElementById('wsBody') as HTMLParagraphElement | null;
    const wsReset = document.getElementById('wsReset') as HTMLButtonElement | null;
    const ORIGINAL_LABEL = wfLabel?.textContent ?? 'Reserve my place';

    const segments = Array.from(wfRole?.querySelectorAll<HTMLButtonElement>('.wf-segment') ?? []);

    function currentAudience(): string {
      const active = segments.find(s => s.classList.contains('is-active'));
      return active?.dataset.audience ?? 'client';
    }
    function currentRole(): string {
      const active = segments.find(s => s.classList.contains('is-active'));
      return active?.dataset.role ?? 'client';
    }
    function showError(message: string) {
      if (!wfError) return;
      if (wfErrorMsg) wfErrorMsg.textContent = message;
      wfError.classList.add('visible');
    }
    function clearError() { wfError?.classList.remove('visible'); }

    function applyAudience(audience: string) {
      document.querySelectorAll<HTMLElement>('[data-shown-to]').forEach(field => {
        field.hidden = field.dataset.shownTo !== audience;
      });
    }

    function selectRole(role: string, focus = false) {
      const target =
        segments.find(s => s.dataset.role === role) ??
        (role === 'partner' ? segments.find(s => s.dataset.audience === 'partner') : undefined);
      if (!target) return;
      segments.forEach(s => {
        const isActive = s === target;
        s.classList.toggle('is-active', isActive);
        s.setAttribute('aria-checked', String(isActive));
        // Roving tabindex: a radiogroup is one stop in the tab order and the
        // arrows move inside it.
        s.tabIndex = isActive ? 0 : -1;
      });
      if (focus) target.focus();
      applyAudience(target.dataset.audience ?? 'client');
      clearError();
    }

    segments.forEach((segment, i) => {
      segment.tabIndex = segment.classList.contains('is-active') ? 0 : -1;
      segment.addEventListener('click', () => selectRole(segment.dataset.role ?? 'client'));
      segment.addEventListener('keydown', e => {
        const last = segments.length - 1;
        let next = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = i === last ? 0 : i + 1;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = i === 0 ? last : i - 1;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = last;
        if (next < 0) return;
        e.preventDefault();
        selectRole(segments[next].dataset.role ?? 'client', true);
      });
    });

    document.addEventListener('click', event => {
      const trigger = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-wf-role]');
      if (trigger) selectRole(trigger.dataset.wfRole ?? 'partner');
    });

    applyAudience(currentAudience());

    if (wfSubmit && waitlistForm && waitlistSuccess) {
      wfSubmit.addEventListener('click', async () => {
        clearError();
        const fnameInput = document.getElementById('wf-fname') as HTMLInputElement | null;
        const lnameInput = document.getElementById('wf-lname') as HTMLInputElement | null;
        const emailInput = document.getElementById('wf-email') as HTMLInputElement | null;
        const tierInput = document.getElementById('wf-tier') as HTMLSelectElement | null;
        const advisorInput = document.getElementById('wf-advisor') as HTMLInputElement | null;
        const orgInput = document.getElementById('wf-org') as HTMLInputElement | null;
        const reachInput = document.getElementById('wf-reach') as HTMLSelectElement | null;

        const audience = currentAudience();
        const isPartner = audience === 'partner';

        const firstName = fnameInput?.value.trim() ?? '';
        const lastName = lnameInput?.value.trim() ?? '';
        const email = emailInput?.value.trim() ?? '';
        const tier = tierInput?.value ?? '';
        const advisor = advisorInput?.value.trim() ?? '';
        const org = orgInput?.value.trim() ?? '';
        const reach = reachInput?.value ?? '';

        if (!firstName) { fnameInput?.focus(); return; }
        if (!lastName) { lnameInput?.focus(); return; }
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { emailInput?.focus(); return; }
        if (isPartner) { if (!org) { orgInput?.focus(); return; } }
        else if (!tier) { tierInput?.focus(); return; }

        wfSubmit.disabled = true;
        if (wfLabel) wfLabel.textContent = 'Submitting…';

        const payload = new URLSearchParams({
          role: currentRole(),
          audience,
          routingTag: ROUTING_TAG[audience] ?? ROUTING_TAG.client,
          firstName,
          lastName,
          email,
          tier: isPartner ? '' : tier,
          advisor: isPartner ? '' : advisor,
          organization: isPartner ? org : '',
          reach: isPartner ? reach : '',
          source: 'compoundhealth.io',
          submittedAt: new Date().toISOString(),
          userAgent: navigator.userAgent,
        });

        try {
          const res = await fetch(WAITLIST_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
            body: payload.toString(),
          });
          if (!res.ok) throw new Error('Request failed: ' + res.status);

          if (isPartner) {
            if (wsTitle) wsTitle.textContent = 'Request received';
            if (wsBody) {
              wsBody.textContent =
                'Thank you. We will be in touch to discuss a program for your organization.';
            }
          } else {
            if (wsTitle) wsTitle.textContent ="You're on the list";
            if (wsBody) {
              wsBody.textContent =
                'Thank you' + (firstName ? ', ' + firstName : '') +
                '. Your founding member request has been received. Our team will be in ' +
                'touch as soon as your tier opens.';
            }
          }

          waitlistForm.style.display = 'none';
          waitlistSuccess.classList.add('visible');
          waitlistSuccess.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch (err) {
          console.error('Waitlist submission failed', err);
          wfSubmit.disabled = false;
          if (wfLabel) wfLabel.textContent = ORIGINAL_LABEL;
          showError("We couldn't submit your details. Please check your connection and try again.");
        }
      });
    }

    if (wsReset && waitlistForm && waitlistSuccess && wfSubmit) {
      wsReset.addEventListener('click', () => {
        ['wf-fname', 'wf-lname', 'wf-email', 'wf-advisor', 'wf-org'].forEach(id => {
          const el = document.getElementById(id) as HTMLInputElement | null;
          if (el) el.value = '';
        });
        ['wf-tier', 'wf-reach'].forEach(id => {
          const el = document.getElementById(id) as HTMLSelectElement | null;
          if (el) { el.value = ''; el.dispatchEvent(new Event('change')); }
        });
        selectRole('client');
        waitlistSuccess.classList.remove('visible');
        waitlistForm.style.display = '';
        wfSubmit.disabled = false;
        if (wfLabel) wfLabel.textContent = ORIGINAL_LABEL;
        clearError();
      });
    }
  </script>


  <!-- The step controller. It owns the sequencing only: every value, the
       audience routing, the validation that matters and the submission stay in
       the script above, which is the live form's. Additive by design, so the
       form still works as one long form if this never runs. -->
  <script>
    (function () {
      const panelWindow = document.getElementById('sfWindow') as HTMLElement | null;
      const steps = Array.from(document.querySelectorAll<HTMLElement>('.sf-step'));
      const countEl = document.getElementById('sfCount') as HTMLElement | null;
      const barEl = document.getElementById('sfBar') as HTMLElement | null;
      const backBtn = document.getElementById('sfBack') as HTMLButtonElement | null;
      const nextBtn = document.getElementById('sfNext') as HTMLButtonElement | null;
      const skipBtn = document.getElementById('sfSkip') as HTMLButtonElement | null;
      const submitBtn = document.getElementById('wfSubmit') as HTMLButtonElement | null;
      const errorBox = document.getElementById('wfError') as HTMLElement | null;
      const errorMsg = errorBox?.querySelector('.wf-error-msg') as HTMLElement | null;
      const resetBtn = document.getElementById('wsReset') as HTMLButtonElement | null;
      if (!panelWindow || !steps.length || !nextBtn || !submitBtn || !backBtn || !skipBtn) return;

      const LAST = steps.length - 1;
      let at = 0;

      panelWindow.classList.add('is-stepped');

      // The visible half of a step: steps four and five each hold a client
      // field and a partner field, and applyAudience() in the form script
      // hides the one that does not apply.
      function liveFields(step: HTMLElement) {
        return Array.from(step.querySelectorAll<HTMLElement>('.wf-field')).filter(f => !f.hidden);
      }
      function firstControl(step: HTMLElement) {
        const scope = liveFields(step)[0] ?? step;
        return scope.querySelector<HTMLElement>(
          '.wf-dd-btn, input.wf-input, .wf-segment.is-active, .wf-segment'
        );
      }

      // The window's height is written here because the steps are stacked in
      // one place, so nothing else can know it.
      function measure() {
        panelWindow.style.height = steps[at].offsetHeight + 'px';
      }

      function showError(message: string) {
        if (!errorBox) return;
        if (errorMsg) errorMsg.textContent = message;
        errorBox.classList.add('visible');
      }
      function clearError() { errorBox?.classList.remove('visible'); }

      // What has to be true before the reader can leave a step. The submit
      // script checks all of it again on the way out, which is what actually
      // guards the payload; this is here so the reader is told at the question
      // rather than four steps later.
      function blocking(index: number): { el: HTMLElement | null; message: string } | null {
        const step = steps[index];
        const value = (id: string) =>
          (document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null)?.value.trim() ?? '';
        const el = (id: string) => document.getElementById(id) as HTMLElement | null;

        if (index === 1) {
          if (!value('wf-fname')) return { el: el('wf-fname'), message: 'Please enter your first name.' };
          if (!value('wf-lname')) return { el: el('wf-lname'), message: 'Please enter your last name.' };
          return null;
        }
        if (index === 2) {
          const email = value('wf-email');
          if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            return { el: el('wf-email'), message: 'Please enter an email address we can reach you on.' };
          }
          return null;
        }
        if (index === 3) {
          const live = liveFields(step)[0];
          if (!live) return null;
          const control = live.querySelector<HTMLInputElement | HTMLSelectElement>('input, select');
          if (control && !control.value.trim()) {
            const isSelect = control.tagName === 'SELECT';
            const focusable =
              (live.querySelector('.wf-dd-btn') as HTMLElement | null) ?? (control as HTMLElement);
            return {
              el: focusable,
              message: isSelect ? 'Please choose a tier.' : 'Please enter your organization name.',
            };
          }
        }
        return null;
      }

      function go(index: number, focus = true) {
        at = Math.max(0, Math.min(LAST, index));
        steps.forEach((step, i) => step.classList.toggle('is-active', i === at));
        if (countEl) countEl.textContent = `Step ${at + 1} of ${steps.length}`;
        // The bar's width is the step number, which is the one kind of inline
        // value this system allows: a position that comes from data.
        if (barEl) barEl.style.width = `${((at + 1) / steps.length) * 100}%`;
        backBtn.hidden = at === 0;
        skipBtn.hidden = at !== LAST;
        nextBtn.hidden = at === LAST;
        submitBtn.hidden = at !== LAST;
        clearError();
        measure();
        if (focus) firstControl(steps[at])?.focus({ preventScroll: true });
      }

      function advance() {
        const stop = blocking(at);
        if (stop) {
          showError(stop.message);
          stop.el?.focus({ preventScroll: true });
          return;
        }
        go(at + 1);
      }

      nextBtn.addEventListener('click', advance);
      backBtn.addEventListener('click', () => go(at - 1));

      // Skip is the optional step's own way past it: it clears whatever is in
      // the field and submits, which is what the reader means by skipping.
      skipBtn.addEventListener('click', () => {
        const live = liveFields(steps[LAST])[0];
        const control = live?.querySelector<HTMLInputElement | HTMLSelectElement>('input, select');
        if (control) {
          control.value = '';
          control.dispatchEvent(new Event('change'));
        }
        submitBtn.click();
      });

      // Enter carries the reader forward, as it would in a one-field form.
      // The listbox has its own Enter and keeps it.
      panelWindow.addEventListener('keydown', event => {
        if (event.key !== 'Enter') return;
        const target = event.target as HTMLElement | null;
        if (target?.closest('.wf-dd')) return;
        event.preventDefault();
        if (at === LAST) submitBtn.click();
        else advance();
      });

      // Changing the answer to "I am" swaps the fields on steps four and five,
      // so the window is remeasured on the frame after the swap.
      document.addEventListener('click', event => {
        const segment = (event.target as HTMLElement | null)?.closest('.wf-segment');
        if (segment) requestAnimationFrame(measure);
      });

      resetBtn?.addEventListener('click', () => go(0, false));
      window.addEventListener('resize', measure, { passive: true });
      if ('fonts' in document) (document as any).fonts.ready.then(measure);

      go(0, false);
      requestAnimationFrame(measure);
    })();
  </script>

</V3Layout>
