---
// Design variation v3. The live home page is src/pages/index.astro; this one is a
// candidate redesign on its own stylesheet (src/styles/variants/v3.css) and is noindex.
//
// It follows lassie.ai: the floating glass nav pill, a full-height photograph whose
// window pulls its own corners in on scroll, a pinned carousel of panels rising over
// one another, six tiles parked on a scroll-scrubbed ellipse around a counting figure,
// square drawn illustrations, an accordion, and a footer standing on a fixed panel.
//
// Copy is the client's: it matches the live page and is not rewritten here. Every label
// inside a figure is a phrase from copy already on this page. Photographs are
// placeholders until the renders land; the prompts are in docs/v3-art-brief.md.
import V3Layout from '../../layouts/variants/V3Layout.astro';

/**
 * PHOTOGRAPHY. Four slots, each `string | null`. A null slot renders its styled
 * placeholder instead, so renders can land one at a time without touching any
 * layout. Sizes, crops and the prompt for each are in docs/v3-art-brief.md.
 * The three process steps are drawn rather than photographed, so the brief's
 * step-01/02/03 prompts are unused unless that decision is reversed.
 */
const HERO_ART: string | null = null;                       // 2880x1620, 16:9
const QUAD_ART: (string | null)[] = [null, null];           // 1000x1100, 10:11
const CLOSING_ART: string | null = null;                    // 2752x1448, 1.9:1

/** The hero ticker: one promise at a time, each one a phrase from the page. */
const TICKER = [
  { label: 'A dashboard for your body', icon: 'grid' },
  { label: 'Full biomarker tracking', icon: 'pulse' },
  { label: 'Personalized protocols', icon: 'doc' },
  { label: 'Curated clinical delivery', icon: 'shield' },
  { label: 'Health concierge', icon: 'user' },
  { label: 'Healthspan score, owned by the client', icon: 'check' },
];

/** The three process steps, in the pinned carousel. Captions alternate side. */
const STEPS = [
  {
    n: '01',
    title: 'Join through your advisor, firm or organization',
    body: 'Access Compound Health as a benefit through a relationship you already have. No cold starts. No separate onboarding.',
    side: 'left',
    art: 'step-01 · an introduction arriving from a firm',
  },
  {
    n: '02',
    title: 'Deep diagnostic intake',
    body: 'A comprehensive baseline: advanced bloodwork, imaging, genetic risk, cognitive and metabolic assessments. Not a wellness check. A full-picture biological audit by elite clinicians.',
    side: 'right',
    art: 'step-02 · the baseline being collected',
  },
  {
    n: '03',
    title: 'Personalized longevity plan',
    body: 'Your clinical team, chosen for this program, and a dedicated health concierge build and actively manage a protocol tailored to your data, goals, and lifestyle.',
    side: 'left',
    art: 'step-03 · a protocol under active management',
  },
];

/** The three drawn interface panels, one per step. Raw markup so the loop
    above stays readable; the drawings themselves are in the stylesheet. */
const PANELS = [
  `<div class="fig-panel" data-panel="01">
  <div class="fig-panel-stage fig-panel-split">

    <div class="fig-card fig-panel-a">
      <div class="fig-head">
        <span class="fig-tile">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.2 20.8V5.4A2.4 2.4 0 0 1 6.6 3h6.6a2.4 2.4 0 0 1 2.4 2.4v15.4"/><path d="M15.6 10.2h2.4a2.4 2.4 0 0 1 2.4 2.4v8.2"/><path d="M3 20.8h18"/><path d="M8.2 7.4h3.4"/><path d="M8.2 11.4h3.4"/><path d="M8.2 15.4h3.4"/></svg>
        </span>
        <span class="fig-title">your advisor, firm or organization</span>
      </div>

      <div class="fig-row is-inset">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="10" r="3"/><path d="M5.9 18.5a7.2 7.2 0 0 1 12.2 0"/></svg>
        <span class="fig-label">Advisor</span>
        <span class="fig-val">2026-04-09</span>
        <span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
      </div>

      <div class="fig-row is-inset">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.2 20.8V5.4A2.4 2.4 0 0 1 6.6 3h6.6a2.4 2.4 0 0 1 2.4 2.4v15.4"/><path d="M15.6 10.2h2.4a2.4 2.4 0 0 1 2.4 2.4v8.2"/><path d="M3 20.8h18"/><path d="M8.2 7.4h3.4"/><path d="M8.2 11.4h3.4"/><path d="M8.2 15.4h3.4"/></svg>
        <span class="fig-label">Firm</span>
        <span class="fig-dot"></span>
      </div>

      <div class="fig-row is-inset">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M15.4 20.5v-1.8a3.7 3.7 0 0 0-3.7-3.7H6.2a3.7 3.7 0 0 0-3.7 3.7v1.8"/><circle cx="9" cy="7.6" r="3.6"/><path d="M21.5 20.5v-1.8a3.7 3.7 0 0 0-2.8-3.6"/><path d="M15.8 4.2a3.7 3.7 0 0 1 0 7.1"/></svg>
        <span class="fig-label">Organization</span>
        <span class="fig-dot"></span>
      </div>
    </div>

    <div class="fig-link">
      <span class="fig-link-line"></span>
      <span class="fig-chip">No separate onboarding</span>
      <span class="fig-link-line"></span>
    </div>

    <div class="fig-card fig-panel-b">
      <div class="fig-head">
        <span class="fig-title">Access Compound Health</span>
        <span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
      </div>
      <div class="fig-row is-inset">
        <span class="fig-label">as a benefit</span>
        <span class="fig-val">2026-04-09</span>
      </div>
      <div class="fig-row is-inset">
        <span class="fig-label">No cold starts</span>
        <span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
      </div>
    </div>

  </div>
</div>`,
  `<div class="fig-panel" data-panel="02">
  <div class="fig-panel-stage is-dense">

    <div class="fig-card fig-panel-single">
      <div class="fig-head">
        <span class="fig-tile">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6"/><path d="M10 3v14.6a2 2 0 0 0 4 0V3"/><path d="M10 12.4h4"/></svg>
        </span>
        <span class="fig-title">Deep diagnostic intake</span>
        <span class="fig-val">4/5</span>
      </div>

      <div class="fig-row is-inset">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6"/><path d="M10 3v14.6a2 2 0 0 0 4 0V3"/><path d="M10 12.4h4"/></svg>
        <span class="fig-label">Advanced bloodwork</span>
        <span class="fig-val">2026-03-02</span>
        <span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
      </div>

      <div class="fig-row is-inset">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.6"/></svg>
        <span class="fig-label">Imaging</span>
        <span class="fig-val">2026-03-04</span>
        <span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
      </div>

      <div class="fig-row is-inset">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2.8H7.5A2.5 2.5 0 0 0 5 5.3v13.4a2.5 2.5 0 0 0 2.5 2.5h9a2.5 2.5 0 0 0 2.5-2.5V7.8z"/><path d="M14 2.8v5h5"/><path d="M8.8 13.2h6.4"/><path d="M8.8 17h4"/></svg>
        <span class="fig-label">Genetic risk</span>
        <span class="fig-val">2026-03-11</span>
        <span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
      </div>

      <div class="fig-row is-inset">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l2.5-6.5 5 13L17 12h4"/></svg>
        <span class="fig-label">Cognitive</span>
        <span class="fig-val">2026-03-18</span>
        <span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
      </div>

      <div class="fig-row is-inset">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7z"/><path d="M3.3 13h6.2l.5-1 2 4.5 2-7 1.5 3.5h5.3"/></svg>
        <span class="fig-label">Metabolic</span>
        <span class="fig-dot"></span>
      </div>
    </div>

    <div class="fig-link">
      <span class="fig-chip">A comprehensive baseline</span>
    </div>

  </div>
</div>`,
  `<div class="fig-panel" data-panel="03">
  <div class="fig-panel-stage">

    <div class="fig-card fig-panel-single">
      <div class="fig-head">
        <span class="fig-tile">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M15.4 20.5v-1.8a3.7 3.7 0 0 0-3.7-3.7H6.2a3.7 3.7 0 0 0-3.7 3.7v1.8"/><circle cx="9" cy="7.6" r="3.6"/><path d="M21.5 20.5v-1.8a3.7 3.7 0 0 0-2.8-3.6"/><path d="M15.8 4.2a3.7 3.7 0 0 1 0 7.1"/></svg>
        </span>
        <span class="fig-title">Personalized longevity plan</span>
        <span class="fig-val">2026-04-09</span>
      </div>

      <div class="fig-cols">

        <div class="fig-col">
          <span class="fig-sub">Your clinical team</span>
          <div class="fig-row is-inset">
            <span class="fig-avatars">
              <span class="fig-avatar"></span><span class="fig-avatar"></span><span class="fig-avatar"></span>
            </span>
            <span class="fig-label">chosen for this program</span>
          </div>
          <div class="fig-row is-inset">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="10" r="3"/><path d="M5.9 18.5a7.2 7.2 0 0 1 12.2 0"/></svg>
            <span class="fig-label">a dedicated health concierge</span>
            <span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
          </div>
        </div>

        <div class="fig-col">
          <span class="fig-sub">a protocol tailored to</span>
          <div class="fig-row is-inset">
            <span class="fig-label">your data</span>
            <span class="fig-bars">
              <span class="fig-bar" style="--h:38%"></span>
              <span class="fig-bar" style="--h:64%"></span>
              <span class="fig-bar is-good" style="--h:92%"></span>
              <span class="fig-bar" style="--h:52%"></span>
              <span class="fig-bar" style="--h:74%"></span>
            </span>
          </div>
          <div class="fig-row is-inset">
            <span class="fig-label">goals</span>
            <span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
          </div>
          <div class="fig-row is-inset">
            <span class="fig-label">lifestyle</span>
            <span class="fig-tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
          </div>
        </div>

      </div>

      <div class="fig-link">
        <span class="fig-chip">actively manage</span>
      </div>
    </div>

  </div>
</div>`,
];
---

<V3Layout
  variant="v3"
  base="/v3"
  title="Compound Health | A private longevity membership, introduced through your advisor, firm or organization"
  description="A private longevity membership introduced through wealth advisors, employers, and executive networks. Diagnostics, continuous tracking, and personalized protocols from curated clinical partners. Your health data stays yours."
>

  <!-- ===================================================================
       HERO
       A full-height photograph. Once the reader moves, the window pulls in
       16px and rounds 24px (32/64 from 1280 up); the picture itself never
       moves. [data-nav-dark] is the sentinel that keeps the nav inverted
       for exactly as long as the pill is over the picture.
       =================================================================== -->
  <section class="hero" id="hero" data-nav-dark aria-label="Compound Health">
    <div class="hero-media" data-hero-media>
      {HERO_ART ? (
        <img src={HERO_ART} alt="" width="2880" height="1620" fetchpriority="high" decoding="async" />
      ) : (
        <div class="ph is-dark">
          <span class="ph-label">
            <b>hero-cover</b>
            <span>2880&times;1620 &middot; 16:9 &middot; full bleed, no radius</span>
            <span>Tended ground at first light. Mid-dark centre, cold blue warming to low gold.</span>
          </span>
        </div>
      )}
    </div>

    <div class="hero-inner">
      <h1 class="t-display t-balance">Beyond wealth: <br class="br-wide" />the years to <em>enjoy&nbsp;it</em></h1>

      <p class="hero-sub t-body">
        A private longevity membership, introduced through the people who already advise you, your
        firm or your organization. Delivered by clinical partners chosen against one standard. Your
        data stays yours.
      </p>

      <div class="hero-ticker" data-ticker aria-live="polite">
        {TICKER.map(item => (
          <div class="hero-ticker-item t-body" data-ticker-item>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={{
              grid:  '<path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"/>',
              pulse: '<path d="M3 12h4l2-6 4 12 2-6h6"/>',
              doc:   '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5M9 13h6M9 17h4"/>',
              shield:'<path d="M12 3l7 3v6c0 4.4-3 7.7-7 9-4-1.3-7-4.6-7-9V6z"/><path d="M9 12l2 2 4-4"/>',
              user:  '<path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM5 20a7 7 0 0 1 14 0"/>',
              check: '<path d="M4 12.5l5 5L20 6"/>',
            }[item.icon]} />
            <span>{item.label}</span>
          </div>
        ))}
      </div>

      <p class="hero-note t-body-sm">
        <a href="#partners">Introducing Compound Health to your clients, employees or members?</a>
      </p>
    </div>

    <!-- The inline capture, at the foot of the picture. It does not post from
         here: it carries the address down to the real form, which is the one
         place a submission happens. -->
    <form class="hero-form" data-handoff novalidate>
      <label class="u-sr-only" for="heroEmail">Email address</label>
      <div class="field-glass">
        <input id="heroEmail" data-handoff-email type="email" placeholder="Your email address" autocomplete="email" />
        <button class="btn btn-primary" type="submit">
          <span class="btn-label">Get access</span>
          <span class="btn-icon">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </button>
      </div>
    </form>
  </section>

  <!-- ===================================================================
       THE INTRO
       The mark draws its own strokes, then one line. The reference plays a
       Lottie flower in this slot; ours is the Compound Health mark.
       =================================================================== -->
  <section class="intro wrap" aria-labelledby="processHead">
    <svg class="intro-mark" viewBox="0 0 120 120" fill="none" aria-hidden="true" data-draw>
      <path
        d="M65.88 13.31L65.88 56.6L103.38 78.25M77.65 16.38L77.65 49.81L106.6 66.53M97.49 88.44L60 66.79L22.51 88.44M88.96 97.1L60 80.38L31.04 97.1M16.62 78.25L54.12 56.6L54.12 13.31M13.4 66.53L42.35 49.81L42.35 16.38"
        stroke="currentColor"
        stroke-width="5.88"
        stroke-linejoin="round"
      />
    </svg>
    <h2 class="t-h2 t-balance" id="processHead">A new model for<br />human <em>performance</em></h2>
    <p class="intro-sub t-body">
      We built the infrastructure that connects the people who advise you to world-class
      preventive care.
    </p>
  </section>

  <!-- ===================================================================
       HOW IT WORKS
       Three panels on one pinned stage, each rising over the one before it,
       scrubbed by scroll. The caption travels with its panel and alternates
       side. Below 1024px the caption sits under the panel.
       =================================================================== -->
  <section class="car" id="how" data-car aria-label="How it works">
    <div class="car-stage" data-car-stage>
      {STEPS.map((step, i) => (
        <article class:list={['car-panel', { 'is-right': step.side === 'right' }]} data-car-odd={i}>
          <div class="car-media" aria-hidden="true">
            <Fragment set:html={PANELS[i]} />
          </div>
          <div class="car-copy">
            <span class="car-n">{step.n}</span>
            <h3 class="t-h4">{step.title}</h3>
            <p class="t-body-sm">{step.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ===================================================================
       WHAT YOU GET
       The pinned ellipse. Six tiles are parked around the copy on a scroll
       scrubbed orbit: two photographs and four data cards. The first line
       leaves as the second arrives, which is the reference's own move.
       Below the pin, the two wide panels and the three cards.
       =================================================================== -->
  <section class="orbit" id="features" data-orbit aria-labelledby="featuresHead">
    <div class="orbit-stage" data-orbit-stage>

      <div class="orbit-copy">
        <span class="sec-label" data-orbit-tag>What you get</span>
        <div class="orbit-line">
          <h2 class="t-h2 t-balance" id="featuresHead" data-orbit-h1>
            Everything your health<br />has been <em>missing</em>
          </h2>
          <p class="orbit-line-2 t-h3 t-balance" data-orbit-h2>
            Compound Health is not a gym membership or a supplement subscription.
            It is a medical relationship, sustained and personalized.
          </p>
        </div>
      </div>

      <canvas class="trail" data-trail aria-hidden="true"></canvas>

      <!-- The six. Their transforms are written by script from the scroll
           position, which is the one legitimate inline style in this file. -->
      <div class="orb" data-orb="0">
        <div class="orb-photo">
          {QUAD_ART[0] ? (
            <img src={QUAD_ART[0]} alt="" width="1000" height="1100" loading="lazy" decoding="async" />
          ) : (
            <div class="ph">
              <span class="ph-label">
                <b>quad-photo-a</b>
                <span>1000&times;1100 &middot; 10:11</span>
              </span>
            </div>
          )}
        </div>
      </div>
      <div class="orb" data-orb="1"><div class="orb-card" aria-hidden="true">
          <div class="dcard">
  <div class="dcard-head">
    <span class="ico-tile">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7z"/><path d="M3.3 13h6.2l.5-1 2 4.5 2-7 1.5 3.5h5.3"/></svg>
    </span>
    <span class="dcard-title">Healthspan score</span>
    <span class="dcard-val">72</span>
  </div>
  <div class="dcard-row">
    <span class="dcard-label">owned by the client</span>
    <span class="tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg></span>
  </div>
</div>
        </div></div>
      <div class="orb" data-orb="2"><div class="orb-card" aria-hidden="true">
          <div class="dcard is-tall">
  <div class="dcard-head">
    <span class="ico-tile">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l2.5-6.5 5 13L17 12h4"/></svg>
    </span>
    <span class="dcard-title">Full biomarker tracking</span>
  </div>
  <div class="dcard-plot">
    <span class="dcard-bar" style="--h:34%"></span>
    <span class="dcard-bar" style="--h:52%"></span>
    <span class="dcard-bar" style="--h:44%"></span>
    <span class="dcard-bar" style="--h:70%"></span>
    <span class="dcard-bar is-good" style="--h:100%"></span>
    <span class="dcard-bar" style="--h:62%"></span>
    <span class="dcard-bar" style="--h:78%"></span>
  </div>
  <div class="dcard-figure">
    148
    <span class="dcard-meta">2026-04-09</span>
  </div>
</div>
        </div></div>
      <div class="orb" data-orb="3">
        <div class="orb-photo">
          {QUAD_ART[1] ? (
            <img src={QUAD_ART[1]} alt="" width="1000" height="1100" loading="lazy" decoding="async" />
          ) : (
            <div class="ph">
              <span class="ph-label">
                <b>quad-photo-b</b>
                <span>1000&times;1100 &middot; 10:11</span>
              </span>
            </div>
          )}
        </div>
      </div>
      <div class="orb" data-orb="4"><div class="orb-card" aria-hidden="true">
          <div class="dcard is-short">
  <div class="dcard-head">
    <span class="ico-tile">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2.8H7.5A2.5 2.5 0 0 0 5 5.3v13.4a2.5 2.5 0 0 0 2.5 2.5h9a2.5 2.5 0 0 0 2.5-2.5V7.8z"/><path d="M14 2.8v5h5"/><path d="M8.8 13.2h6.4"/><path d="M8.8 17h4"/></svg>
    </span>
    <span class="dcard-title">Personalized protocols</span>
    <span class="dcard-val">12</span>
  </div>
</div>
        </div></div>
      <div class="orb" data-orb="5"><div class="orb-card" aria-hidden="true">
          <div class="dcard is-wide">
