---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="For Advisory Firms | Compound Health"
  description="A private longevity program your firm can run inside its practice. Your brand on the experience, our clinical team underneath, and no clinical liability on your firm. Partnership model, economics, compliance, and onboarding for RIAs, family offices, and private bank advisory teams."
  noindex={true}
>

  <!-- DRAFT NOTICE -->
  <div class="adv-draft">
    Working draft for partner discussions. Commercial and compliance details marked
    [TO CONFIRM] are pending sign-off and must be verified before this page is shared.
  </div>

  <!-- HERO -->
  <section class="deck-hero">
    <div class="hero-blob"></div>
    <div class="eyebrow"><div class="eyebrow-dot"></div>For advisory firms · Private &amp; Confidential</div>
    <h1>A longevity program<br />you run inside <em>your practice</em></h1>
    <p class="hero-sub">
      Compound Health gives RIAs, family offices, and private bank advisory teams a credible,
      ongoing way to bring preventive longevity care to their clients. Your brand on the
      experience. Our clinical team underneath. No clinical liability on your firm.
    </p>
    <div class="deck-meta">
      <div class="deck-meta-item"><span class="dm-label">Prepared for</span><span class="dm-val">Advisory firms</span></div>
      <div class="deck-meta-div"></div>
      <div class="deck-meta-item"><span class="dm-label">Status</span><span class="dm-val">Private &amp; Confidential</span></div>
    </div>
  </section>

  <!-- CONTENTS BAR -->
  <div class="credbar">
    <span class="cred-label">What's covered</span>
    <div class="cred-item"><span class="cred-num">01</span><span class="cred-text">Partnership model</span></div>
    <div class="cred-divider"></div>
    <div class="cred-item"><span class="cred-num">02</span><span class="cred-text">Economics</span></div>
    <div class="cred-divider"></div>
    <div class="cred-item"><span class="cred-num">03</span><span class="cred-text">License &amp; liability</span></div>
    <div class="cred-divider"></div>
    <div class="cred-item"><span class="cred-num">04</span><span class="cred-text">Compliance &amp; HIPAA</span></div>
    <div class="cred-divider"></div>
    <div class="cred-item"><span class="cred-num">05</span><span class="cred-text">Data &amp; visibility</span></div>
    <div class="cred-divider"></div>
    <div class="cred-item"><span class="cred-num">06</span><span class="cred-text">Onboarding</span></div>
  </div>

  <!-- 01 — PARTNERSHIP MODEL -->
  <section class="features" id="model">
    <div class="inner">
      <p class="s-label">01 — Partnership model</p>
      <h2 class="s-title">Distributed<br />through your firm</h2>
      <p class="s-sub">
        Your name on every touchpoint. Compound Health operates underneath. No clinical liability
        on your firm, no operational lift on your advisors.
      </p>
      <div class="feat-grid feat-grid-3">
        <div class="feat">
          <div class="feat-icon">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 7h16M4 7l1.5-2.5h13L20 7M5 7v12.5h14V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M9.5 11h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="feat-title">We brand it</div>
          <p>
            Co-branded or fully white-labeled. Your name on the app, the dashboard, the report, and
            every member touchpoint. The clinical team, technology, and diagnostics network operate
            underneath. In the client's mind, the relationship is with your firm.
          </p>
        </div>
        <div class="feat">
          <div class="feat-icon">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 17h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M5 17a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M12 7V5M10.5 5h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="feat-title">You introduce it</div>
          <p>
            Offered to your top-tier households by invitation, as value beyond the portfolio. A
            thirty-minute introductory call sets up the baseline. No clinical liability, no
            operational lift. The introduction is the work.
          </p>
        </div>
        <div class="feat">
          <div class="feat-icon">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M12 3.5v2.2M12 18.3v2.2M3.5 12h2.2M18.3 12h2.2M6 6l1.6 1.6M16.4 16.4 18 18M18 6l-1.6 1.6M7.6 16.4 6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="feat-title">We operate it</div>
          <p>
            Virtual physician and care-team access nationwide, with local provider coordination for
            in-person diagnostics. The Day 1 baseline, the quarterly cadence, the full clinical
            operation: all handled by Compound Health.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 — ECONOMICS -->
  <section class="plans" id="economics">
    <div class="inner">
      <p class="s-label">02 — Economics</p>
      <h2 class="s-title">Member tiers and<br />partnership economics</h2>
      <p class="plans-lead">Every member starts at Baseline. The Baseline fee is credited toward year one.</p>
      <div class="plans-grid">
        <div class="plan">
          <div class="plan-name">Baseline</div>
          <div class="plan-price"><span class="plan-price-amount">$3,500</span><span class="plan-price-period">one-time</span></div>
          <p class="plan-price-note">Where every member starts. Credited toward year one.</p>
          <ul class="plan-features">
            <li>Single Day 1 workup: advanced and standard bloods</li>
            <li>DEXA, VO2 max with training zones, resting metabolic rate</li>
            <li>Body composition and strength</li>
            <li>Written longevity plan, delivered by an MD</li>
          </ul>
        </div>
        <div class="plan featured">
          <div class="plan-badge">Most members join</div>
          <div class="plan-name">Optimize</div>
          <div class="plan-price"><span class="plan-price-amount">$15,000</span><span class="plan-price-period">/ year</span></div>
          <p class="plan-price-note">MD-led and coach-supported, year round.</p>
          <ul class="plan-features">
            <li>Day 1 and Day 180 reviews, quarterly check-ins</li>
            <li>Monthly coaching</li>
            <li>Multi-cancer early detection on the bloods</li>
            <li>Hormones, peptides, NAD, and IV therapy at member pricing</li>
          </ul>
        </div>
        <div class="plan">
          <div class="plan-name">Eternal</div>
          <div class="plan-price"><span class="plan-price-amount">$65,000</span><span class="plan-price-period">/ year</span></div>
          <p class="plan-price-note">The full stack, always on.</p>
          <ul class="plan-features">
            <li>Annual Executive Physical: 500+ biomarkers</li>
            <li>Multi-cancer detection, whole-body and brain imaging, genetics</li>
            <li>Unlimited same-day messaging with a five-person concierge care team</li>
            <li>Quarterly re-testing included</li>
          </ul>
        </div>
      </div>
      <p class="adv-body">
        Partnership economics are built around volume, tier mix, and exclusivity.
        <span class="adv-todo">[TO CONFIRM: the firm-side commercial structure (revenue share or referral economics), any
        minimum cohort commitment, and exclusivity terms by region or channel.]</span>
      </p>
    </div>
  </section>

  <!-- 03 — LICENSE & LIABILITY -->
  <section class="how" id="liability">
    <div class="inner">
      <p class="s-label">03 — Medical license and clinical liability</p>
      <h2 class="s-title">The clinical risk<br />sits with us, not you</h2>
      <p class="s-sub">
        Your firm makes the introduction. It holds no medical license, no clinical liability, and
        no malpractice exposure.
      </p>
      <div class="steps">
        <div class="step">
          <div class="step-title">Who holds the license</div>
          <p>
            Care is delivered by the contracted medical group, which holds the medical license and
            employs or contracts the treating clinicians.
            <span class="adv-todo">[TO CONFIRM: legal name of the medical group / professional corporation and the states in which it is licensed.]</span>
          </p>
        </div>
        <div class="step">
          <div class="step-title">Who carries liability</div>
          <p>
            Clinical liability and malpractice coverage sit with the medical group and Compound
            Health, not with your firm or its advisors.
            <span class="adv-todo">[TO CONFIRM: malpractice carrier and coverage limits, and confirmation in writing that the firm carries no clinical liability.]</span>
          </p>
        </div>
        <div class="step">
          <div class="step-title">What your firm provides</div>
          <p>
            The introduction, and a named relationship owner. Nothing clinical is asked of the firm
            or its advisors at any point.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 — COMPLIANCE & HIPAA -->
  <section class="features" id="compliance">
    <div class="inner">
      <p class="s-label">04 — Compliance and HIPAA posture</p>
      <h2 class="s-title">Built for a<br />regulated channel</h2>
      <p class="s-sub">
        Health data is handled under HIPAA, and partner-facing materials are built to sit
        comfortably inside an SEC-regulated practice.
      </p>
      <div class="feat-grid feat-grid-3">
        <div class="feat">
          <div class="feat-title">HIPAA</div>
          <p>
            Protected health information is handled under HIPAA throughout.
            <span class="adv-todo">[TO CONFIRM: covered-entity vs business-associate structure, whether a BAA is required with the firm, and where PHI is stored and processed.]</span>
          </p>
        </div>
        <div class="feat">
          <div class="feat-title">SEC marketing rule</div>
          <p>
            Any material the firm distributes must satisfy the SEC marketing rule. We supply
            compliant, co-brandable templates so advisors are not drafting from scratch.
            <span class="adv-todo">[TO CONFIRM with the firm's compliance team and Compound Health counsel.]</span>
          </p>
        </div>
        <div class="feat">
          <div class="feat-title">Data security</div>
          <p>
            Encryption in transit and at rest, role-based access, and audit logging.
            <span class="adv-todo">[TO CONFIRM: hosting region, encryption standards, access controls, and any third-party security attestations such as SOC 2.]</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 — DATA ARCHITECTURE & VISIBILITY -->
  <section class="how" id="data">
    <div class="inner">
      <p class="s-label">05 — Data architecture and visibility</p>
      <h2 class="s-title">The client owns<br />the data</h2>
      <p class="s-sub">
        The member owns and controls their health data. By default, the firm and the advisor see no
        clinical data. The client decides what, if anything, to share.
      </p>
      <div class="steps">
        <div class="step">
          <div class="step-title">What the advisor sees</div>
          <p>
            Nothing clinical, unless the client elects to share it. Advisors are not given access to
            diagnostics, biomarkers, or the member's health record.
            <span class="adv-todo">[TO CONFIRM: whether a client-consented, opt-in summary such as a single healthspan score can be surfaced to the advisor, and through which system.]</span>
          </p>
        </div>
        <div class="step">
          <div class="step-title">What the firm sees</div>
          <p>
            Program-level reporting only: enrollment, tier mix, and engagement in aggregate. No
            individual health data.
            <span class="adv-todo">[TO CONFIRM: exact fields in firm-level reporting and the cadence at which it is delivered.]</span>
          </p>
        </div>
        <div class="step">
          <div class="step-title">Where the data lives</div>
          <p>
            Member health data is held inside the Compound Health clinical platform, separate from
            anything the firm operates.
            <span class="adv-todo">[TO CONFIRM: platform and hosting detail, data residency, retention, and deletion policy.]</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 — ONBOARDING -->
  <section class="how" id="onboarding" style="background:var(--cream);border-top:1px solid var(--border);">
    <div class="inner">
      <p class="s-label">06 — How the firm onboards</p>
      <h2 class="s-title">What we ask<br />of the firm</h2>
      <p class="s-sub">
        Light on your side, fully operated on ours. The introduction is the work.
      </p>
      <div class="steps">
        <div class="step">
          <div class="step-n">01</div>
          <div class="step-title">A partnership call</div>
          <p>
            A thirty-minute call to agree on branding, the target households, and the commercial
            terms. We prepare the co-branded assets.
          </p>
        </div>
        <div class="step">
          <div class="step-n">02</div>
          <div class="step-title">Invitations to top households</div>
          <p>
            The firm selects the households to invite and makes the introduction. We handle member
            onboarding, the Day 1 baseline, and everything clinical from there.
          </p>
        </div>
        <div class="step">
          <div class="step-n">03</div>
          <div class="step-title">An ongoing cadence</div>
          <p>
            Members move into the quarterly clinical cadence. The firm receives program-level
            reporting and a named point of contact.
            <span class="adv-todo">[TO CONFIRM: go-live timeline, any minimum cohort size, and the named relationship owner on each side.]</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CLOSING -->
  <div class="footer-cta">
    <h2>A credible program,<br />run inside <em>your practice</em></h2>
    <p>From a first educational session to an ongoing program. To discuss a partnership, reach us directly.</p>
    <a href="mailto:hello@compoundhealth.io" class="btn-white">hello@compoundhealth.io</a>
  </div>

  <style>
    /* Page-scoped chrome for the advisor draft. Reuses deck hero/quote tokens from global.css. */
    .adv-draft {
      background: var(--charcoal); color: var(--warm-white); font-size: 13px; line-height: 1.6;
      text-align: center; padding: 14px 24px; letter-spacing: 0.01em;
    }
    .deck-hero {
      min-height: 80vh; display: flex; flex-direction: column; align-items: center;
      justify-content: center; text-align: center; padding: 140px 48px 100px;
      background: var(--cream); position: relative; overflow: hidden;
    }
    .deck-hero h1 {
      font-family: 'Playfair Display', serif; font-size: clamp(44px, 6.4vw, 86px);
      font-weight: 400; line-height: 1.05; letter-spacing: -2.5px; color: var(--charcoal);
      max-width: 920px; margin-bottom: 28px; position: relative; z-index: 1;
    }
    .deck-hero h1 em { font-style: italic; color: var(--sage); }
    .deck-hero .hero-sub {
      font-size: 20px; font-weight: 300; color: var(--mid); max-width: 620px;
      line-height: 1.7; margin-bottom: 48px; position: relative; z-index: 1;
    }
    .deck-meta { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; justify-content: center; position: relative; z-index: 1; }
    .deck-meta-item { display: flex; flex-direction: column; gap: 4px; text-align: center; }
    .dm-label { font-size: 10px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mid); }
    .dm-val { font-size: 14px; font-weight: 500; color: var(--charcoal); }
    .deck-meta-div { width: 1px; height: 28px; background: var(--border); }

    .feat-grid-3 { grid-template-columns: repeat(3, 1fr) !important; }
    .feat-grid-3 .feat { background: var(--charcoal); }

    .adv-body { margin-top: 32px; font-size: 15px; line-height: 1.7; color: var(--mid); max-width: 760px; }
    .adv-todo { color: var(--gold); font-style: italic; }
    #liability .adv-todo, #data .adv-todo, #onboarding .adv-todo { display: inline-block; margin-top: 6px; }

    @media (max-width: 900px) {
      .deck-hero { padding: 120px 24px 80px; min-height: 76vh; }
      .deck-meta { gap: 18px; }
      .deck-meta-div { display: none; }
      .feat-grid-3 { grid-template-columns: 1fr !important; }
    }
  </style>

</MainLayout>
