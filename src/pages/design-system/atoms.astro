---
import DesignSystemLayout from '../../layouts/DesignSystemLayout.astro';

const swatches = [
  { name: 'Sage',         token: '--sage',         hex: '#2D5016', text: '#fff' },
  { name: 'Sage mid',     token: '--sage-mid',     hex: '#3D6B1F', text: '#fff' },
  { name: 'Sage light',   token: '--sage-light',   hex: '#4A7A25', text: '#fff' },
  { name: 'Sage pale',    token: '--sage-pale',    hex: '#EAF2E0', text: '#2D5016' },
  { name: 'Cream',        token: '--cream',        hex: '#F7F4EF', text: '#1C1C1A' },
  { name: 'Warm white',   token: '--warm-white',   hex: '#FEFCFA', text: '#1C1C1A' },
  { name: 'Charcoal',     token: '--charcoal',     hex: '#1C1C1A', text: '#fff' },
  { name: 'Mid',          token: '--mid',          hex: '#6B6B65', text: '#fff' },
  { name: 'Gold',         token: '--gold',         hex: '#B8862A', text: '#fff' },
  { name: 'Gold bg',      token: '--gold-bg',      hex: '#F5EDD5', text: '#B8862A' },
];

const spacing = [
  { name: 'space-2',  px: '8px',   bar: '8px'   },
  { name: 'space-3',  px: '14px',  bar: '14px'  },
  { name: 'space-4',  px: '20px',  bar: '20px'  },
  { name: 'space-5',  px: '28px',  bar: '28px'  },
  { name: 'space-6',  px: '36px',  bar: '36px'  },
  { name: 'space-7',  px: '48px',  bar: '48px'  },
  { name: 'space-8',  px: '56px',  bar: '56px'  },
  { name: 'space-9',  px: '72px',  bar: '72px'  },
  { name: 'space-10', px: '108px', bar: '108px' },
];

const radii = [
  { name: 'radius-xs',   px: '4px'   },
  { name: 'radius-sm',   px: '8px'   },
  { name: 'radius-md',   px: '12px'  },
  { name: 'radius-lg',   px: '18px'  },
  { name: 'radius-xl',   px: '20px'  },
  { name: 'radius-2xl',  px: '24px'  },
  { name: 'pill',        px: '100px' },
];
---

<DesignSystemLayout
  title="Atoms"
  section="01 · Atoms"
  lede="The visual primitives that everything else is built from. Colour, typography, spacing, radii, motion, plus the smallest interactive elements: buttons, badges, eyebrows, inputs, icons, avatars and dividers."
>

  <nav class="ds-toc" aria-label="On this page">
    <a href="#colour">Colour</a>
    <a href="#typography">Typography</a>
    <a href="#spacing">Spacing</a>
    <a href="#radii">Radii</a>
    <a href="#section-heads">Section heads</a>
    <a href="#buttons">Buttons</a>
    <a href="#eyebrows">Eyebrows</a>
    <a href="#dots">Dots & indicators</a>
    <a href="#badges">Badges</a>
    <a href="#avatars">Avatars</a>
    <a href="#dividers">Dividers</a>
    <a href="#inputs">Inputs</a>
    <a href="#links">Links</a>
    <a href="#motion">Motion</a>
  </nav>

  <!-- ─────────── COLOUR ─────────── -->
  <section class="ds-section" id="colour">
    <div class="ds-section-head">
      <h2>Colour</h2>
      <span class="ds-tag">--sage · --cream · --charcoal</span>
    </div>
    <p class="ds-note">
      The palette is short on purpose. Sage carries brand and primary action. Cream and warm white
      handle surfaces. Charcoal and mid handle text. Gold is reserved for value and pricing context.
      Use the CSS custom property, never the hex.
    </p>

    <div class="ds-grid cols-4">
      {swatches.map(s => (
        <div class="ds-swatch">
          <div class="ds-swatch-chip" style={`background:${s.hex}`}></div>
          <div class="ds-swatch-body">
            <div class="ds-swatch-name">{s.name}</div>
            <div class="ds-swatch-token">var({s.token})</div>
            <div class="ds-swatch-hex">{s.hex}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ─────────── TYPOGRAPHY ─────────── -->
  <section class="ds-section" id="typography">
    <div class="ds-section-head">
      <h2>Typography</h2>
      <span class="ds-tag">Playfair Display · DM Sans</span>
    </div>
    <p class="ds-note">
      Playfair Display for editorial headlines and large stat numbers, always weight 400, often with
      italic emphasis. DM Sans 300/400/500 for everything else. Italic is meaningful — it earns
      colour shift, not just a slant.
    </p>

    <div class="ds-specimen">
      <div class="ds-specimen-preview is-stack">
        <div>
          <div class="ds-type-row">
            <div class="ds-type-meta">
              <strong>Hero h1</strong>
              Playfair · 400 · clamp(48 → 92)<br/>
              letter-spacing -2.5px
            </div>
            <h1 style="font-family:'Playfair Display',serif;font-size:clamp(48px,7vw,92px);font-weight:400;line-height:1.04;letter-spacing:-2.5px;color:var(--charcoal);margin:0;">
              Beyond wealth: <em style="font-style:italic;color:var(--sage);">enjoy it</em>
            </h1>
          </div>
          <div class="ds-type-row">
            <div class="ds-type-meta">
              <strong>Section title (.s-title)</strong>
              Playfair · 400 · clamp(34 → 56)<br/>
              letter-spacing -1.5px
            </div>
            <h2 class="s-title" style="margin:0;">A new model for human performance</h2>
          </div>
          <div class="ds-type-row">
            <div class="ds-type-meta">
              <strong>Card title (.step-title)</strong>
              Playfair · 400 · 22px<br/>
              letter-spacing -0.4px
            </div>
            <div class="step-title">Deep diagnostic intake</div>
          </div>
          <div class="ds-type-row">
            <div class="ds-type-meta">
              <strong>Quote (.testi-quote)</strong>
              Playfair italic · 400 · 18px
            </div>
            <div class="testi-quote" style="margin:0;">A quiet, considered way to keep the years that count.</div>
          </div>
          <div class="ds-type-row">
            <div class="ds-type-meta">
              <strong>Section sub (.s-sub)</strong>
              DM Sans · 300 · 18px
            </div>
            <p class="s-sub" style="margin:0;">
              We built the infrastructure that connects your advisory firm to world-class preventive
              care, with none of the friction.
            </p>
          </div>
          <div class="ds-type-row">
            <div class="ds-type-meta">
              <strong>Body (.prose p)</strong>
              DM Sans · 300 · 15px · line-height 1.8
            </div>
            <p style="font-size:15px;font-weight:300;color:#3A3A38;line-height:1.8;margin:0;max-width:520px;">
              The same rigour your advisor applies to your portfolio, applied to your biology.
              Track trends, understand risks, and act on what the data reveals.
            </p>
          </div>
          <div class="ds-type-row">
            <div class="ds-type-meta">
              <strong>Eyebrow / label (.s-label)</strong>
              DM Sans · 500 · 11px · letter-spacing 0.1em
            </div>
            <p class="s-label" style="margin:0;">The process</p>
          </div>
        </div>
      </div>
      <div class="ds-specimen-meta">
        <span><strong>Use:</strong> hero, section, card, body, label</span>
        <span><strong>Tokens:</strong> font-family, weight, size, letter-spacing</span>
      </div>
    </div>
  </section>

  <!-- ─────────── SPACING ─────────── -->
  <section class="ds-section" id="spacing">
    <div class="ds-section-head">
      <h2>Spacing</h2>
      <span class="ds-tag">section 108px · gutter 56px</span>
    </div>
    <p class="ds-note">
      Sections use 108px top and bottom on desktop, 80px on mobile. Horizontal gutter is 56px on
      desktop, 24px on mobile. Inside containers, gaps step through the scale below.
    </p>

    <div class="ds-specimen">
      <div class="ds-specimen-preview is-block">
        <div class="ds-scale">
          {spacing.map(s => (
            <div class="ds-space-row">
              <div class="ds-space-label">{s.name}</div>
              <div class="ds-scale-value">{s.px}</div>
              <div class="ds-space-bar" style={`width:${s.bar}`}></div>
            </div>
          ))}
        </div>
      </div>
      <div class="ds-specimen-meta">
        <span><strong>Section padding:</strong> 108px / 24–56px gutter</span>
        <span><strong>Container max:</strong> 1120px</span>
      </div>
    </div>
  </section>

  <!-- ─────────── RADII ─────────── -->
  <section class="ds-section" id="radii">
    <div class="ds-section-head">
      <h2>Radii</h2>
      <span class="ds-tag">12 · 18 · 20 · 24 · pill</span>
    </div>
    <p class="ds-note">
      Cards land between 14 and 24px. Buttons, chips and pills always use a fully rounded radius
      (100px) so they read as interactive.
    </p>
    <div class="ds-specimen">
      <div class="ds-specimen-preview">
        <div class="ds-grid cols-6" style="width:100%;">
          {radii.map(r => (
            <div>
              <div class="ds-radius-tile" style={`border-radius:${r.px};`}>{r.px}</div>
              <div class="ds-swatch-token" style="margin-top:8px;">{r.name}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────── SECTION HEADS ─────────── -->
  <section class="ds-section" id="section-heads">
    <div class="ds-section-head">
      <h2>Section heads</h2>
      <span class="ds-tag">.s-label · .s-title · .s-sub</span>
    </div>
    <p class="ds-note">Every section opens with this trio. Label, title, sub — in that order.</p>
    <div class="ds-specimen">
      <div class="ds-specimen-preview">
        <div>
          <p class="s-label">The process</p>
          <h2 class="s-title" style="margin-bottom:18px;">A new model for human performance</h2>
          <p class="s-sub">We built the infrastructure that connects your advisory firm to world-class preventive care.</p>
        </div>
      </div>
      <pre class="ds-code"><span class="com">{`<!-- Section head -->`}</span>
<span class="tag">{`<p `}</span><span class="attr">{`class`}</span><span class="tag">{`=`}</span><span class="str">{`"s-label"`}</span><span class="tag">{`>`}</span>The process<span class="tag">{`</p>`}</span>
<span class="tag">{`<h2 `}</span><span class="attr">{`class`}</span><span class="tag">{`=`}</span><span class="str">{`"s-title"`}</span><span class="tag">{`>`}</span>A new model for human performance<span class="tag">{`</h2>`}</span>
<span class="tag">{`<p `}</span><span class="attr">{`class`}</span><span class="tag">{`=`}</span><span class="str">{`"s-sub"`}</span><span class="tag">{`>`}</span>...<span class="tag">{`</p>`}</span></pre>
    </div>
  </section>

  <!-- ─────────── BUTTONS ─────────── -->
  <section class="ds-section" id="buttons">
    <div class="ds-section-head">
      <h2>Buttons</h2>
      <span class="ds-tag">.btn-solid · .btn-outline · .btn-white · .nav-cta</span>
    </div>
    <p class="ds-note">
      One primary on a section, never two. Outline is the secondary partner to a solid in hero. White
      is for sage-coloured surfaces. <code class="ds-inline">.nav-cta</code> is the compact navbar
      variant.
    </p>
    <div class="ds-specimen">
      <div class="ds-specimen-preview">
        <a href="#" class="btn-solid">Join the waitlist</a>
        <a href="#" class="btn-outline">See how it works &#8594;</a>
        <a href="#" class="nav-cta" style="text-decoration:none;">Get early access</a>
      </div>
      <pre class="ds-code"><span class="tag">{`<a `}</span><span class="attr">{`class`}</span><span class="tag">{`=`}</span><span class="str">{`"btn-solid"`}</span><span class="tag">{`>`}</span>Join the waitlist<span class="tag">{`</a>`}</span>
<span class="tag">{`<a `}</span><span class="attr">{`class`}</span><span class="tag">{`=`}</span><span class="str">{`"btn-outline"`}</span><span class="tag">{`>`}</span>See how it works<span class="tag">{`</a>`}</span>
<span class="tag">{`<a `}</span><span class="attr">{`class`}</span><span class="tag">{`=`}</span><span class="str">{`"nav-cta"`}</span><span class="tag">{`>`}</span>Get early access<span class="tag">{`</a>`}</span></pre>
    </div>
    <div class="ds-specimen">
      <div class="ds-specimen-preview is-dark">
        <a href="#" class="btn-white">Apply on behalf of a client</a>
      </div>
      <div class="ds-specimen-meta">
        <span><strong>.btn-white</strong> · only on sage or charcoal surfaces</span>
      </div>
    </div>
  </section>

  <!-- ─────────── EYEBROWS ─────────── -->
  <section class="ds-section" id="eyebrows">
    <div class="ds-section-head">
      <h2>Eyebrows</h2>
      <span class="ds-tag">.eyebrow · .s-label · .page-label</span>
    </div>
    <p class="ds-note">
      Three flavours: hero eyebrow with pill background and dot, plain section label, and the
      stronger page-hero label. All use the same type spec: 11px, weight 500, uppercase, 0.1em
      tracking.
    </p>
    <div class="ds-specimen">
      <div class="ds-specimen-preview is-stack">
        <div class="eyebrow"><div class="eyebrow-dot"></div>Now enrolling founding members</div>
        <p class="s-label">The process</p>
        <p class="page-label">Privacy policy</p>
      </div>
    </div>
  </section>

  <!-- ─────────── DOTS / INDICATORS ─────────── -->
  <section class="ds-section" id="dots">
    <div class="ds-section-head">
      <h2>Dots and indicators</h2>
      <span class="ds-tag">.eyebrow-dot · .scroll-indicator · .mobile-menu-dot</span>
    </div>
    <p class="ds-note">
      Small motion signals. The eyebrow dot blinks at 2s. The scroll indicator pulses down a 52px
      thin line. The mobile menu dot mirrors the eyebrow dot.
    </p>
    <div class="ds-specimen">
      <div class="ds-specimen-preview">
        <div class="eyebrow"><div class="eyebrow-dot"></div>Live indicator</div>
        <div style="position:relative;width:32px;height:60px;">
          <div class="scroll-line" style="position:absolute;top:0;left:50%;transform:translateX(-50%);"></div>
        </div>
        <div class="mobile-menu-dot"></div>
      </div>
    </div>
  </section>

  <!-- ─────────── BADGES ─────────── -->
  <section class="ds-section" id="badges">
    <div class="ds-section-head">
      <h2>Badges</h2>
      <span class="ds-tag">.plan-badge · .tag-chip · .blog-filter</span>
    </div>
    <p class="ds-note">
      Use a badge to call out a single status. Tag chips appear in groups on post pages. Blog filter
      chips behave as toggles using <code class="ds-inline">.is-active</code>.
    </p>
    <div class="ds-specimen">
      <div class="ds-specimen-preview">
        <span class="plan-badge">Most popular</span>
        <a href="#" class="tag-chip">research</a>
        <a href="#" class="tag-chip tag-neutral">protocol</a>
        <a href="#" class="blog-filter">All</a>
        <a href="#" class="blog-filter is-active">Research</a>
      </div>
    </div>
  </section>

  <!-- ─────────── AVATARS ─────────── -->
  <section class="ds-section" id="avatars">
    <div class="ds-section-head">
      <h2>Avatars</h2>
      <span class="ds-tag">.avatar · .speaker-avatar · .avatar-lg · .avatar-xl</span>
    </div>
    <p class="ds-note">
      Sage pale background, sage initials, weight 500. Sizes step 32 / 42 / 44 / 56 / 96. Use
      initials. Photo treatments are not in scope for v1.
    </p>
    <div class="ds-specimen">
      <div class="ds-specimen-preview">
        <div class="avatar" style="width:32px;height:32px;font-size:11px;">IA</div>
        <div class="avatar">DG</div>
        <div class="speaker-avatar">DG</div>
        <div class="avatar-lg">HC</div>
        <div class="avatar-xl">IA</div>
      </div>
    </div>
  </section>

  <!-- ─────────── DIVIDERS ─────────── -->
  <section class="ds-section" id="dividers">
    <div class="ds-section-head">
      <h2>Dividers</h2>
      <span class="ds-tag">.cred-divider · 1px var(--border)</span>
    </div>
    <p class="ds-note">A single border colour, used for hairlines, grid splits, and section breaks.</p>
    <div class="ds-specimen">
      <div class="ds-specimen-preview">
        <span>before</span>
        <div class="cred-divider"></div>
        <span>after</span>
      </div>
    </div>
  </section>

  <!-- ─────────── INPUTS ─────────── -->
  <section class="ds-section" id="inputs">
    <div class="ds-section-head">
      <h2>Inputs</h2>
      <span class="ds-tag">.wf-input · .wf-select · .wf-label</span>
    </div>
    <p class="ds-note">
      Form fields share a single visual: warm-white background, 1px border, 10px radius, sage focus
      ring at 10% opacity. Label sits above the field with 7px gap.
    </p>
    <div class="ds-specimen">
      <div class="ds-specimen-preview is-block">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:540px;">
          <div class="wf-field">
            <label class="wf-label">Full name</label>
            <input class="wf-input" placeholder="Jane Cavendish" />
          </div>
          <div class="wf-field">
            <label class="wf-label">Advisor firm</label>
            <select class="wf-input wf-select">
              <option>Select…</option>
              <option>RIA</option>
              <option>Family office</option>
              <option>Private bank</option>
            </select>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────── LINKS ─────────── -->
  <section class="ds-section" id="links">
    <div class="ds-section-head">
      <h2>Links</h2>
      <span class="ds-tag">.prose a · .nav-back</span>
    </div>
    <p class="ds-note">In-body links are sage with a 2px underline offset. Navigation back-links use mid colour and turn sage on hover.</p>
    <div class="ds-specimen">
      <div class="ds-specimen-preview is-stack">
        <p class="prose" style="margin:0;font-size:15px;font-weight:300;color:#3A3A38;line-height:1.7;max-width:540px;">
          Read the <a href="#">privacy policy</a> to understand how member data is handled across the firm.
        </p>
        <a href="#" class="nav-back">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M11 7H3M6 3L2 7l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to home
        </a>
      </div>
    </div>
  </section>

  <!-- ─────────── MOTION ─────────── -->
  <section class="ds-section" id="motion">
    <div class="ds-section-head">
      <h2>Motion</h2>
      <span class="ds-tag">GSAP 3.12 · CSS keyframes</span>
    </div>
    <p class="ds-note">
      Four named keyframes ship with the system: <code class="ds-inline">up</code> for hero entry,
      <code class="ds-inline">blink</code> for indicator dots, <code class="ds-inline">grow</code>
      for the scroll line, and <code class="ds-inline">wfFadeIn</code> for form success. The mobile
      menu uses a GSAP timeline. Default easing is <code class="ds-inline">power3.out</code> /
      <code class="ds-inline">expo.out</code>. Durations 0.25–0.55s.
    </p>
    <div class="ds-specimen">
      <div class="ds-specimen-preview is-stack">
        <div class="ds-type-meta"><strong>Hover lift (cards, buttons)</strong> transform: translateY(-2 to -4px) · 0.2s ease</div>
        <div class="ds-type-meta"><strong>Hero entry</strong> @keyframes up · 0.7s ease, staggered 0.1s</div>
        <div class="ds-type-meta"><strong>Indicator blink</strong> @keyframes blink · 2s ease infinite</div>
      </div>
    </div>
  </section>

</DesignSystemLayout>
