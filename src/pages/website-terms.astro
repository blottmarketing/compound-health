<style is:global>
/* Legal pages: a plain reading column in the house style. */
.legal-nav { position: static; display: flex; align-items: center; justify-content: space-between; padding: 1.5rem 4.5rem; }
.legal-nav .nav-logo { color: var(--charcoal); }
.legal-nav .logo-svg { height: 22px; }
/* The bar is fixed, so the column clears its height before it starts. */
.legal { padding: calc(1.5rem * 2 + 2.5rem + 3rem) 4.5rem 7rem; }
.legal-inner { max-width: 760px; margin: 0 auto; }
.legal-meta { color: var(--zinc-500); margin: 1rem 0 3rem; font-size: var(--fs-small); }
.legal h1 { font-size: var(--fs-h2l); line-height: var(--lh-h2); letter-spacing: var(--ls-h2); font-weight: 500; margin: 0.75rem 0 0; }
.legal h2 { font-size: var(--fs-h4); line-height: var(--lh-h4); letter-spacing: var(--ls-h4); font-weight: 500; margin: 3rem 0 0.75rem; }
.legal p, .legal li { font-size: var(--fs-body); line-height: 1.6; letter-spacing: var(--ls-body); color: var(--zinc-700); }
.legal p + p { margin-top: 1rem; }
.legal ul { margin: 1rem 0 0; padding-left: 1.25rem; }
.legal li + li { margin-top: 0.5rem; }
.legal li strong, .legal p strong { color: var(--charcoal); font-weight: 500; }
.legal a { color: var(--sage); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 2px; }
.legal a:hover { color: var(--charcoal); }
.site-footer { position: static; }
.legal-page .closer { display: none; }
@media (max-width: 900px) {
  .legal-nav { padding: 1rem 1.25rem; }
  .legal-nav .logo-svg { height: 20px; }
  .legal { padding: calc(1rem * 2 + 2.5rem + 2rem) 1.25rem 4rem; }
  .legal h1 { font-size: 2rem; }
}
</style>
