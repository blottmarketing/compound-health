    <!-- Discipline tabs. Each discipline has its own figure in the panel, not the
         same list three times, and all three figures share one height so nothing
         moves as the tab changes.

         The tabs advance on their own every 7s. The countdown is the ring around
         the icon of the open tab: a CSS animation on the ring's stroke, with the
         advance driven by its animationend, so the ring and the switch can never
         drift apart. Hovering does not stop it. Keyboard
         focus does, so nothing moves under someone reading with the keyboard, and
         so does leaving the viewport. Choosing a tab restarts the countdown from
         it rather than ending the rotation. With reduced motion, or no
         JavaScript, nothing rotates, the rings stay as plain hairlines and the
         first pane stays open. -->
    <script is:inline>
      (function () {
        const AUTO_MS = 7000;
        const root = document.getElementById('disciplines');
        if (!root) return;
        const list  = root.querySelector('.prod-list');
        const rings = Array.from(root.querySelectorAll('.prod-ring-fill'));
        const tabs  = Array.from(root.querySelectorAll('[role="tab"]'));
        const panes = Array.from(root.querySelectorAll('.prod-pane'));
        if (!list || !tabs.length) return;

        let current = 0;
        let auto = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function select(index, focus = false) {
          current = index;
          tabs.forEach((tab, i) => {
            const on = i === index;
            tab.setAttribute('aria-selected', on ? 'true' : 'false');
            tab.tabIndex = on ? 0 : -1;
          });
          panes.forEach((pane, i) => pane.classList.toggle('is-active', i === index));
          if (focus) tabs[index].focus();
          if (auto) restartTimer();
        }

        // Clearing the animation and forcing a reflow is what makes the ring
        // start over, including when the open tab is chosen again.
        function restartTimer() {
          const ring = rings[current];
          if (!ring) return;
          ring.style.animation = 'none';
          void ring.getBoundingClientRect();
          ring.style.animation = '';
        }

        list.addEventListener('animationend', e => {
          if (!auto) return;
          const el = e.target;
          if (!el.classList || !el.classList.contains('prod-ring-fill')) return;
          select((current + 1) % tabs.length);
        });

        const pause  = () => { if (auto) list.classList.add('is-paused'); };
        const resume = () => list.classList.remove('is-paused');

        // Only a keyboard focus pauses. A mouse click focuses the tab too, and
        // pausing on that left the rotation stuck until the pointer moved away.
        root.addEventListener('focusin', e => {
          const el = e.target;
          if (el.matches && el.matches(':focus-visible')) pause();
        });
        root.addEventListener('focusout', resume);

        tabs.forEach((tab, i) => {
          // Choosing a tab restarts the countdown from it rather than ending the
          // rotation.
          tab.addEventListener('click', () => select(i));
          tab.addEventListener('keydown', e => {
            const last = tabs.length - 1;
            let next = -1;
            if (e.key === 'ArrowDown' || e.key === 'ArrowRight') next = i === last ? 0 : i + 1;
            else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') next = i === 0 ? last : i - 1;
            else if (e.key === 'Home') next = 0;
            else if (e.key === 'End') next = last;
            if (next < 0) return;
            e.preventDefault();
            select(next, true);
          });
        });

        // Both the ring and the panel figures run on this length.
        root.style.setProperty('--auto-ms', AUTO_MS + 'ms');
        if (auto) list.classList.add('is-auto');

        // Only rotate while the section is actually on screen.
        if (auto && 'IntersectionObserver' in window) {
          new IntersectionObserver(entries => {
            entries.forEach(entry => {
              if (!auto) return;
              if (entry.isIntersecting) { resume(); restartTimer(); }
              else pause();
            });
          }, { threshold: 0.35 }).observe(root);
        } else if (auto) {
          restartTimer();
        }
      })();
    </script>

    <!-- Custom dropdowns. Each select.wf-select is wrapped in .wf-dd and given a
         button and a listbox; the native select stays as the value the form
         script reads, and is updated on every choice. Arrow keys, Home, End,
         Enter, Space and Escape work; a click outside closes. Without JavaScript
         the native select is what the reader sees. -->
    <script is:inline>
      (function () {
        const CHEV = '<svg class="wf-dd-chev" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        const TICK = '<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3.2 3L13 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';

        document.querySelectorAll('select.wf-select').forEach((sel, n) => {
          const label = sel.id ? document.querySelector(`label[for="${sel.id}"]`) : null;
          const wrap  = document.createElement('div');
          wrap.className = 'wf-dd';
          sel.parentNode?.insertBefore(wrap, sel);
          wrap.appendChild(sel);
          sel.tabIndex = -1;
          sel.setAttribute('aria-hidden', 'true');

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'wf-dd-btn';
          btn.id = `${sel.id || 'wf-dd-' + n}-btn`;
          btn.setAttribute('aria-haspopup', 'listbox');
          btn.setAttribute('aria-expanded', 'false');
          if (label) { btn.setAttribute('aria-label', label.textContent?.trim() || ''); label.htmlFor = btn.id; }
          const text = document.createElement('span');
          btn.appendChild(text);
          btn.insertAdjacentHTML('beforeend', CHEV);

          const list = document.createElement('ul');
          list.className = 'wf-dd-list';
          list.setAttribute('role', 'listbox');
          list.id = `${btn.id}-list`;
          btn.setAttribute('aria-controls', list.id);

          const opts = Array.from(sel.options).filter((o) => !o.disabled);
          const items = opts.map((o) => {
            const li = document.createElement('li');
            li.className = 'wf-dd-opt';
            li.setAttribute('role', 'option');
            li.dataset.value = o.value;
            li.innerHTML = `<span>${o.textContent}</span>${TICK}`;
            li.addEventListener('click', () => { choose(o.value); close(); btn.focus(); });
            list.appendChild(li);
            return li;
          });
          wrap.appendChild(btn);
          wrap.appendChild(list);

          const placeholder = sel.options[0]?.disabled ? sel.options[0].textContent || '' : '';
          let focus = -1;

          function render() {
            const cur = sel.value;
            const selected = opts.find((o) => o.value === cur && cur !== '');
            text.textContent = selected ? selected.textContent : placeholder;
            btn.classList.toggle('is-empty', !selected);
            items.forEach((li) => li.setAttribute('aria-selected', String(li.dataset.value === cur && cur !== '')));
          }
          function choose(value) {
            sel.value = value;
            sel.dispatchEvent(new Event('change', { bubbles: true }));
            render();
          }
          function setFocus(i) {
            focus = Math.max(0, Math.min(items.length - 1, i));
            items.forEach((li, k) => li.classList.toggle('is-focus', k === focus));
            items[focus]?.scrollIntoView({ block: 'nearest' });
          }
          function open() {
            list.classList.add('is-open');
            btn.setAttribute('aria-expanded', 'true');
            const cur = items.findIndex((li) => li.getAttribute('aria-selected') === 'true');
            setFocus(cur >= 0 ? cur : 0);
          }
          function close() {
            list.classList.remove('is-open');
            btn.setAttribute('aria-expanded', 'false');
            items.forEach((li) => li.classList.remove('is-focus'));
            focus = -1;
          }
          const isOpen = () => list.classList.contains('is-open');

          btn.addEventListener('click', () => (isOpen() ? close() : open()));
          btn.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
              e.preventDefault();
              if (!isOpen()) open();
              else setFocus(focus + (e.key === 'ArrowDown' ? 1 : -1));
            } else if (e.key === 'Home' && isOpen()) { e.preventDefault(); setFocus(0); }
            else if (e.key === 'End' && isOpen()) { e.preventDefault(); setFocus(items.length - 1); }
            else if ((e.key === 'Enter' || e.key === ' ') && isOpen()) {
              e.preventDefault();
              const li = items[focus];
              if (li) choose(li.dataset.value || '');
              close();
            } else if (e.key === 'Escape' && isOpen()) { e.preventDefault(); close(); }
            else if (e.key === 'Tab' && isOpen()) { close(); }
          });
          document.addEventListener('click', (e) => { if (isOpen() && !wrap.contains(e.target)) close(); });
          sel.addEventListener('change', render);
          render();
        });
      })();
    </script>

    <!-- The diagnostics figure runs up to its number. The count reads the clock
         of the first arc of the ring rather than a clock of its own, so it can
         never land ahead of the ring, and it writes nothing while another tab is
         open. With reduced motion, or no JavaScript, the figure simply
         reads what is in the markup. -->
    <script is:inline>
      (function () {
        const num = document.querySelector('[data-count-to]');
        if (!num) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const target = Number(num.dataset.countTo);
        const light  = num.closest('.cov')?.querySelector('.cov-arc');
        const pane   = num.closest('.prod-pane');
        if (!target || !light || !pane) return;

        // The window the panels land in, as a fraction of one rotation.
        const START = 0.02;
        const END   = 0.30;
        const ease  = (t) => 1 - Math.pow(1 - t, 3);
        let shown = -1;

        function tick() {
          requestAnimationFrame(tick);
          if (!pane.classList.contains('is-active')) return;

          const anim = light.getAnimations()[0];
          if (!anim || anim.currentTime === null) return;
          const cycle = Number(anim.effect?.getTiming().duration) || 7000;
          const phase = (Number(anim.currentTime) % cycle) / cycle;

          const t = Math.max(0, Math.min(1, (phase - START) / (END - START)));
          const value = Math.round(ease(t) * target);
          if (value !== shown) { num.textContent = String(value); shown = value; }
        }
        requestAnimationFrame(tick);
      })();
    </script>

    <!-- Waitlist form script -->
    <script is:inline>
      // LIVE ENDPOINT. This is the client's real Google Apps Script, and anything
      // submitted from a local build lands in the real sheet. Point it at your own
      // while you work on the form, or leave the form alone.
      const WAITLIST_ENDPOINT =
        'https://script.google.com/macros/s/AKfycbw9x1Q9dVIDbTRRnsgajzbXHrL2Y3mz7SSWO2qHGtDeK9XsrxKhtBpItlPaY3oDn28/exec';

      // Routing. The Apps Script endpoint branches on `audience` so partner
      // submissions land somewhere other than the client waitlist. The tag values
      // are placeholders: the inbox / CRM tag for partners is still an open point
      // in the designer brief, and changing them here is a one-line edit.
      const ROUTING_TAG = {
        client:  'client-waitlist',
        partner: 'partner-pipeline',
      };

      const waitlistForm    = document.getElementById('waitlistForm');
      const waitlistSuccess = document.getElementById('waitlistSuccess');
      const wfSubmit        = document.getElementById('wfSubmit');
      const wfError         = document.getElementById('wfError');
      const wfErrorMsg      = wfError?.querySelector('.wf-error-msg');
      const wfLabel         = wfSubmit?.querySelector('.wf-submit-label');
      const wfRole          = document.getElementById('wfRole');
      const wsTitle         = document.getElementById('wsTitle');
      const wsBody          = document.getElementById('wsBody');
      const wsReset         = document.getElementById('wsReset');
      const ORIGINAL_LABEL  = wfLabel?.textContent ?? 'Reserve my place';

      const segments = Array.from(
        wfRole?.querySelectorAll('.wf-segment') ?? []
      );

      /** 'client' or 'partner', from the currently selected segment. */
      function currentAudience() {
        const active = segments.find((s) => s.classList.contains('is-active'));
        return active?.dataset.audience ?? 'client';
      }

      /** The specific segment value, e.g. 'client', 'wealth-firm', 'employer', 'network'. */
      function currentRole() {
        const active = segments.find((s) => s.classList.contains('is-active'));
        return active?.dataset.role ?? 'client';
      }

      function showError(message) {
        if (!wfError) return;
        if (wfErrorMsg) wfErrorMsg.textContent = message;
        wfError.classList.add('visible');
      }

      function clearError() {
        wfError?.classList.remove('visible');
      }

      /**
       * Reveal the fields for one audience and hide the other's. Both paths carry
       * two conditional fields, so the card keeps the same height either way.
       */
      function applyAudience(audience) {
        document
          .querySelectorAll('[data-shown-to]')
          .forEach((field) => {
            field.hidden = field.dataset.shownTo !== audience;
          });
      }

      /** Select a segment by role slug. 'partner' picks the first partner option. */
      function selectRole(role) {
        const target =
          segments.find((s) => s.dataset.role === role) ??
          (role === 'partner'
            ? segments.find((s) => s.dataset.audience === 'partner')
            : undefined);
        if (!target) return;

        segments.forEach((s) => {
          const isActive = s === target;
          s.classList.toggle('is-active', isActive);
          s.setAttribute('aria-checked', String(isActive));
        });
        applyAudience(target.dataset.audience ?? 'client');
        clearError();
      }

      segments.forEach((segment) => {
        segment.addEventListener('click', () => {
          selectRole(segment.dataset.role ?? 'client');
        });
      });

      // Links elsewhere on the page can preset the selector before the browser
      // scrolls to the form, e.g. the Partners CTA. Delegated, so triggers added
      // to the page later are wired without touching this file.
      document.addEventListener('click', (event) => {
        const trigger = (event.target)?.closest('[data-wf-role]');
        if (trigger) selectRole(trigger.dataset.wfRole ?? 'partner');
      });

      applyAudience(currentAudience());

      if (wfSubmit && waitlistForm && waitlistSuccess) {
        wfSubmit.addEventListener('click', async () => {
          clearError();

          const fnameInput   = document.getElementById('wf-fname');
          const lnameInput   = document.getElementById('wf-lname');
          const emailInput   = document.getElementById('wf-email');
          const tierInput    = document.getElementById('wf-tier');
          const advisorInput = document.getElementById('wf-advisor');
          const orgInput     = document.getElementById('wf-org');
          const reachInput   = document.getElementById('wf-reach');

          const audience  = currentAudience();
          const isPartner = audience === 'partner';

          const firstName = fnameInput?.value.trim()   ?? '';
          const lastName  = lnameInput?.value.trim()   ?? '';
          const email     = emailInput?.value.trim()   ?? '';
          const tier      = tierInput?.value           ?? '';
          const advisor   = advisorInput?.value.trim() ?? '';
          const org       = orgInput?.value.trim()     ?? '';
          const reach     = reachInput?.value          ?? '';

          // Minimal validation, matching the existing pattern: focus the first
          // field that needs attention. Required fields differ by audience.
          if (!firstName) { fnameInput?.focus(); return; }
          if (!lastName)  { lnameInput?.focus(); return; }
          if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            emailInput?.focus();
            return;
          }
          if (isPartner) {
            if (!org) { orgInput?.focus(); return; }
          } else if (!tier) {
            tierInput?.focus();
            return;
          }

          // Submitting state
          wfSubmit.disabled = true;
          if (wfLabel) wfLabel.textContent = 'Submitting…';

          const payload = new URLSearchParams({
            role:        currentRole(),
            audience,
            routingTag:  ROUTING_TAG[audience] ?? ROUTING_TAG.client,
            firstName,
            lastName,
            email,
            // Only the fields belonging to the chosen path are sent.
            tier:         isPartner ? '' : tier,
            advisor:      isPartner ? '' : advisor,
            organization: isPartner ? org : '',
            reach:        isPartner ? reach : '',
            source:      'compoundhealth.io',
            submittedAt: new Date().toISOString(),
            userAgent:   navigator.userAgent,
          });

          try {
            const res = await fetch(WAITLIST_ENDPOINT, {
              method: 'POST',
              // application/x-www-form-urlencoded is a "simple" request and avoids
              // a CORS preflight against the Apps Script endpoint.
              headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
              body: payload.toString(),
            });

            if (!res.ok) throw new Error('Request failed: ' + res.status);

            // Confirmation copy differs by audience.
            if (isPartner) {
              if (wsTitle) wsTitle.textContent = 'Request received';
              if (wsBody) {
                wsBody.textContent =
                  'Thank you. We will be in touch to discuss a program for your organization.';
              }
            } else {
              if (wsTitle) wsTitle.textContent = "You're on the list";
              if (wsBody) {
                // Personalize: "Thank you, {First Name}." Without a name: "Thank you."
                wsBody.textContent =
                  'Thank you' + (firstName ? ', ' + firstName : '') +
                  '. Your founding member request has been received. Our team will be in ' +
                  'touch as soon as your tier opens.';
              }
            }

            waitlistForm.style.display = 'none';
            waitlistSuccess.classList.add('visible');

            // Smoothly bring the success panel into view on smaller screens
            waitlistSuccess.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } catch (err) {
            console.error('Waitlist submission failed', err);
            wfSubmit.disabled = false;
            if (wfLabel) wfLabel.textContent = ORIGINAL_LABEL;
            showError("We couldn't submit your details. Please check your connection and try again.");
          }
        });
      }

      // Allow the user to submit another response without a page reload
      if (wsReset && waitlistForm && waitlistSuccess && wfSubmit) {
        wsReset.addEventListener('click', () => {
          ['wf-fname', 'wf-lname', 'wf-email', 'wf-advisor', 'wf-org'].forEach((id) => {
            const el = document.getElementById(id);
            if (el) el.value = '';
          });
          ['wf-tier', 'wf-reach'].forEach((id) => {
            const el = document.getElementById(id);
            if (el) { el.value = ''; el.dispatchEvent(new Event('change')); }
          });

          // Restore form, reset button, and return the selector to the client path
          selectRole('client');
          waitlistSuccess.classList.remove('visible');
          waitlistForm.style.display = '';
          wfSubmit.disabled = false;
          if (wfLabel) wfLabel.textContent = ORIGINAL_LABEL;
          clearError();
        });
      }
    </script>

    <!-- Feature mock-ups play once when their card comes into view. The
         observer adds .is-in, which the stylesheet keys its animations off,
         and runs the score up to its figure over the same window. With
         reduced motion the cards are marked in at once and the figure is set. -->
    <script is:inline>
      (function () {
        const cards = Array.from(document.querySelectorAll('.feat-card'));
        if (!cards.length) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function countUp(el) {
          const target = Number(el.dataset.count);
          if (!target) return;
          if (reduce) { el.textContent = String(target); return; }
          const start = performance.now() + 450;
          const dur = 1100;
          const ease = (t) => 1 - Math.pow(1 - t, 3);
          function tick(now) {
            const t = Math.max(0, Math.min(1, (now - start) / dur));
            el.textContent = String(Math.round(ease(t) * target));
            if (t < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
        }

        function enter(card) {
          card.classList.add('is-in');
          card.querySelectorAll('[data-count]').forEach(countUp);
        }

        if (reduce || !('IntersectionObserver' in window)) { cards.forEach(enter); return; }
        const io = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            enter(entry.target);
            obs.unobserve(entry.target);
          });
        }, { threshold: 0.35 });
        cards.forEach(c => io.observe(c));
      })();
    </script>

    <!-- Closing call to action: one photographic card, built like the hero so
         the page opens and closes on the same shape. -->
    <section class="closer">
      <div class="closer-card">
        <div class="closer-media" aria-hidden="true">
          <img
            class="closer-img"
            src="/images/closing.webp"
            alt=""
            width="1600"
            height="1067"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="closer-inner">
          <h2>The years to enjoy it<br />start now</h2>
          <p class="closer-sub">
            Founding member places and first-wave partner slots are limited, and both
            are filling through the advisors, firms and organizations we work with.
          </p>
          <div class="closer-btns">
            <a href="#joinwaitlist" class="btn-solid">Get access</a>
            <a href="#partners" class="btn-outline">For advisors and firms &#8594;</a>
          </div>
        </div>
      </div>
    </section>
</SiteLayout>
