---
/**
 * The Compound Health home page.
 *
 * Generated by scripts/port-drop.py from client_resources/final_version/
 * compound-health-v1.html. Do not edit by hand: run the script against the new
 * drop instead. The bar, the mobile menu, the footer and the script that drives
 * them are in SiteLayout; everything below is this page's own.
 *
 * Copy is the client's. Do not rewrite, shorten, add or remove marketing copy,
 * headings or CTA labels. If a layout needs different words, raise it.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Compound Health | A private longevity membership"
  intro={true}
  organizationSchema={true}
>
  <!-- ==================================================================
         THE PAGE (was src/pages/index.astro)
         ================================================================== -->

  <!-- HERO, after superpower.com: one dark photographic card inset from the
         viewport, copy set left and centred vertically, the credibility items
         along the foot of the card. Copy is unchanged. -->
    <section class="hero" id="main" tabindex="-1">
      <div class="hero-card">
        <div class="hero-media" aria-hidden="true">
          <img
            class="hero-img"
            src="/images/hero.webp"
            alt=""
            width="1600"
            height="800"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <div class="hero-inner">
          <h1>Beyond wealth:<br />the years to <em>enjoy it</em></h1>
          <p class="hero-sub">
                        A private longevity membership, introduced through the people who already advise
            you. Clinical partners selected on three things: published outcomes, clinical
            governance, and ownership of your own data.
          </p>
          <div class="hero-actions">
            <div class="hero-btns">
              <a href="#joinwaitlist" class="btn-solid">Get access</a>
              <a href="#how" class="btn-outline">See how it works &#8594;</a>
            </div>
          </div>
        </div>

        <!-- CREDIBILITY BAR, now the foot of the hero card. On phones the track
             scrolls: the items are listed twice so the loop is seamless, and
             the second set is hidden from assistive technology. -->
      </div>
    </section>

    <div class="rule"></div>

    <!-- HOW IT WORKS -->
    <section class="how" id="how">
      <div class="inner">
        <div class="s-head reveal">
          <p class="s-chip">The process</p>
          <div class="s-head-copy">
            <h2 class="s-title">One record. The best clinicians<br />for what it says.</h2>
            <p class="s-sub">
                            We built the layer that sits between the people who advise you and the clinicians
              worth sending you to.
            </p>
          </div>
          <div class="s-head-action">
            <a href="#features" class="btn-pill">What you get &#8594;</a>
          </div>
        </div>
        <div class="steps reveal">
          <div class="step">
            <div class="step-n">01</div>
            <div class="step-title">Join through your advisor, firm or organization</div>
            <p>
              Access Compound Health as a benefit through a relationship you already have. No cold
              starts. No separate onboarding.
            </p>
          </div>
          <div class="step">
            <div class="step-n">02</div>
            <div class="step-title">Deep diagnostic intake</div>
            <p>
              A comprehensive baseline: advanced bloodwork, imaging, genetic risk, cognitive and
              metabolic assessments. Not a wellness check. A full-picture biological audit by elite
              clinicians.
            </p>
          </div>
          <div class="step">
            <div class="step-n">03</div>
            <div class="step-title">Personalized longevity plan</div>
            <p>
              Your clinical team, chosen for this program, and a dedicated health concierge build
              and actively manage a protocol tailored to your data, goals, and lifestyle.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- WHAT YOU GET
         Bento grid: one tall cell carries the product surface, the rest carry a
         line icon, a title and a sentence. Deliberately not the two-column
         product pattern used by 'How we choose' below, so the two sections do
         not read as the same section twice. -->
    <section class="features" id="features">
      <div class="inner">
        <div class="s-head reveal">
          <p class="s-chip">What you get</p>
          <div class="s-head-copy">
            <h2 class="s-title">The parts that usually do not<br />talk to each other.</h2>
            <p class="s-sub">
                            A medical relationship that is continuous, physician-led, and calibrated to your own
              data. Your clinicians see the same record you do, every time.
            </p>
          </div>
          <div class="s-head-action">
            <a href="#membership" class="btn-pill">See membership &#8594;</a>
          </div>
        </div>

        <!-- Feature cards, after superpower.com: a visual panel in the brand
             tones with a small product card on it, then the title and a large
             muted description. The product cards are illustrative mock-ups. -->
        <div class="feat-grid reveal">
          <article class="feat-card">
            <div class="feat-visual tone-moss" aria-hidden="true">
              <div class="fm-card">
                <div class="fm-row fm-between"><span class="fm-title">Healthspan score</span><span class="fm-big"><span data-count="78">0</span><small>/100</small></span></div>
                <div class="fm-track"><span class="fm-seg is-moss" style="width:64%"></span><span class="fm-seg is-bronze" style="width:22%"></span><span class="fm-seg is-rust" style="width:8%"></span></div>
                <div class="fm-row fm-legend"><span><b>76</b> Optimal</span><span><b>22</b> In range</span><span><b>4</b> Out of range</span></div>
              </div>
              <div class="fm-card">
                <div class="fm-row fm-between"><span class="fm-title">Biological age</span><span class="fm-muted">Tracked each panel</span></div>
                <div class="fm-track fm-thin"><span class="fm-seg is-moss" style="width:36%; margin-left:24%"></span><span class="fm-marker" style="left:60%"></span></div>
              </div>
            </div>
            <div class="feat-copy">
              <h3 class="feat-name">A dashboard for your body</h3>
              <p class="feat-desc">The same rigor your advisor applies to your portfolio, applied to your biology. Track trends, understand risks, and act on what the data reveals.</p>
            </div>
          </article>
          <article class="feat-card">
            <div class="feat-visual tone-sand" aria-hidden="true">
              <div class="fm-card">
                <div class="fm-row fm-between"><span class="fm-title">Your care team</span><span class="fm-chip is-moss">Selected</span></div>
                <ul class="fm-list">
                  <li><span class="fm-dot is-moss"></span><span>Preventive cardiology</span><span class="fm-muted">Virtual</span></li>
                  <li><span class="fm-dot is-moss"></span><span>Longevity physician</span><span class="fm-muted">In person</span></li>
                  <li><span class="fm-dot is-bronze"></span><span>Sports medicine</span><span class="fm-muted">Referred</span></li>
                </ul>
              </div>
            </div>
            <div class="feat-copy">
              <h3 class="feat-name">Curated clinical delivery</h3>
              <p class="feat-desc">Physician-led care nationwide, virtual and in person, from partners selected for outcomes, governance, and data ownership. Logistics handled.</p>
            </div>
          </article>
          <article class="feat-card">
            <div class="feat-visual tone-rust" aria-hidden="true">
              <div class="fm-card">
                <div class="fm-row fm-between"><span class="fm-title">ApoB</span><span class="fm-chip is-moss">Optimal</span></div>
                <svg class="fm-chart" viewBox="0 0 320 130" aria-hidden="true">
                  <rect class="fm-band" x="0" y="62" width="320" height="60" rx="4" fill="var(--tone-moss-tint)" stroke="var(--tone-moss-light)" stroke-dasharray="3 3" stroke-width="1"/>
                  <polyline class="fm-line fm-line-1" pathLength="1" points="16,96 76,90 136,64 196,28" fill="none" stroke="var(--tone-bronze)" stroke-width="2"/>
                  <polyline class="fm-line fm-line-2" pathLength="1" points="196,28 256,88 304,86" fill="none" stroke="var(--tone-moss)" stroke-width="2"/>
                  <g class="fm-pts" fill="var(--tone-moss)"><circle cx="16" cy="96" r="3.5"/><circle cx="76" cy="90" r="3.5"/><circle cx="256" cy="88" r="3.5"/><circle cx="304" cy="86" r="3.5"/></g>
                  <g class="fm-pts" fill="var(--tone-bronze)"><circle cx="136" cy="64" r="3.5"/></g>
                  <g class="fm-pts" fill="var(--tone-rust)"><circle cx="196" cy="28" r="3.5"/></g>
                </svg>
                <div class="fm-row fm-legend fm-axis"><span>Jan</span><span>May</span><span>Sep</span><span>Jan</span><span>May</span></div>
              </div>
            </div>
            <div class="feat-copy">
              <h3 class="feat-name">Full biomarker tracking</h3>
              <p class="feat-desc">Multiple comprehensive panels per year, DEXA, full performance battery, CGM cycles, and continuous wearable integration, all synthesized into a single health intelligence layer.</p>
            </div>
          </article>
            <article class="feat-card">
              <div class="feat-visual tone-ink" aria-hidden="true">
                <div class="fm-card">
                  <div class="fm-row fm-between"><span class="fm-title">Your clinical record</span><span class="fm-muted">In your name</span></div>
                  <ul class="fm-list">
                    <li><span class="fm-chip is-moss">Panels</span><span>Every result, every year</span></li>
                    <li><span class="fm-chip is-moss">Scans</span><span>Imaging and reports</span></li>
                    <li><span class="fm-chip is-rust">Wearables</span><span>Continuous stream</span></li>
                  </ul>
                  <div class="fm-row fm-between"><span class="fm-muted">Grant a physician access</span><span class="fm-muted">This afternoon</span></div>
                </div>
              </div>
              <div class="feat-copy">
                <h3 class="feat-name">One record, held in your name</h3>
                <p class="feat-desc">Every panel, scan and wearable stream lands in a single clinical record. Grant a new physician access in an afternoon, and take it with you if you leave. We do not sell it, license it, or share it with your advisor, your employer or an insurer.</p>
              </div>
            </article>
          <article class="feat-card">
            <div class="feat-visual tone-umber" aria-hidden="true">
              <img class="feat-img" src="/images/feature.webp" alt="" width="1000" height="667" loading="lazy" decoding="async" />
              <div class="fm-card">
                <div class="fm-row fm-between"><span class="fm-title">Your protocol</span><span class="fm-muted">Updated today</span></div>
                <ul class="fm-list fm-plan">
                  <li><span class="fm-chip is-rust">Lifestyle</span><span>Zone 2, 3 &times; 45 min a week</span></li>
                  <li><span class="fm-chip is-rust">Nutrition</span><span>Protein to 1.6 g/kg</span></li>
                  <li><span class="fm-chip is-moss">Retest</span><span>Lipid panel in 12 weeks</span></li>
                </ul>
              </div>
            </div>
            <div class="feat-copy">
              <h3 class="feat-name">Personalized protocols</h3>
              <p class="feat-desc">Calibrated to your biology, not a template.</p>
            </div>
          </article>
          <article class="feat-card is-wide">
            <div class="feat-visual tone-blue" aria-hidden="true">
              <div class="fm-thread">
                <div class="fm-bubble is-me">Can you arrange the DEXA before I travel on the 22nd?</div>
                <div class="fm-bubble is-team"><span class="fm-avatars"><i></i><i></i><i></i></span>Booked for Thursday at 9:40. The report will be in your dashboard the same day.</div>
              </div>
            </div>
            <div class="feat-copy">
              <h3 class="feat-name">Health concierge</h3>
              <p class="feat-desc">A dedicated coordinator who handles specialist referrals, appointment logistics, second opinions, and anything else between you and better health.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- HOW WE CHOOSE
         The three disciplines are a tablist. Choosing one swaps the card in the
         panel and marks the row in the card behind it. Every line inside the
         panel is a phrase from that discipline's own paragraph. -->
    <section class="curated prod">
      <div class="inner">
        <div class="s-head reveal">
          <p class="s-chip">How we choose</p>
          <div class="s-head-copy">
            <h2 class="s-title">The best of each discipline,<br />one membership</h2>
            <p class="s-sub">
                            Longevity medicine is not one company. We assessed the field against three tests:
              published outcomes, clinical governance, and whether the patient owns the record.
              The partners here meet all three. We re-run the review every year. If a better
              clinician, test or platform emerges, your membership moves to it. You are never
              locked to a provider because we are.
            </p>
          </div>
        </div>

        <div class="prod-grid" id="disciplines">
          <div class="prod-list reveal" role="tablist" aria-label="Disciplines">
            <button class="prod-item" type="button" role="tab" id="tab-clinical"
                    aria-controls="pane-clinical" aria-selected="true" tabindex="0">
              <span class="prod-item-head">
                <span class="prod-icon">
                <svg class="prod-ring" viewBox="0 0 44 44" fill="none" aria-hidden="true">
                  <circle class="prod-ring-track" cx="22" cy="22" r="20"/>
                  <circle class="prod-ring-fill" cx="22" cy="22" r="20"/>
                </svg>
                <svg class="prod-glyph" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 3v5a4 4 0 0 0 8 0V3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  <path d="M3.5 3h2M11 3h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  <path d="M9 16v1a4 4 0 0 0 8 0v-1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <circle cx="18" cy="13.5" r="2" stroke="currentColor" stroke-width="1.5"/>
                </svg></span>
                <span class="prod-title">Clinical care</span>
              </span>
              <span class="prod-copy">Physician-led teams with published outcomes and continuous care between visits.</span>
            </button>
            <button class="prod-item" type="button" role="tab" id="tab-diagnostics"
                    aria-controls="pane-diagnostics" aria-selected="false" tabindex="-1">
              <span class="prod-item-head">
                <span class="prod-icon">
                <svg class="prod-ring" viewBox="0 0 44 44" fill="none" aria-hidden="true">
                  <circle class="prod-ring-track" cx="22" cy="22" r="20"/>
                  <circle class="prod-ring-fill" cx="22" cy="22" r="20"/>
                </svg>
                <svg class="prod-glyph" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8M16 4h2.5A1.5 1.5 0 0 1 20 5.5V8M20 16v2.5a1.5 1.5 0 0 1-1.5 1.5H16M8 20H5.5A1.5 1.5 0 0 1 4 18.5V16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg></span>
                <span class="prod-title">Diagnostics and screening</span>
              </span>
              <span class="prod-copy">
                Baseline testing, multi-cancer early detection and imaging, chosen for accuracy and
                usefulness.
              </span>
            </button>
            <button class="prod-item" type="button" role="tab" id="tab-therapies"
                    aria-controls="pane-therapies" aria-selected="false" tabindex="-1">
              <span class="prod-item-head">
                <span class="prod-icon">
                <svg class="prod-ring" viewBox="0 0 44 44" fill="none" aria-hidden="true">
                  <circle class="prod-ring-track" cx="22" cy="22" r="20"/>
                  <circle class="prod-ring-fill" cx="22" cy="22" r="20"/>
                </svg>
                <svg class="prod-glyph" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="2.8" y="8.2" width="18.4" height="7.6" rx="3.8" transform="rotate(-45 12 12)" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M9.3 9.3l5.4 5.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg></span>
                <span class="prod-title">Advanced therapies</span>
              </span>
              <span class="prod-copy">
                Hormones, peptides, and regenerative therapies, only when your data indicates them,
                only through vetted sourcing.
              </span>
            </button>
          </div>

          <div class="prod-panel reveal">
            <div class="prod-panes">
              <!-- Clinical care: who is on the team, and that it runs between visits. -->
              <div class="prod-pane is-active" id="pane-clinical" role="tabpanel" aria-labelledby="tab-clinical">
                <div class="stack-card">
                  <div class="stack-card-head">Your clinical team</div>
                  <!-- The team as one bar in four colours, with a legend of who
                       is on it. -->
                  <div class="team">
                    <div class="team-bar" aria-hidden="true"><span class="team-seg"></span><span class="team-seg"></span><span class="team-seg"></span><span class="team-seg"></span></div>
                    <div class="team-legend">
                      <div class="team-row">
                        <span class="team-role">MD-led</span>
                        <span class="team-note">Published outcomes</span>
                      </div>
                      <div class="team-row">
                        <span class="team-role">Health coaching</span>
                        <span class="team-note">Monthly</span>
                      </div>
                      <div class="team-row">
                        <span class="team-role">Dietitian hours</span>
                        <span class="team-note">Monthly</span>
                      </div>
                      <div class="team-row">
                        <span class="team-role">Health concierge</span>
                        <span class="team-note">Specialist referrals</span>
                      </div>
                    </div>
                  </div>
                  <div class="team-foot">
                    <span class="team-pulse" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
                    Continuous care between visits
                  </div>
                </div>
              </div>

              <!-- Diagnostics: the breadth of one baseline, as a number and a coverage map. -->
              <div class="prod-pane" id="pane-diagnostics" role="tabpanel" aria-labelledby="tab-diagnostics">
                <div class="stack-card">
                  <div class="stack-card-head">Baseline testing</div>
                  <!-- Six arcs, one per panel, draw in around the number; the
                       legend names them. Without JS the figure reads 500+. -->
                  <div class="cov">
                    <div class="cov-body">
                      <div class="cov-ring">
                        <svg viewBox="0 0 120 120" aria-hidden="true">
                          <circle class="cov-arc" cx="60" cy="60" r="48" transform="rotate(0 60 60)"/>
                          <circle class="cov-arc" cx="60" cy="60" r="48" transform="rotate(60 60 60)"/>
                          <circle class="cov-arc" cx="60" cy="60" r="48" transform="rotate(120 60 60)"/>
                          <circle class="cov-arc" cx="60" cy="60" r="48" transform="rotate(180 60 60)"/>
                          <circle class="cov-arc" cx="60" cy="60" r="48" transform="rotate(240 60 60)"/>
                          <circle class="cov-arc" cx="60" cy="60" r="48" transform="rotate(300 60 60)"/>
                        </svg>
                        <div class="cov-figure">
                          <span class="cov-value">
                            <span class="cov-num" data-count-to="500">500</span><span class="cov-plus">+</span>
                          </span>
                          <span class="cov-label">biomarkers</span>
                        </div>
                      </div>
                      <ul class="cov-legend">
                        <li>Bloodwork</li>
                        <li>Imaging</li>
                        <li>Genetics</li>
                        <li>Cognitive</li>
                        <li>Metabolic</li>
                        <li>Gut and toxin panels</li>
                      </ul>
                    </div>
                    <div class="cov-foot"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3.5 5 6v5.5c0 4.2 2.9 7.4 7 9 4.1-1.6 7-4.8 7-9V6l-7-2.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9 12l2.2 2.2L15.5 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Multi-cancer early detection</div>
                  </div>
                </div>
              </div>

              <!-- Advanced therapies: available, but behind two gates. -->
              <div class="prod-pane" id="pane-therapies" role="tabpanel" aria-labelledby="tab-therapies">
                <div class="stack-card is-feature">
                  <div class="stack-card-head">On a curated add-on layer</div>
                  <!-- The therapies are frosted chips on the gradient; the two
                       conditions sit under them in a glass strip and are ticked
                       in turn. -->
                  <div class="gate">

                    <div class="gate-flow">
                      <div class="gate-step">
                        <span class="gate-dot" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12.5l4.5 4.5L20 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                        <span class="gate-label">Only when your data indicates them</span>
                      </div>
                      <div class="gate-step">
                        <span class="gate-dot" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12.5l4.5 4.5L20 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                        <span class="gate-label">Only through vetted sourcing</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>


      </div>
    </section>

    <!-- PARTNERS (formerly Case study) -->
    <section class="case" id="partners">
      <div class="inner">
        <div class="s-head reveal">
          <p class="s-chip">Partners</p>
          <div class="s-head-copy">
            <h2 class="s-title">A credible way to bring longevity<br />to the people you serve</h2>
            <p class="s-sub">
              Compound Health is introduced, not sold. Whether you advise clients, employ a
              workforce or lead a network, you make the introduction and we run the program.
            </p>
          </div>
        </div>

        <div class="partner-notes reveal">
  <div class="partner-note">
            <div class="partner-note-title">Nothing crosses the line</div>
            <p>Before anything else. Health data belongs to the individual. You see engagement and participation, never medical information. Your people join through you, and you are never in the path of their care or their record.</p>
          </div>
  <div class="partner-note">
            <div class="partner-note-title">Structured for you</div>
            <p>Tiers and terms are set with each partner, so the program fits the people it serves.</p>
          </div>
  <div class="partner-note">
            <div class="partner-note-title">Introduced, not sold</div>
            <p>Your people join through you. You are never the intermediary for care or data.</p>
          </div>
        </div>

        <!-- Proof block: the first partner engagement, kept as evidence. Three
             hairline cells, not three billboard numbers. -->
        <div class="case-band reveal">
          <div class="case-media" aria-hidden="true">
            <img class="case-media-img" src="/images/partners.webp" alt="" width="800" height="1000" loading="lazy" decoding="async" />
          </div>
          <div class="case-stats">
            <div class="case-stat">
              <div class="case-num">400</div>
              <div class="case-stat-label">UHNW households in the advisory team we delivered to.</div>
          </div>

            <div class="case-stat">
              <div class="case-num">May '26</div>
              <div class="case-stat-label">From first conversation to delivered session in days, not quarters.</div>
          </div>
        </div>
        </div>

        <!-- The agenda reads as a list, not as a card: the heading holds the left
             column and the four items are hairline rows in the right. -->
        <div class="deliver reveal">
          <h3 class="deliver-title">What we delivered</h3>
          <ul class="deliver-list">
            <li>The health data worth paying attention to, and what to ignore</li>
            <li>The tests and metrics that matter in each decade of life</li>
            <li>High-impact habits for busy professionals and entrepreneurs</li>
            <li>How to support aging parents alongside your own health</li>
          </ul>
        </div>

        <div class="audience-grid reveal">
          <div class="audience-tile">
            <span class="audience-icon">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 9.5 12 4l9 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 10.5v8.5M18.5 10.5v8.5M10 10.5v8.5M14 10.5v8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M3.5 20h17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </span>
            <h3 class="audience-title">Wealth firms</h3>
            <p>
              RIAs, family offices, and private bank teams. A client session first, then membership
              your clients join through you.
