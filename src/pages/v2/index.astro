---
// Design variation v2. The live home page is src/pages/index.astro; this one is a
// candidate redesign on its own stylesheet (src/styles/variants/v2.css) and is noindex.
// It follows joindawn.com: the split hero, the great circle drawn by scroll, the sunrise
// into cream, stacked sections with rounded feet, the coverflow carousel, the sky card.
// Copy is the client's: it matches the live page and is not to be rewritten here. Every
// label inside a figure is a phrase from copy already in that section.
import V2Layout from '../../layouts/variants/V2Layout.astro';
---

<V2Layout
  variant="v2"
  base="/v2"
  title="Compound Health | A private longevity membership, introduced through your advisor, firm or organization"
  description="A private longevity membership introduced through wealth advisors, employers, and executive networks. Diagnostics, continuous tracking, and personalized protocols from curated clinical partners. Your health data stays yours."
>

  <!-- HERO: two cards on the dark ground. The warm card carries the headline, the
       photo card carries the standfirst and the actions. The dotted arc on the left
       and the solid arc on the right are the same circle. -->
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-card hero-card-left">
        <svg class="hero-arc hero-arc-left" viewBox="0 0 1194 1194" aria-hidden="true">
          <circle cx="597" cy="597" r="596"/>
        </svg>
        <div class="hero-content">
          <a href="#joinwaitlist" class="eyebrow"><span class="eyebrow-dot"></span>Founding member waitlist now open</a>
          <h1>Beyond wealth:<br />the years to <em>enjoy it</em></h1>
        </div>
      </div>
      <div class="hero-card hero-card-right">
        <img
          class="hero-img"
          src="/images/footer-landscape.webp"
          alt=""
          width="2048"
          height="1360"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero-tint" aria-hidden="true"></div>
        <div class="hero-scrim" aria-hidden="true"></div>
        <svg class="hero-arc hero-arc-right" viewBox="0 0 1194 1194" aria-hidden="true">
          <circle cx="597" cy="597" r="596"/>
        </svg>
        <div class="hero-content">
          <p class="hero-sub">
            A private longevity membership, introduced through the people who already advise you, your
            firm or your organization. Delivered by clinical partners chosen against one standard. Your
            data stays yours.
          </p>
          <div class="hero-actions">
            <div class="hero-btns">
              <a href="#joinwaitlist" class="btn btn-primary">Get access</a>
              <a href="#how" class="btn btn-tertiary-inverse">See how it works &#8594;</a>
            </div>
            <div class="hero-note">
              <a href="#partners" class="link-quiet">
                Introducing Compound Health to your clients, employees or members?
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CREDIBILITY BAR -->
    <div class="credbar">
      <span class="cred-label">Where we are</span>
      <div class="cred-item">
        <span class="cred-num">400</span>
        <span class="cred-text">UHNW clients in the advisory book we delivered our first session to</span>
      </div>
      <div class="cred-item">
        <span class="cred-num">May 2026</span>
        <span class="cred-text">First educational session with a global private bank advisory team</span>
      </div>
      <div class="cred-item">
        <span class="cred-num">1</span>
        <span class="cred-text">Healthspan score, owned by the client</span>
      </div>
    </div>
  </section>

  <!-- THE CIRCLE. A sticky stage the height of the viewport inside a tall scroller:
       as the reader scrolls, a gradient arc draws itself around the dotted ring, and
       the copy fades as the stage hands over to the sunrise. -->
  <div class="scroller" id="how" data-scroller>
    <div class="scroller-stage">
      <div class="ring" aria-hidden="true">
        <div class="ring-glow" data-ring-glow></div>
        <svg viewBox="0 0 1200 1200">
          <defs>
            <linearGradient id="ringGrad" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#F8E7D5"/>
              <stop offset="0.5" stop-color="#FBC81C"/>
              <stop offset="1" stop-color="#FF9C31"/>
            </linearGradient>
          </defs>
          <circle class="ring-track" cx="600" cy="600" r="596"/>
          <circle class="ring-draw" cx="600" cy="600" r="596" data-ring-draw/>
        </svg>
      </div>
      <div class="scroller-copy" data-scroller-copy>
        <p class="eyebrow">The process</p>
        <h2 class="scroller-title">A new model for<br />human performance</h2>
        <p class="scroller-sub">
          We built the infrastructure that connects the people who advise you to world-class
          preventive care.
        </p>
      </div>
    </div>
  </div>

  <!-- THE SUNRISE. The gradient carries the page from the dark ground to cream, and
       the three steps sit on the cream it arrives at. The sunrise has the rounded foot
       of a stacked section, so the sand of the next one shows through its corners. -->
  <div class="sunrise">
    <div class="container" data-nav-light>
      <div class="steps-grid">
        <div class="card is-lift reveal">
          <span class="tag tag-brand step-n">01</span>
          <h3 class="step-title">Join through your advisor, firm or organization</h3>
          <p>
            Access Compound Health as a benefit through a relationship you already have. No cold
            starts. No separate onboarding.
          </p>
        </div>
        <div class="card is-lift reveal">
          <span class="tag tag-brand step-n">02</span>
          <h3 class="step-title">Deep diagnostic intake</h3>
          <p>
            A comprehensive baseline: advanced bloodwork, imaging, genetic risk, cognitive and
            metabolic assessments. Not a wellness check. A full-picture biological audit by elite
            clinicians.
          </p>
        </div>
        <div class="card is-lift reveal">
          <span class="tag tag-brand step-n">03</span>
          <h3 class="step-title">Personalized longevity plan</h3>
          <p>
            Your clinical team, chosen for this program, and a dedicated health concierge build
            and actively manage a protocol tailored to your data, goals, and lifestyle.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- WHAT YOU GET. Under the head, the contrast pills (Dawn's past and future) carry
       the standfirst's own words, dim for what it is not, lit for what it is; the five
       features follow as cards. -->
  <section class="features stack z6 bg-sand" id="features">
    <div class="container">
      <div class="s-head reveal">
        <p class="eyebrow">What you get</p>
        <h2 class="h-medium">Everything your health<br />has been missing</h2>
        <p class="s-sub">
          Compound Health is not a gym membership or a supplement subscription. It is a medical
          relationship, sustained and personalized.
        </p>
      </div>
      <div class="contrast reveal" data-contrast>
        <span class="pill-past">A gym membership</span>
        <span class="pill-past">A supplement subscription</span>
        <div class="contrast-glow">
          <span class="pill-glow is-out">A medical relationship</span>
          <span class="pill-glow is-out">Sustained</span>
          <span class="pill-glow is-out">Personalized</span>
        </div>
      </div>

      <div class="feat-grid">
        <div class="card is-lift feat-card is-wide reveal">
          <div class="feat-copy">
            <span class="disc"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 4v16h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M8 14l3-4 3 3 4-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg></span>
            <h3 class="feat-title">A dashboard for your body</h3>
            <p>
              The same rigor your advisor applies to your portfolio, applied to your biology.
              Track trends, understand risks, and act on what the data reveals.
            </p>
          </div>
          <!-- The figure: the sentence's three verbs, as a thread. -->
          <div class="chat" aria-hidden="true">
            <div class="bubble">Track trends</div>
            <div class="bubble is-me">Understand risks</div>
            <div class="bubble">Act on what the data reveals</div>
            <div class="bubble is-me"><span class="bubble-typing"><span></span><span></span><span></span></span></div>
          </div>
        </div>

        <div class="card is-lift feat-card reveal">
          <span class="disc"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 3v5a4 4 0 0 0 8 0V3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M3.5 3h2M11 3h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M9 16v1a4 4 0 0 0 8 0v-1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="18" cy="13.5" r="2" stroke="currentColor" stroke-width="1.5"/>
              </svg></span>
          <h3 class="feat-title">Curated clinical delivery</h3>
          <p>
            Physician-led care nationwide, virtual and in person, from partners selected for
            outcomes, governance, and data ownership. Logistics handled.
          </p>
        </div>

        <div class="card is-lift feat-card reveal">
          <span class="disc"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M7 3c0 4 10 5 10 9s-10 5-10 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M17 3c0 4-10 5-10 9s10 5 10 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M8.5 6.5h7M7 12h10M8.5 17.5h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg></span>
          <h3 class="feat-title">Full biomarker tracking</h3>
          <p>
            Multiple comprehensive panels per year, DEXA, full performance battery, CGM cycles, and
            continuous wearable integration, all synthesized into a single health intelligence layer.
          </p>
        </div>

        <div class="card is-lift feat-card reveal">
          <span class="disc"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="2.8" y="8.2" width="18.4" height="7.6" rx="3.8" transform="rotate(-45 12 12)" stroke="currentColor" stroke-width="1.5"/>
                <path d="M9.3 9.3l5.4 5.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg></span>
          <h3 class="feat-title">Personalized protocols</h3>
          <p>
            Calibrated to your biology, not a template.
          </p>
        </div>

        <div class="card is-lift feat-card reveal">
          <span class="disc"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 17h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M5 17a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 7V5M10.5 5h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg></span>
          <h3 class="feat-title">Health concierge</h3>
          <p>
            A dedicated coordinator who handles specialist referrals, appointment logistics, second
            opinions, and anything else between you and better health.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW WE CHOOSE, on the brown ground. Three discipline tabs drive one card;
       the chips in each card are phrases from that discipline's own sentence. -->
  <section class="choose stack z5 bg-brown is-dark">
    <div class="choose-glow" aria-hidden="true"></div>
    <div class="container">
      <div class="s-head reveal">
        <p class="eyebrow">How we choose</p>
        <h2 class="choose-title text-grad">The best of each discipline,<br />one membership</h2>
        <p class="s-sub">
          Longevity medicine is not one company. We assessed the field, set one standard, and
          chose the partners who meet it.
        </p>
      </div>

      <div id="disciplines" class="reveal">
        <div class="tabs" role="tablist" aria-label="Disciplines">
          <button class="btn btn-md tab" type="button" role="tab" id="tab-clinical" aria-controls="pane-clinical" aria-selected="true" tabindex="0">Clinical care</button>
          <button class="btn btn-md tab" type="button" role="tab" id="tab-diagnostics" aria-controls="pane-diagnostics" aria-selected="false" tabindex="-1">Diagnostics and screening</button>
          <button class="btn btn-md tab" type="button" role="tab" id="tab-therapies" aria-controls="pane-therapies" aria-selected="false" tabindex="-1">Advanced therapies</button>
        </div>

        <div class="panes">
          <div class="pane is-active" id="pane-clinical" role="tabpanel" aria-labelledby="tab-clinical">
            <div class="pane-card">
              <div>
                <h3 class="pane-title">Clinical care</h3>
                <p class="pane-copy">Physician-led teams with published outcomes and continuous care between visits.</p>
              </div>
              <div class="pane-chips">
                <span class="tag tag-brand">Physician-led teams</span>
                <span class="tag tag-default">Published outcomes</span>
                <span class="tag tag-default">Continuous care between visits</span>
              </div>
            </div>
          </div>
          <div class="pane" id="pane-diagnostics" role="tabpanel" aria-labelledby="tab-diagnostics">
            <div class="pane-card">
              <div>
                <h3 class="pane-title">Diagnostics and screening</h3>
                <p class="pane-copy">
                  Baseline testing, multi-cancer early detection and imaging, chosen for accuracy and
                  usefulness.
                </p>
              </div>
              <div class="pane-chips">
                <span class="tag tag-brand">Baseline testing</span>
                <span class="tag tag-default">Multi-cancer early detection</span>
                <span class="tag tag-default">Imaging</span>
                <span class="tag tag-default">Accuracy and usefulness</span>
              </div>
            </div>
          </div>
          <div class="pane" id="pane-therapies" role="tabpanel" aria-labelledby="tab-therapies">
            <div class="pane-card">
              <div>
                <h3 class="pane-title">Advanced therapies</h3>
                <p class="pane-copy">
                  Hormones, peptides, and regenerative therapies, only when your data indicates them,
                  only through vetted sourcing.
                </p>
              </div>
              <div class="pane-chips">
                <span class="tag tag-brand">Hormones</span>
                <span class="tag tag-brand">Peptides</span>
                <span class="tag tag-brand">Regenerative therapies</span>
                <span class="tag tag-default">Only when your data indicates them</span>
                <span class="tag tag-default">Only through vetted sourcing</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <p class="choose-note reveal">
        Every partner is re-reviewed each year. If a better option emerges, the membership moves
        with it.
      </p>
    </div>
  </section>

  <!-- PARTNERS, on sand with a silk sheen. The four audiences ride Dawn's coverflow. -->
  <section class="partners stack z4 bg-sand silk" id="partners">
    <div class="container">
      <div class="s-head reveal">
        <p class="eyebrow">Partners</p>
        <h2 class="h-medium">A credible way to bring longevity<br />to the people you serve</h2>
        <p class="s-sub">
          Compound Health is introduced, not sold. Whether you advise clients, employ a
          workforce or lead a network, you make the introduction and we run the program.
        </p>
      </div>

      <div class="stats reveal">
        <div class="card stat">
          <div class="stat-num" data-count="400">400</div>
          <div class="stat-text">UHNW clients in the advisory team's book, reached through a single educational session.</div>
        </div>
        <div class="card stat">
          <div class="stat-num"><em>First</em></div>
          <div class="stat-text">Educational session of its kind delivered with a private bank advisory team.</div>
        </div>
        <div class="card stat">
          <div class="stat-num">May '26</div>
          <div class="stat-text">From first conversation to delivered session in days, not quarters.</div>
        </div>
      </div>

      <div class="card deliver reveal">
        <h3 class="deliver-title">What we delivered</h3>
        <ul class="deliver-list">
          <li>The health data worth paying attention to, and what to ignore</li>
          <li>The tests and metrics that matter in each decade of life</li>
          <li>High-impact habits for busy professionals and entrepreneurs</li>
          <li>How to support aging parents alongside your own health</li>
        </ul>
      </div>

      <div class="carousel reveal" id="audiences" aria-roledescription="carousel" aria-label="Who we work with">
        <div class="carousel-track">
          <div class="card aud-card" aria-current="true">
            <span class="disc">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 9.5 12 4l9 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 10.5v8.5M18.5 10.5v8.5M10 10.5v8.5M14 10.5v8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M3.5 20h17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </span>
            <h3 class="aud-title">Wealth firms</h3>
            <p>
              RIAs, family offices, and private bank teams. A client session first, then membership
              your clients join through you.
            </p>
          </div>
          <div class="card aud-card">
            <span class="disc">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="7.5" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M9 7.5V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M3 12.5h18" stroke="currentColor" stroke-width="1.5"/></svg>
            </span>
            <h3 class="aud-title">Employers</h3>
            <p>
              Self-insured employers and leadership teams. Clinical outcomes on health spend, from
              the C-suite to the wider organization.
            </p>
          </div>
          <div class="card aud-card">
            <span class="disc">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="9" cy="8.5" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M16 5.8a3 3 0 0 1 0 5.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M17.2 19a5.5 5.5 0 0 0-2-4.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </span>
            <h3 class="aud-title">Executive and peer networks</h3>
            <p>
              CEO groups, professional networks, sports and entertainment organizations. A shared
              baseline for your members and results you can publish.
            </p>
          </div>
          <div class="card aud-card">
            <span class="disc">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 10v10h12V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 20v-5.5h4V20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <h3 class="aud-title">Family offices and households</h3>
            <p>
              One program across generations, with each member owning their own data.
            </p>
          </div>
        </div>
      </div>
      <div class="carousel-arrows reveal">
        <button class="icon-btn" type="button" data-carousel-prev aria-label="Previous">
          <svg viewBox="0 0 6 10" fill="none" aria-hidden="true"><path d="M5 1L1 5l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="icon-btn" type="button" data-carousel-next aria-label="Next">
          <svg viewBox="0 0 6 10" fill="none" aria-hidden="true"><path d="M1 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      <div class="notes reveal">
        <div class="card">
          <div class="note-title">Structured for you</div>
          <p>Tiers and terms are set with each partner, so the program fits the people it serves.</p>
        </div>
        <div class="card">
          <div class="note-title">Nothing crosses the line</div>
          <p>Health data belongs to the individual. You see engagement, never medical information.</p>
        </div>
        <div class="card">
          <div class="note-title">Introduced, not sold</div>
          <p>Your people join through you. You are never the intermediary for care or data.</p>
        </div>
      </div>

      <div class="partner-cta reveal">
        <a href="#joinwaitlist" class="btn btn-primary" data-wf-role="partner">Talk to us about a program</a>
      </div>
    </div>
  </section>

  <!-- MEMBERSHIP -->
  <section class="plans stack z3 bg-cream" id="membership">
    <div class="container">
      <div class="s-head reveal">
        <p class="eyebrow">Membership</p>
        <h2 class="h-medium">Built for founders, executives, and families.</h2>
        <p class="s-sub">Structured for the organizations that serve them.</p>
        <p class="s-lead">One way in. Two ways forward.</p>
      </div>
      <div class="plans-grid reveal">
        <div class="card plan">
          <div class="plan-head"><div class="plan-name">Baseline</div></div>
          <p class="plan-price-note">Credited toward year one if you continue.</p>
          <ul class="plan-features">
            <li>Advanced and standard bloodwork, mobile-drawn at home</li>
            <li>DEXA scan, VO2 max with training zones, resting metabolic rate</li>
            <li>Body composition and strength assessment</li>
            <li>Written longevity plan reviewed by an MD</li>
          </ul>
          <a href="#joinwaitlist" class="btn btn-tertiary plan-btn">Start here &rarr;</a>
        </div>
        <div class="card plan is-featured">
          <div class="plan-head"><div class="plan-name">Optimize</div><span class="tag tag-brand">Most popular</span></div>
          <p class="plan-price-note">The annual program for sustained performance.</p>
          <ul class="plan-features">
            <li>MD-led, coach-supported program</li>
            <li>Day 1 and Day 180 full reviews, plus quarterly check-ins</li>
            <li>30 minutes per month of MD async messaging, monthly health coaching, and dietitian hours</li>
            <li>Multi-cancer early detection and biological-age and healthspan tracking</li>
            <li>Care navigation, with foundational supplements included</li>
            <li>Hormones, peptides, NAD, IV, and CGM available on a curated add-on layer</li>
          </ul>
          <a href="#joinwaitlist" class="btn btn-primary plan-btn">Get access &rarr;</a>
        </div>
        <div class="card plan">
          <div class="plan-head"><div class="plan-name">Eternal</div></div>
          <p class="plan-price-note">Top of practice, always on.</p>
          <ul class="plan-features">
            <li>Everything in Optimize</li>
            <li>Annual Executive Physical with 500+ biomarkers</li>
            <li>Multi-cancer early detection, whole-body and brain imaging, genetics, and gut and toxin panels</li>
            <li>Unlimited messaging with a five-person concierge care team</li>
            <li>Hormones, supplements, and quarterly re-testing included</li>
          </ul>
          <a href="#joinwaitlist" class="btn btn-tertiary plan-btn">Contact us &rarr;</a>
        </div>
      </div>
      <p class="family-note reveal">Family and household coverage is available as an extension across all tiers. Terms are structured with each partner. Ask your introducer, or ask us.</p>
    </div>
  </section>

  <!-- ACCESS: the sky card carries the closing message, the form sits beneath it. -->
  <section class="cta stack z2 bg-cream" id="joinwaitlist">
    <div class="sky" data-sky>
      <div class="cloud cloud-1" aria-hidden="true"></div>
      <div class="cloud cloud-2" aria-hidden="true"></div>
      <div class="cloud cloud-3" aria-hidden="true"></div>
      <div class="cloud cloud-4" aria-hidden="true"></div>
      <div class="sky-arc" aria-hidden="true">
        <svg viewBox="0 0 1200 1200">
          <defs>
            <linearGradient id="skyGrad" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#FF9C31"/>
              <stop offset="0.6" stop-color="#FFDF62"/>
              <stop offset="1" stop-color="#FBF3EB"/>
            </linearGradient>
          </defs>
          <circle class="arc-track" cx="600" cy="600" r="596"/>
          <circle class="arc-draw" cx="600" cy="600" r="596" data-sky-draw/>
        </svg>
      </div>
      <div class="sky-copy">
