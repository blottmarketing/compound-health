  <!-- Scroll motion. GSAP ScrollTrigger drives the two arcs and the stage copy from the
       scroll position; everything else on the page is an IntersectionObserver reveal.
       With reduced motion, the arcs are drawn in full and nothing scrubs. -->
  <script>
    (function () {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const ringDraw = document.querySelector<SVGCircleElement>('[data-ring-draw]');
      const skyDraw  = document.querySelector<SVGCircleElement>('[data-sky-draw]');
      const scroller = document.querySelector<HTMLElement>('[data-scroller]');
      const copy     = document.querySelector<HTMLElement>('[data-scroller-copy]');
      const glow     = document.querySelector<HTMLElement>('[data-ring-glow]');
      const sky      = document.querySelector<HTMLElement>('[data-sky]');

      // Each arc is a circle whose dash is its own circumference; drawing means
      // pulling the offset back to zero.
      function prime(c: SVGCircleElement | null) {
        if (!c) return 0;
        const len = 2 * Math.PI * Number(c.getAttribute('r'));
        c.style.strokeDasharray = `${len}`;
        c.style.strokeDashoffset = `${len}`;
        return len;
      }
      const ringLen = prime(ringDraw);
      const skyLen  = prime(skyDraw);

      const g = (window as any).gsap;
      const ST = (window as any).ScrollTrigger;
      if (reduce || !g || !ST) {
        if (ringDraw) ringDraw.style.strokeDashoffset = `${ringLen * 0.35}`;
        if (skyDraw)  skyDraw.style.strokeDashoffset  = `${skyLen * 0.45}`;
        if (glow) glow.style.opacity = '1';
        return;
      }
      g.registerPlugin(ST);

      if (scroller && ringDraw) {
        // The arc draws over the first two thirds of the scroller, the glow rises
        // with it, and the copy lets go in the last third as the sunrise takes over.
        const tl = g.timeline({
          scrollTrigger: { trigger: scroller, start: 'top top', end: 'bottom bottom', scrub: 0.6 },
        });
        tl.fromTo(ringDraw, { strokeDashoffset: ringLen }, { strokeDashoffset: ringLen * 0.08, ease: 'none', duration: 0.66 }, 0)
          .fromTo(glow, { opacity: 0 }, { opacity: 1, ease: 'none', duration: 0.5 }, 0.1)
          .fromTo(copy, { opacity: 0, y: 40 }, { opacity: 1, y: 0, ease: 'none', duration: 0.18 }, 0)
          .to(copy, { opacity: 0, y: -30, ease: 'none', duration: 0.2 }, 0.78)
          .to('.ring', { rotate: 28, ease: 'none', duration: 1 }, 0);
      }

      if (sky && skyDraw) {
        g.fromTo(skyDraw, { strokeDashoffset: skyLen }, {
          strokeDashoffset: skyLen * 0.45,
          ease: 'none',
          scrollTrigger: { trigger: sky, start: 'top 85%', end: 'bottom 40%', scrub: 0.6 },
        });
      }
    })();
  </script>

  <!-- The contrast pills: the lit ones arrive once, blurred to sharp, one after the other. -->
  <script>
    (function () {
      const root = document.querySelector<HTMLElement>('[data-contrast]');
      if (!root) return;
      const pills = Array.from(root.querySelectorAll<HTMLElement>('.pill-glow'));
      const show = () => pills.forEach((p, i) => setTimeout(() => { p.classList.remove('is-out'); p.classList.add('is-in'); }, 120 + i * 180));
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) { show(); return; }
      new IntersectionObserver((entries, obs) => {
        entries.forEach(e => { if (e.isIntersecting) { show(); obs.disconnect(); } });
      }, { threshold: 0.4 }).observe(root);
    })();
  </script>

  <!-- Discipline tabs. Click or arrow keys; each tab owns one pane. -->
  <script>
    (function () {
      const root = document.getElementById('disciplines');
      if (!root) return;
      const tabs  = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panes = Array.from(root.querySelectorAll<HTMLElement>('.pane'));
      function select(i: number, focus = false) {
        tabs.forEach((t, k) => { const on = k === i; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; });
        panes.forEach((p, k) => p.classList.toggle('is-active', k === i));
        if (focus) tabs[i].focus();
      }
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('keydown', e => {
          const last = tabs.length - 1; let next = -1;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = i === last ? 0 : i + 1;
          else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = i === 0 ? last : i - 1;
          else if (e.key === 'Home') next = 0; else if (e.key === 'End') next = last;
          if (next < 0) return; e.preventDefault(); select(next, true);
        });
      });
    })();
  </script>

  <!-- The audience coverflow. Cards fan out from the current one; the arrows, the
       keyboard, a swipe, or a click on a side card move it. Positions are computed
       from the index, which is the one legitimate use of inline style here. -->
  <script>
    (function () {
      const root = document.getElementById('audiences');
      if (!root) return;
      const cards = Array.from(root.querySelectorAll<HTMLElement>('.aud-card'));
      const prev = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next = document.querySelector<HTMLButtonElement>('[data-carousel-next]');
      let current = 0;
      const n = cards.length;

      function layout() {
        const narrow = window.innerWidth < 768;
        const step = narrow ? 200 : 340;
        cards.forEach((card, i) => {
          let d = i - current;
          // Wrap so the ring is continuous: the far card comes round the other side.
          if (d > n / 2) d -= n; if (d < -n / 2) d += n;
          const a = Math.abs(d);
          card.style.transform = `translateX(${d * step}px) translateY(${a * 24}px) rotate(${d * 5}deg) scale(${1 - a * 0.06})`;
          card.style.opacity = a === 0 ? '1' : (a === 1 ? '0.3' : '0.12');
          card.style.zIndex = String(10 - a);
          card.setAttribute('aria-current', a === 0 ? 'true' : 'false');
          card.setAttribute('aria-hidden', a === 0 ? 'false' : 'true');
        });
      }
      function go(i: number) { current = (i + n) % n; layout(); }

      prev?.addEventListener('click', () => go(current - 1));
      next?.addEventListener('click', () => go(current + 1));
      cards.forEach((c, i) => c.addEventListener('click', () => { if (i !== current) go(i); }));
      root.tabIndex = 0;
      root.addEventListener('keydown', e => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(current - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); go(current + 1); }
      });

      let x0: number | null = null;
      root.addEventListener('pointerdown', e => { x0 = e.clientX; });
      root.addEventListener('pointerup', e => {
        if (x0 === null) return;
        const dx = e.clientX - x0; x0 = null;
        if (Math.abs(dx) > 40) go(current + (dx < 0 ? 1 : -1));
      });
      window.addEventListener('resize', layout, { passive: true });
      layout();
    })();
  </script>

  <!-- The 400 counts up when the stats come into view. -->
  <script>
    (function () {
      const el = document.querySelector<HTMLElement>('[data-count]');
      if (!el || window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
      const target = Number(el.dataset.count);
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      new IntersectionObserver((entries, obs) => {
        entries.forEach(e => {
          if (!e.isIntersecting) return;
          obs.disconnect();
          const t0 = performance.now();
          const tick = (now: number) => {
            const t = Math.min(1, (now - t0) / 1400);
            el.textContent = String(Math.round(ease(t) * target));
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      }, { threshold: 0.5 }).observe(el);
    })();
  </script>

  <!-- Custom dropdowns. Each select.wf-select is wrapped in .wf-dd and given a
       button and a listbox; the native select stays as the value the form
       script reads, and is updated on every choice. Arrow keys, Home, End,
       Enter, Space and Escape work; a click outside closes. Without JavaScript
       the native select is what the reader sees. -->
  <script>
    (function () {
      const CHEV = '<svg class="wf-dd-chev" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      const TICK = '<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3.2 3L13 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';

      document.querySelectorAll<HTMLSelectElement>('select.wf-select').forEach((sel, n) => {
        const label = sel.id ? document.querySelector<HTMLLabelElement>(`label[for="${sel.id}"]`) : null;
        const wrap  = document.createElement('div');
        wrap.className = 'wf-dd';
        sel.parentNode?.insertBefore(wrap, sel);
        wrap.appendChild(sel);
        sel.tabIndex = -1;
        sel.setAttribute('aria-hidden', 'true');

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'wf-dd-btn';
        btn.id = `${sel.id || 'wf-dd-' + n}-btn`;
        btn.setAttribute('aria-haspopup', 'listbox');
        btn.setAttribute('aria-expanded', 'false');
        if (label) { btn.setAttribute('aria-label', label.textContent?.trim() || ''); label.htmlFor = btn.id; }
        const text = document.createElement('span');
        btn.appendChild(text);
        btn.insertAdjacentHTML('beforeend', CHEV);

        const list = document.createElement('ul');
        list.className = 'wf-dd-list';
        list.setAttribute('role', 'listbox');
        list.id = `${btn.id}-list`;
        btn.setAttribute('aria-controls', list.id);

        const opts = Array.from(sel.options).filter((o) => !o.disabled);
        const items = opts.map((o) => {
          const li = document.createElement('li');
          li.className = 'wf-dd-opt';
          li.setAttribute('role', 'option');
          li.dataset.value = o.value;
          li.innerHTML = `<span>${o.textContent}</span>${TICK}`;
          li.addEventListener('click', () => { choose(o.value); close(); btn.focus(); });
          list.appendChild(li);
          return li;
        });
        wrap.appendChild(btn);
        wrap.appendChild(list);

        const placeholder = sel.options[0]?.disabled ? sel.options[0].textContent || '' : '';
        let focus = -1;

        function render() {
          const cur = sel.value;
          const selected = opts.find((o) => o.value === cur && cur !== '');
          text.textContent = selected ? selected.textContent : placeholder;
          btn.classList.toggle('is-empty', !selected);
          items.forEach((li) => li.setAttribute('aria-selected', String(li.dataset.value === cur && cur !== '')));
        }
        function choose(value: string) {
          sel.value = value;
          sel.dispatchEvent(new Event('change', { bubbles: true }));
          render();
        }
        function setFocus(i: number) {
          focus = Math.max(0, Math.min(items.length - 1, i));
          items.forEach((li, k) => li.classList.toggle('is-focus', k === focus));
          items[focus]?.scrollIntoView({ block: 'nearest' });
        }
        function open() {
          list.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          const cur = items.findIndex((li) => li.getAttribute('aria-selected') === 'true');
          setFocus(cur >= 0 ? cur : 0);
        }
        function close() {
          list.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
          items.forEach((li) => li.classList.remove('is-focus'));
          focus = -1;
        }
        const isOpen = () => list.classList.contains('is-open');

        btn.addEventListener('click', () => (isOpen() ? close() : open()));
        btn.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            if (!isOpen()) open();
            else setFocus(focus + (e.key === 'ArrowDown' ? 1 : -1));
          } else if (e.key === 'Home' && isOpen()) { e.preventDefault(); setFocus(0); }
          else if (e.key === 'End' && isOpen()) { e.preventDefault(); setFocus(items.length - 1); }
          else if ((e.key === 'Enter' || e.key === ' ') && isOpen()) {
            e.preventDefault();
            const li = items[focus];
            if (li) choose(li.dataset.value || '');
            close();
          } else if (e.key === 'Escape' && isOpen()) { e.preventDefault(); close(); }
          else if (e.key === 'Tab' && isOpen()) { close(); }
        });
        document.addEventListener('click', (e) => { if (isOpen() && !wrap.contains(e.target as Node)) close(); });
        sel.addEventListener('change', render);
        render();
      });
    })();
  </script>

  <!-- Waitlist form script -->
  <script>
    const WAITLIST_ENDPOINT =
      'https://script.google.com/macros/s/AKfycbw9x1Q9dVIDbTRRnsgajzbXHrL2Y3mz7SSWO2qHGtDeK9XsrxKhtBpItlPaY3oDn28/exec';

    // Routing. The Apps Script endpoint branches on `audience` so partner
    // submissions land somewhere other than the client waitlist. The tag values
    // are placeholders: the inbox / CRM tag for partners is still an open point
    // in the designer brief, and changing them here is a one-line edit.
    const ROUTING_TAG: Record<string, string> = {
      client:  'client-waitlist',
      partner: 'partner-pipeline',
    };

    const waitlistForm    = document.getElementById('waitlistForm')    as HTMLDivElement | null;
    const waitlistSuccess = document.getElementById('waitlistSuccess') as HTMLDivElement | null;
    const wfSubmit        = document.getElementById('wfSubmit')        as HTMLButtonElement | null;
    const wfError         = document.getElementById('wfError')         as HTMLDivElement | null;
    const wfErrorMsg      = wfError?.querySelector('.wf-error-msg')    as HTMLSpanElement | null;
    const wfLabel         = wfSubmit?.querySelector('.wf-submit-label') as HTMLSpanElement | null;
    const wfRole          = document.getElementById('wfRole')          as HTMLDivElement | null;
    const wsTitle         = document.getElementById('wsTitle')         as HTMLHeadingElement | null;
    const wsBody          = document.getElementById('wsBody')          as HTMLParagraphElement | null;
    const wsReset         = document.getElementById('wsReset')         as HTMLButtonElement | null;
    const ORIGINAL_LABEL  = wfLabel?.textContent ?? 'Reserve my place';

    const segments = Array.from(
      wfRole?.querySelectorAll<HTMLButtonElement>('.wf-segment') ?? []
    );

    /** 'client' or 'partner', from the currently selected segment. */
    function currentAudience(): string {
      const active = segments.find((s) => s.classList.contains('is-active'));
      return active?.dataset.audience ?? 'client';
    }

    /** The specific segment value, e.g. 'client', 'wealth-firm', 'employer', 'network'. */
    function currentRole(): string {
      const active = segments.find((s) => s.classList.contains('is-active'));
      return active?.dataset.role ?? 'client';
    }

    function showError(message: string) {
      if (!wfError) return;
      if (wfErrorMsg) wfErrorMsg.textContent = message;
      wfError.classList.add('visible');
    }

    function clearError() {
      wfError?.classList.remove('visible');
    }

    /**
     * Reveal the fields for one audience and hide the other's. Both paths carry
     * two conditional fields, so the card keeps the same height either way.
     */
    function applyAudience(audience: string) {
      document
        .querySelectorAll<HTMLElement>('[data-shown-to]')
        .forEach((field) => {
          field.hidden = field.dataset.shownTo !== audience;
        });
    }

    /** Select a segment by role slug. 'partner' picks the first partner option. */
    function selectRole(role: string) {
      const target =
        segments.find((s) => s.dataset.role === role) ??
        (role === 'partner'
          ? segments.find((s) => s.dataset.audience === 'partner')
          : undefined);
      if (!target) return;

      segments.forEach((s) => {
        const isActive = s === target;
        s.classList.toggle('is-active', isActive);
        s.setAttribute('aria-checked', String(isActive));
      });
      applyAudience(target.dataset.audience ?? 'client');
      clearError();
    }

    segments.forEach((segment) => {
      segment.addEventListener('click', () => {
        selectRole(segment.dataset.role ?? 'client');
      });
    });

    // Links elsewhere on the page can preset the selector before the browser
    // scrolls to the form, e.g. the Partners CTA. Delegated, so triggers added
    // to the page later are wired without touching this file.
    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-wf-role]');
      if (trigger) selectRole(trigger.dataset.wfRole ?? 'partner');
    });

    applyAudience(currentAudience());

    if (wfSubmit && waitlistForm && waitlistSuccess) {
      wfSubmit.addEventListener('click', async () => {
        clearError();

        const fnameInput   = document.getElementById('wf-fname')   as HTMLInputElement | null;
        const lnameInput   = document.getElementById('wf-lname')   as HTMLInputElement | null;
        const emailInput   = document.getElementById('wf-email')   as HTMLInputElement | null;
        const tierInput    = document.getElementById('wf-tier')    as HTMLSelectElement | null;
        const advisorInput = document.getElementById('wf-advisor') as HTMLInputElement | null;
        const orgInput     = document.getElementById('wf-org')     as HTMLInputElement | null;
        const reachInput   = document.getElementById('wf-reach')   as HTMLSelectElement | null;

        const audience  = currentAudience();
        const isPartner = audience === 'partner';

        const firstName = fnameInput?.value.trim()   ?? '';
        const lastName  = lnameInput?.value.trim()   ?? '';
        const email     = emailInput?.value.trim()   ?? '';
        const tier      = tierInput?.value           ?? '';
        const advisor   = advisorInput?.value.trim() ?? '';
        const org       = orgInput?.value.trim()     ?? '';
        const reach     = reachInput?.value          ?? '';

        // Minimal validation, matching the existing pattern: focus the first
        // field that needs attention. Required fields differ by audience.
        if (!firstName) { fnameInput?.focus(); return; }
        if (!lastName)  { lnameInput?.focus(); return; }
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          emailInput?.focus();
          return;
        }
        if (isPartner) {
          if (!org) { orgInput?.focus(); return; }
        } else if (!tier) {
          tierInput?.focus();
          return;
        }

        // Submitting state
        wfSubmit.disabled = true;
        if (wfLabel) wfLabel.textContent = 'Submitting…';

        const payload = new URLSearchParams({
          role:        currentRole(),
          audience,
          routingTag:  ROUTING_TAG[audience] ?? ROUTING_TAG.client,
          firstName,
          lastName,
          email,
          // Only the fields belonging to the chosen path are sent.
          tier:         isPartner ? '' : tier,
          advisor:      isPartner ? '' : advisor,
          organization: isPartner ? org : '',
          reach:        isPartner ? reach : '',
          source:      'compoundhealth.io',
          submittedAt: new Date().toISOString(),
          userAgent:   navigator.userAgent,
        });

        try {
          const res = await fetch(WAITLIST_ENDPOINT, {
            method: 'POST',
            // application/x-www-form-urlencoded is a "simple" request and avoids
            // a CORS preflight against the Apps Script endpoint.
            headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
            body: payload.toString(),
          });

          if (!res.ok) throw new Error('Request failed: ' + res.status);

          // Confirmation copy differs by audience.
          if (isPartner) {
            if (wsTitle) wsTitle.textContent = 'Request received';
            if (wsBody) {
              wsBody.textContent =
                'Thank you. We will be in touch to discuss a program for your organization.';
            }
          } else {
            if (wsTitle) wsTitle.textContent = "You're on the list";
            if (wsBody) {
              // Personalize: "Thank you, {First Name}." Without a name: "Thank you."
              wsBody.textContent =
                'Thank you' + (firstName ? ', ' + firstName : '') +
                '. Your founding member request has been received. Our team will be in ' +
                'touch as soon as your tier opens.';
            }
          }

          waitlistForm.style.display = 'none';
          waitlistSuccess.classList.add('visible');

          // Smoothly bring the success panel into view on smaller screens
          waitlistSuccess.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch (err) {
          console.error('Waitlist submission failed', err);
          wfSubmit.disabled = false;
          if (wfLabel) wfLabel.textContent = ORIGINAL_LABEL;
          showError("We couldn't submit your details. Please check your connection and try again.");
        }
      });
    }

    // Allow the user to submit another response without a page reload
    if (wsReset && waitlistForm && waitlistSuccess && wfSubmit) {
      wsReset.addEventListener('click', () => {
        ['wf-fname', 'wf-lname', 'wf-email', 'wf-advisor', 'wf-org'].forEach((id) => {
          const el = document.getElementById(id) as HTMLInputElement | null;
          if (el) el.value = '';
        });
        ['wf-tier', 'wf-reach'].forEach((id) => {
          const el = document.getElementById(id) as HTMLSelectElement | null;
          if (el) { el.value = ''; el.dispatchEvent(new Event('change')); }
        });

        // Restore form, reset button, and return the selector to the client path
        selectRole('client');
        waitlistSuccess.classList.remove('visible');
        waitlistForm.style.display = '';
        wfSubmit.disabled = false;
        if (wfLabel) wfLabel.textContent = ORIGINAL_LABEL;
        clearError();
      });
    }
  </script>

</V2Layout>
